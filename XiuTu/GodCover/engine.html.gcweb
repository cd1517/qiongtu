  const RETOUCH_LOOKUP = Object.fromEntries(RETOUCH_PARTS.map((item) => [item.key, item]));
  const HAIR_COLOR_LOOKUP = Object.fromEntries(HAIR_COLORS.map((item) => [item.key, item]));

  // 全局服装/内容安全 preamble — 放在每张图 prompt 的最前面
  // 关键：海岛/校园/酒店等场景容易让 AI 默认脑补成泳装/暴露服装，
  // 这里硬塞「fully clothed + 高级时装编辑风」让模型不能滑向 sexualized 默认。
  const STUDIO_SAFETY_PREAMBLE =
    " === FASHION-EDITORIAL PHOTO ALBUM — STRICT CONTENT POLICY (apply to every photo) === This is a tasteful family-friendly G-rated high-fashion editorial photo album in the style of Vogue / Harper's Bazaar / GQ magazine covers. The subject must be FULLY CLOTHED throughout the entire album in stylish fashion-editorial outfits appropriate to the scene. STRICTLY FORBIDDEN: swimwear, bikini, lingerie, undergarments, revealing clothing, sheer fabric, sexualized poses, seductive expressions, biting lip, parted suggestive lips, suggestive body language, sultry gaze, intimate sensual mood, romantic-partner intimacy, any sexualized framing whatsoever. ALWAYS apply: dignified editorial pose, composed expression, elegant fashion attire, magazine-cover sophistication. For beach / pool / island / tropical resort scenes: dress the subject in stylish modest resort wear (flowy maxi sundress, linen shirt with trousers, kaftan beach-coverup, silk wrap dress, oversized linen shirt with bermuda shorts, wide-brim sun hat) — NEVER a bathing suit, NEVER a bikini. For all scenes: use elegant fashion-editorial outfits typical of high-end fashion magazine photography. The subject is always portrayed with professional dignity, the way a Vogue cover model would be — never sexualized in any way.";

  // 绝对最终内容策略覆盖 — 放在每张图 prompt 的最最后面（优先级最高）
  // 三明治结构：开头一道，结尾再压一道
  const STUDIO_SAFETY_FINAL =
    " === ABSOLUTE FINAL CONTENT-POLICY OVERRIDE (highest priority — applies after everything above) === Override and neutralize any element from the above that could be interpreted as sexualized or suggestive. This is a Vogue-style family-friendly G-rated luxury fashion editorial photoshoot. The subject is FULLY CLOTHED in elegant fashion attire. NO seductive poses, NO sultry expressions, NO biting-lip / tongue-out / parted-lips / suggestive body language. Portray the subject with professional editorial dignity — like a Vogue / Harper's Bazaar magazine cover. Treat this as G-rated luxury fashion content suitable for all audiences.";

