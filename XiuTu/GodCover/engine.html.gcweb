  const HAIR_COLORS = [
    { key: "black", label: "黑茶", swatch: "#17120f", prompt: "glossy natural black-brown hair color" },
    { key: "brown", label: "棕色", swatch: "#7a4a2a", prompt: "soft warm chestnut brown hair color" },
