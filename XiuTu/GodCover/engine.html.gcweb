}

// ============================================
// 风格 28: Linnel 风（宝島社 · ナチュラル系慢生活）
// ============================================
function drawLinnel(ctx, opts) {
  // 奶米色背景（リンネル的灵魂底色）
  ctx.fillStyle = "#e6dec9";
  ctx.fillRect(0, 0, W, H);

  // "Linnel" 衬线 wordmark
  ctx.fillStyle = "#3a2e26";
  ctx.font = "italic 700 64px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("Linnel", W / 2, 40);

  // 副标
  ctx.font = "500 11px 'Shippori Mincho B1'";
  ctx.fillStyle = "#6b5b50";
  ctx.fillText("リンネル — 心がふっと軽くなる暮らしのヒント", W / 2, 120);

  // 期号
  ctx.font = "500 11px Inter";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate + "  ·  No.224", 30, 30);
  ctx.textAlign = "right";
  ctx.fillText("¥920  ·  宝島社", W - 30, 30);

  // 顶部细装饰线
  ctx.strokeStyle = "#3a2e26";
  ctx.lineWidth = 0.5;
  ctx.beginPath();
  ctx.moveTo(80, 155);
  ctx.lineTo(W - 80, 155);
  ctx.stroke();

  // 照片带留白
  drawPhoto(ctx, { x: 90, y: 175, w: W - 180, h: H - 175 - 250 }, opts.photo);

  // 底部装饰线
  ctx.beginPath();
  ctx.moveTo(80, H - 240);
  ctx.lineTo(W - 80, H - 240);
  ctx.stroke();

  // 主题区
  ctx.fillStyle = "#6b5b50";
  ctx.font = "500 12px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("特集", W / 2, H - 220);

  ctx.fillStyle = "#3a2e26";
  ctx.font = "700 34px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, W / 2, H - 195);

  ctx.font = "italic 500 15px 'DM Serif Display'";
  ctx.fillStyle = "#6b5b50";
  ctx.fillText(opts.subtitle, W / 2, H - 140);

  // 细装饰
  ctx.strokeStyle = "#3a2e26";
  ctx.beginPath();
  ctx.moveTo(W / 2 - 25, H - 105);
  ctx.lineTo(W / 2 + 25, H - 105);
  ctx.stroke();

  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#6b5b50";
  ctx.fillText("SLOW LIFE  ·  NATURAL  ·  HOMEMADE  ·  KYOTO", W / 2, H - 80);
}

// ============================================
// 风格 29: STORY 风（光文社 · 40代成熟优雅）
// ============================================
function drawStory(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部米白半透明色块
  ctx.fillStyle = "rgba(245, 240, 230, 0.95)";
  ctx.fillRect(0, 0, W, 135);

  // STORY 巨字
  ctx.fillStyle = "#1a1a1a";
  ctx.font = "italic 900 86px 'Bodoni Moda'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("STORY", W / 2, 22);

  // tagline
  ctx.font = "italic 500 13px 'DM Serif Display'";
  ctx.fillStyle = "#a37c4f";
