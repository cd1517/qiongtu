  ctx.font = "italic 500 14px 'DM Serif Display'";
  ctx.fillStyle = "#666";
  ctx.fillText(opts.subtitle, W / 2, H - 105);

  // 底部装饰
  ctx.strokeStyle = "#13314e";
  ctx.beginPath();
  ctx.moveTo(W / 2 - 30, H - 70);
  ctx.lineTo(W / 2 + 30, H - 70);
  ctx.stroke();

  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#13314e";
  ctx.fillText("FASHION  ·  BEAUTY  ·  LIFE  ·  CULTURE", W / 2, H - 50);
}

// ============================================
// 风格 34: Seventeen（ST · 集英社高中生）
// ============================================
function drawSeventeen(ctx, opts) {
  // 青蓝渐变背景
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, "#84d9ed");
  grad.addColorStop(1, "#5fb6ff");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // 顶部红色色块
  ctx.fillStyle = "#e30613";
  ctx.fillRect(0, 0, W, 70);

  // Seventeen 巨字
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 38px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "middle";
  ctx.fillText("Seventeen", 25, 35);

  // 右上
  ctx.font = "900 11px Inter";
  ctx.textAlign = "right";
  ctx.fillText(opts.issueDate + "号  ·  ST", W - 25, 28);
  ctx.fillText("¥600  ·  集英社", W - 25, 48);

  // 顶部小贴纸 - 倾斜黄色
  ctx.save();
  ctx.translate(W / 2 + 30, 90);
  ctx.rotate(-0.08);
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(-80, -18, 160, 36);
  ctx.fillStyle = "#e30613";
  ctx.font = "900 18px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("STの推し私服!", 0, 0);
  ctx.restore();

  // 照片
  const px = 60, py = 130, pw = W - 120, ph = H - 130 - 250;
  ctx.fillStyle = "#fff";
  ctx.fillRect(px - 6, py - 6, pw + 12, ph + 12);
  drawPhoto(ctx, { x: px, y: py, w: pw, h: ph }, opts.photo);

  // 左下"恋爱"标签
  ctx.save();
  ctx.translate(85, 240);
  ctx.rotate(-0.1);
  ctx.fillStyle = "#ff5a8a";
  ctx.beginPath();
  ctx.arc(0, 0, 45, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("胸キュン", 0, -12);
  ctx.fillText("恋愛特集", 0, 6);
  ctx.font = "900 9px Inter";
  ctx.fillText("LOVE!", 0, 24);
  ctx.restore();

  // 右下"制服"标签
  ctx.save();
  ctx.translate(W - 80, 320);
  ctx.rotate(0.1);
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(-50, -28, 100, 56);
  ctx.fillStyle = "#13314e";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("制服", 0, -12);
  ctx.fillText("コーデ", 0, 6);
  ctx.font = "900 10px Inter";
  ctx.fillText("100!!", 0, 22);
  ctx.restore();

  // 底部主标题
  ctx.fillStyle = "#13314e";
  ctx.font = "900 36px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText(opts.mainTitle, W / 2, H - 235);

  ctx.fillStyle = "#fff";
  ctx.fillRect(W / 2 - 90, H - 185, 180, 28);
  ctx.fillStyle = "#e30613";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textBaseline = "middle";
  ctx.fillText("巻頭オールカラー", W / 2, H - 171);

  ctx.fillStyle = "#13314e";
  ctx.font = "700 14px 'Shippori Mincho B1'";
  ctx.textBaseline = "top";
  ctx.fillText(opts.subtitle, W / 2, H - 140);

  // 底部色条
  ctx.fillStyle = "#e30613";
  ctx.fillRect(0, H - 60, W, 60);
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textBaseline = "middle";
  ctx.fillText("ST  ·  ティーンの今、全部ここに!", W / 2, H - 30);
}

// ============================================
// 风格 35: Ray（主婦の友社 · 愛されガール）
// ============================================
function drawRayMag(ctx, opts) {
  // 奶米色背景
  ctx.fillStyle = "#f1e8da";
  ctx.fillRect(0, 0, W, H);

  // Ray 巨字 - 优雅手写体
  ctx.fillStyle = "#7a5a4a";
  ctx.font = "italic 900 130px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("Ray", W / 2, 10);

  // 副标
  ctx.font = "italic 500 13px 'DM Serif Display'";
  ctx.fillStyle = "#a37c6a";
  ctx.fillText("レイ  ·  愛されガール御用達 MAGAZINE", W / 2, 160);

  // 期号
  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#7a5a4a";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate + "号  ·  No.318", 30, 30);
  ctx.textAlign = "right";
  ctx.fillText("¥780  ·  主婦の友社", W - 30, 30);

  // 顶部装饰细线
  ctx.strokeStyle = "#7a5a4a";
  ctx.lineWidth = 0.5;
  ctx.beginPath();
  ctx.moveTo(80, 190);
  ctx.lineTo(W - 80, 190);
  ctx.stroke();

  // 照片留白
  drawPhoto(ctx, { x: 80, y: 200, w: W - 160, h: H - 200 - 230 }, opts.photo);

  // 右上小标签
  ctx.save();
  ctx.translate(W - 75, 240);
  ctx.rotate(0.1);
  ctx.fillStyle = "#e89db5";
  ctx.beginPath();
  ctx.arc(0, 0, 42, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("愛され", 0, -10);
  ctx.fillText("コーデ", 0, 8);
  ctx.font = "900 9px Inter";
  ctx.fillText("BEST 50", 0, 24);
  ctx.restore();

  // 底部细装饰线
  ctx.strokeStyle = "#7a5a4a";
  ctx.beginPath();
  ctx.moveTo(80, H - 225);
  ctx.lineTo(W - 80, H - 225);
  ctx.stroke();

  // 主标题
  ctx.fillStyle = "#a37c6a";
  ctx.font = "italic 500 13px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("COVER STAR  ·  巻頭特集", W / 2, H - 210);

  ctx.fillStyle = "#7a5a4a";
  ctx.font = "900 36px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, W / 2, H - 185);

  ctx.font = "italic 500 16px 'DM Serif Display'";
  ctx.fillStyle = "#a37c6a";
  ctx.fillText(opts.subtitle, W / 2, H - 125);

  // 小心心装饰
  ctx.fillStyle = "#e89db5";
  const heartY = H - 90;
  ctx.beginPath();
  ctx.arc(W / 2 - 4, heartY, 4, 0, Math.PI * 2);
  ctx.arc(W / 2 + 4, heartY, 4, 0, Math.PI * 2);
  ctx.moveTo(W / 2 - 8, heartY + 2);
  ctx.lineTo(W / 2, heartY + 10);
  ctx.lineTo(W / 2 + 8, heartY + 2);
  ctx.fill();

  ctx.font = "italic 500 11px 'DM Serif Display'";
  ctx.fillStyle = "#a37c6a";
  ctx.fillText("Sweet, Feminine, Loved.", W / 2, H - 60);
}

// ============================================
// 风格 36: ar（主婦と生活社 · 自分磨き健康美）
// ============================================
function drawAr(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部白色块
  ctx.fillStyle = "#fff";
  ctx.fillRect(0, 0, W, 120);

  // "ar" 巨字
  ctx.fillStyle = "#ff6b6b";
  ctx.font = "italic 900 110px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("ar", 30, 0);

  // 月份大字
  ctx.fillStyle = "#13314e";
  ctx.font = "900 32px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.fillText("7・8月号", 180, 25);

  // 副信息
  ctx.font = "700 12px 'Noto Sans JP'";
  ctx.fillStyle = "#666";
  ctx.fillText("自分磨きを頑張る女子に", 180, 70);

  // 右上
  ctx.fillStyle = "#000";
  ctx.font = "900 12px Inter";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText("¥720  ·  主婦と生活社", W - 30, 30);
  ctx.fillStyle = "#ff6b6b";
  ctx.font = "italic 700 11px 'DM Serif Display'";
  ctx.fillText("ar  for the new me", W - 30, 55);

  // 顶部右上圆形 badge - 蓝色 NEW
  ctx.save();
  ctx.translate(W - 60, 145);
  ctx.fillStyle = "#3477ff";
  ctx.beginPath();
  ctx.arc(0, 0, 32, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 11px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("NEW", 0, -6);
  ctx.fillText("SPECIAL", 0, 8);
  ctx.restore();

  // 左侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.6)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "ストレスフリーで", 25, 200, { font: "900 22px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "可愛いカラダ", 25, 232, { font: "900 28px 'Shippori Mincho B1'", color: "#ff6b6b" });
  drawCoverline(ctx, "1 日 10 分から始める", 25, 275, { font: "500 12px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "MAKE UP", 25, 360, { font: "italic 900 24px 'DM Serif Display'", color: "#ffd636" });
  drawCoverline(ctx, "美の習慣 100", 25, 392, { font: "900 18px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "毎日続けたい美容ルーティン", 25, 420, { font: "500 12px 'Noto Sans JP'", color: "#fff" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 220, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(255,107,107,0.92)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 220, W, 220);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("COVER STORY  ·  特集", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 48px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, 25, H - 60);

  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 30);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 37: KOGYARU 风（Y2K コギャル 黄+霓虹）
// ============================================
function drawKogyaru(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部黄色色块
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(0, 0, W, 150);

  // KOGYARU 巨字（黑色描边 + 黄色填充）
  ctx.fillStyle = "#fff";
  ctx.font = "900 88px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.strokeStyle = "#000";
  ctx.lineWidth = 4;
  ctx.strokeText("KOGYARU", 20, 15);
  ctx.fillText("KOGYARU", 20, 15);

  // 子标 KO 黄色, GYARU 橙色变化
  ctx.fillStyle = "#ff8800";
  ctx.font = "900 88px 'Anton'";
  ctx.fillText("KO", 20, 15);

  // 副信息（右上）
  ctx.fillStyle = "#000";
  ctx.font = "900 13px Inter";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText("VOLUME 02", W - 25, 110);
  ctx.fillText("SPRING & SUMMER", W - 25, 128);

  // 月份大数字 6
  ctx.fillStyle = "#fff";
  ctx.fillRect(20, 160, 70, 95);
  ctx.strokeStyle = "#000";
  ctx.lineWidth = 2;
  ctx.strokeRect(20, 160, 70, 95);
  ctx.fillStyle = "#000";
  ctx.font = "900 64px 'Anton'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("6", 55, 208);
  ctx.font = "700 9px Inter";
  ctx.fillText("JUNE 2025", 55, 245);

  // I CAN HUSTLE 小标
  ctx.fillStyle = "#fff";
  ctx.font = "900 11px Inter";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("I CAN HUSTLE", 20, 260);

  // 左侧 RYUA'S STYLE 大标签
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 26px 'DM Serif Display'";
  ctx.fillText("これがウチの", 25, 320);
  ctx.fillText("やりかたッ!!", 25, 350);
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 32px 'DM Serif Display'";
  ctx.fillText("Style!", 25, 390);

  // 右侧 大字 圆形 大標 ⼤
  ctx.shadowBlur = 0;
  ctx.save();
  ctx.translate(75, 470);
  ctx.fillStyle = "#fff";
  ctx.strokeStyle = "#000";
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.arc(0, 0, 38, 0, Math.PI * 2);
  ctx.fill();
  ctx.stroke();
  ctx.fillStyle = "#000";
  ctx.font = "900 36px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("大", 0, 0);
  ctx.restore();

  // 底部黄色描边主标题
  ctx.shadowColor = "rgba(0,0,0,0.4)";
  ctx.shadowBlur = 5;
  ctx.fillStyle = "#ffd636";
  ctx.strokeStyle = "#000";
  ctx.lineWidth = 6;
  ctx.font = "900 70px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.strokeText("コギャル時代", W / 2, H - 240);
  ctx.fillText("コギャル時代", W / 2, H - 240);
  ctx.strokeText("到来い!!", W / 2, H - 160);
  ctx.fillText("到来い!!", W / 2, H - 160);
  ctx.shadowBlur = 0;

  // Here Comes The Age of Kogyaru
  ctx.fillStyle = "#fff";
  ctx.font = "italic 600 14px 'Playfair Display'";
  ctx.fillText("Here Comes The Age of Kogyaru", W / 2, H - 80);

  // 底部紫红色 PIPIPI badge
  ctx.fillStyle = "#ff3a85";
  ctx.fillRect(W - 200, H - 50, 180, 30);
  ctx.fillStyle = "#fff";
  ctx.font = "900 14px Inter";
  ctx.textBaseline = "middle";
  ctx.fillText("PIPIPI 世界征服", W - 110, H - 35);
}

// ============================================
// 风格 38: Happie nuts 风（Tough & Sexy 派对ギャル）
// ============================================
function drawHappieNuts(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 半透明黑色提升对比
  ctx.fillStyle = "rgba(0,0,0,0.25)";
  ctx.fillRect(0, 0, W, H);

  // "nuts" 巨字 wordmark 黑色阴影描边
  ctx.fillStyle = "#000";
  ctx.font = "900 165px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("nuts", 20, 5);

  // Happie 小标
  ctx.fillStyle = "#000";
  ctx.font = "italic 900 24px 'DM Serif Display'";
  ctx.fillText("Happie", 25, 165);

  // 顶部小信息
  ctx.fillStyle = "#000";
  ctx.font = "900 11px 'Shippori Mincho B1'";
  ctx.fillText("[ハッピーナッツ]", 25, 200);
  ctx.fillText("Summer Issue", 25, 215);
  ctx.font = "700 16px 'Shippori Mincho B1'";
  ctx.fillText("定価650円", 25, 235);

  // 右侧粉色圆形 badge
  ctx.save();
  ctx.translate(W - 75, 130);
  ctx.fillStyle = "#ff1a8c";
  ctx.beginPath();
  ctx.arc(0, 0, 55, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = "#fff";
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.arc(0, 0, 48, 0, Math.PI * 2);
  ctx.stroke();
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 13px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("Cover &", 0, -20);
  ctx.fillText("Special Edition", 0, -5);
  ctx.font = "900 16px 'Shippori Mincho B1'";
  ctx.fillText("倖田來未", 0, 15);
  ctx.font = "italic 500 10px 'DM Serif Display'";
  ctx.fillText("For You...", 0, 32);
  ctx.restore();

  // 中部 TOUGH BUT SEXY
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ff1a8c";
  ctx.font = "italic 900 22px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("TOUGH BUT SEXY", 25, 290);

  ctx.fillStyle = "#fff";
  ctx.font = "900 26px 'Shippori Mincho B1'";
  ctx.fillText("媚びない女の", 25, 320);
  ctx.fillText("ルール10", 25, 355);

  // 底部黑色刷子色块 + 大标题
  ctx.fillStyle = "#000";
  const brushY = H - 280;
  ctx.beginPath();
  ctx.moveTo(0, brushY + 10);
  ctx.lineTo(W * 0.9, brushY + 5);
  ctx.lineTo(W * 0.95, brushY + 80);
  ctx.lineTo(0, brushY + 75);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = "#ff1a8c";
  ctx.font = "900 50px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("タフ&セクシーな", 25, brushY + 15);

  // 第二行
  ctx.beginPath();
  ctx.moveTo(0, brushY + 95);
  ctx.lineTo(W * 0.7, brushY + 90);
  ctx.lineTo(W * 0.75, brushY + 155);
  ctx.lineTo(0, brushY + 150);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.fillText("女たちへ", 25, brushY + 100);

  // PARTY SNAPS 73
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 30px 'Anton'";
  ctx.textAlign = "right";
  ctx.fillText("PARTY SNAPS 73", W - 20, H - 110);
  ctx.font = "900 12px Inter";
  ctx.fillStyle = "#ff1a8c";
  ctx.fillText("2015 SUMMER", W - 20, H - 80);

  // 底部 ARE YOU READY FOR THE PARTY
  ctx.shadowBlur = 0;
  ctx.fillStyle = "#ff1a8c";
  ctx.font = "italic 700 20px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.fillText("ARE YOU", 25, H - 55);
  ctx.fillStyle = "#fff";
  ctx.fillText("READY FOR THE PARTY?", 110, H - 55);
}

// ============================================
// 风格 39: Ranzuki 风（カワイイ無敵 亮片粉系）
// ============================================
function drawRanzuki(ctx, opts) {
  // 奶白米色背景
  ctx.fillStyle = "#f8eee0";
  ctx.fillRect(0, 0, W, H);

  // 装饰小钻闪光
  const stars = [];
  for (let i = 0; i < 80; i++) {
    stars.push({ x: Math.random() * W, y: Math.random() * H, s: 1 + Math.random() * 3 });
  }
  stars.forEach((p) => {
    ctx.fillStyle = `rgba(255, ${100 + Math.random() * 50}, ${180 + Math.random() * 60}, ${0.3 + Math.random() * 0.5})`;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.s, 0, Math.PI * 2);
    ctx.fill();
  });

  // 顶部 Ranzuki 装饰字
  ctx.shadowColor = "rgba(255, 100, 180, 0.5)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#fff";
  ctx.strokeStyle = "#e85a8a";
  ctx.lineWidth = 5;
  ctx.font = "italic 900 96px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.strokeText("Ranzuki", W / 2, 30);
  ctx.fillText("Ranzuki", W / 2, 30);

  // Asia 小标
  ctx.font = "italic 500 16px 'DM Serif Display'";
  ctx.fillStyle = "#e85a8a";
  ctx.shadowBlur = 0;
  ctx.fillText("Asia", W / 2 + 130, 110);

  // 副信息
  ctx.fillStyle = "#444";
  ctx.font = "500 11px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.fillText("「ランズキ」 2023秋号", 25, 30);
  ctx.fillText("JELLY 12月号增刊", 25, 48);
  ctx.textAlign = "right";
  ctx.fillText("¥980  ·  Asia", W - 25, 30);

  // 顶部紫粉色横幅
  ctx.fillStyle = "rgba(232, 90, 138, 0.85)";
  ctx.fillRect(20, 150, W - 40, 30);
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("人気モデルの私服デニム着回しコーデ ♡", W / 2, 165);

  // 中部照片
  const px = 60, py = 200, pw = W - 120, ph = H - 200 - 290;
  ctx.fillStyle = "#fff";
  ctx.fillRect(px - 6, py - 6, pw + 12, ph + 12);
  drawPhoto(ctx, { x: px, y: py, w: pw, h: ph }, opts.photo);

  // 右上爱心 badge
  ctx.save();
  ctx.translate(W - 80, 280);
  ctx.rotate(0.1);
  ctx.fillStyle = "#e85a8a";
  ctx.beginPath();
  ctx.arc(-10, -5, 20, 0, Math.PI * 2);
  ctx.arc(10, -5, 20, 0, Math.PI * 2);
  ctx.moveTo(-25, 0);
  ctx.lineTo(0, 35);
  ctx.lineTo(25, 0);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 11px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("最新", 0, -7);
  ctx.fillText("ギャルメイク", 0, 9);
  ctx.restore();

  // 主标题: カワイイって、無敵
  ctx.shadowColor = "rgba(255, 100, 180, 0.4)";
  ctx.shadowBlur = 6;
  ctx.fillStyle = "#fff";
  ctx.strokeStyle = "#e85a8a";
  ctx.lineWidth = 5;
  ctx.font = "900 50px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.strokeText("カワイイって、", W / 2, H - 250);
  ctx.fillText("カワイイって、", W / 2, H - 250);
  ctx.strokeText("無敵♡", W / 2, H - 190);
  ctx.fillText("無敵♡", W / 2, H - 190);
  ctx.shadowBlur = 0;

  // 装饰 Autumn & Winter
  ctx.fillStyle = "#e85a8a";
  ctx.font = "italic 500 16px 'DM Serif Display'";
  ctx.fillText("Autumn & Winter 大作戦 !!!", W / 2, H - 125);

  // NEW ERA UNFOLDING
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(25, H - 90, 200, 36);
  ctx.fillStyle = "#e85a8a";
  ctx.font = "900 18px 'Anton'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("NEW ERA UNFOLDING", 125, H - 72);
  ctx.fillStyle = "#666";
  ctx.font = "italic 500 11px 'DM Serif Display'";
  ctx.fillText("by Ranzuki models", 125, H - 50);

  // 底部肌見せ宣言
  ctx.fillStyle = "#e85a8a";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textAlign = "right";
  ctx.fillText("肌見せコーデしかしたくない宣言!!", W - 25, H - 80);
}

// ============================================
// 风格 40: COSPLAY MODE 风（cos 综合杂志）
// ============================================
function drawCosplayMode(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部红色色块
  ctx.fillStyle = "#e30613";
  ctx.fillRect(0, 0, W, 80);

  // COSPLAY 巨字（白色描黑边）
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 64px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "middle";
  ctx.strokeStyle = "#000";
  ctx.lineWidth = 3;
  ctx.strokeText("COSPLAY", 20, 40);
  ctx.fillText("COSPLAY", 20, 40);

  // MODE 标签
  ctx.fillStyle = "#000";
  ctx.fillRect(340, 12, 110, 55);
  ctx.fillStyle = "#fff";
  ctx.font = "900 38px 'Anton'";
  ctx.textAlign = "center";
  ctx.fillText("MODE", 395, 42);

  // 右上期号
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px Inter";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText(opts.issueDate + "  ·  vol.07", W - 25, 20);
  ctx.fillText("¥1,200", W - 25, 40);
  ctx.font = "italic 700 11px 'Playfair Display'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText("COSPLAY × CHARACTER", W - 25, 60);

  // 左上"特別付録"红色贴纸
  ctx.save();
  ctx.translate(70, 130);
  ctx.rotate(-0.1);
  ctx.fillStyle = "#fff";
  ctx.strokeStyle = "#e30613";
  ctx.lineWidth = 3;
  ctx.fillRect(-55, -25, 110, 50);
  ctx.strokeRect(-55, -25, 110, 50);
  ctx.fillStyle = "#e30613";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("特別付録", 0, -8);
  ctx.fillText("実物大型紙", 0, 10);
  ctx.restore();

  // 左侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "巻頭特集", 25, 220, { font: "900 16px 'Shippori Mincho B1'", color: "#ffd636" });
  drawCoverline(ctx, "キャラ再現", 25, 245, { font: "900 26px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "完全攻略!!", 25, 280, { font: "900 22px 'Shippori Mincho B1'", color: "#e30613" });
  drawCoverline(ctx, "ウィッグ・衣装作り・メイク", 25, 315, { font: "500 12px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "コラボ", 25, 380, { font: "900 22px 'Anton'", color: "#ffd636" });
  drawCoverline(ctx, "再現コスプレ", 25, 410, { font: "900 16px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "つくる教科書", 25, 432, { font: "500 12px 'Noto Sans JP'", color: "#fff" });
  ctx.shadowBlur = 0;

  // 右下圆形 badge - V-Tuber
  ctx.save();
  ctx.translate(W - 75, 400);
  ctx.rotate(-0.1);
  ctx.fillStyle = "#0066cc";
  ctx.beginPath();
  ctx.arc(0, 0, 50, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = "#fff";
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.arc(0, 0, 43, 0, Math.PI * 2);
  ctx.stroke();
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("V-Tuber", 0, -14);
  ctx.fillText("再現", 0, 4);
  ctx.font = "900 10px Inter";
  ctx.fillText("SPECIAL", 0, 22);
  ctx.restore();

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 230, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(227,6,19,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 230, W, 230);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("COVER CHARACTER  ·  表紙キャラ", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 50px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, 25, H - 55);

  ctx.font = "italic 700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 25);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 41: コスプレMAKE 风（cos 妆造技术杂志）
// ============================================
function drawCosMake(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部白色色块
  ctx.fillStyle = "#fff";
  ctx.fillRect(0, 0, W, 150);

  // アニメ&ゲーム 小标
  ctx.fillStyle = "#e30613";
  ctx.font = "900 18px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("アニメ&ゲーム", 25, 18);

  // 声優グランプリ
  ctx.fillStyle = "#000";
  ctx.font = "900 11px 'Shippori Mincho B1'";
  ctx.textAlign = "right";
  ctx.fillText("声優グランプリ特別編集", W - 25, 22);

  // コスプレMAKE 巨字
  ctx.fillStyle = "#000";
  ctx.font = "900 56px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("コスプレ", 20, 42);

  ctx.fillStyle = "#e30613";
  ctx.font = "italic 900 86px 'Anton'";
  ctx.fillText("MAKE", 230, 28);

  // ふりがな
  ctx.fillStyle = "#666";
  ctx.font = "500 11px 'Shippori Mincho B1'";
  ctx.fillText("(メイク)", 410, 60);

  // vol.3 标签
  ctx.fillStyle = "#000";
  ctx.font = "900 16px Inter";
