  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.9)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 250, W, 250);

  ctx.fillStyle = "#fff";
  ctx.font = "900 46px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText(opts.mainTitle.toUpperCase(), 25, H - 80);

  ctx.font = "500 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 50);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 17: 週刊少年ジャンプ 风
// 特征：红黄白爆炸色、巨大日文 wordmark、漫画标题清单、starburst 贴纸
// ============================================
function drawShonenJump(ctx, opts) {
  // 顶部红色色块
  ctx.fillStyle = "#e30613";
  ctx.fillRect(0, 0, W, 145);

  // "週刊" 小字
  ctx.fillStyle = "#fff";
  ctx.font = "900 22px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("週刊", 25, 18);

  // "少年ジャンプ" 巨大主字（黄色描边感）
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 76px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("少年ジャンプ", 25, 50);

  // 右上 期号定价
  ctx.fillStyle = "#fff";
  ctx.font = "900 14px Inter";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText("No.28 / " + opts.issueDate, W - 25, 25);
  ctx.fillText("¥320", W - 25, 45);
  ctx.font = "700 11px 'Noto Sans JP'";
  ctx.fillText("毎週月曜日発売", W - 25, 65);

  // 黄色横条
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(0, 145, W, 6);

  // 照片
  drawPhoto(ctx, { x: 0, y: 151, w: W, h: H - 151 }, opts.photo);

  // 左侧"漫画作品列表" coverlines（粗黑字加白底感）
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  const animeList = [
    ["新連載 !!", "#ffd636"],
    ["王道少年漫画", "#fff"],
    ["巻頭カラー", "#ffd636"],
    ["第１話 開幕", "#fff"],
    ["センターカラー", "#ffd636"],
    ["最終決戦へ", "#fff"],
  ];
  let yy = 200;
  animeList.forEach(([t, col]) => {
    drawCoverline(ctx, t, 25, yy, { font: "900 18px 'Shippori Mincho B1'", color: col });
    yy += 28;
  });

  // 右上方圆形 starburst 贴纸
  const cx = W - 90, cy = 280;
  ctx.fillStyle = "#ffd636";
  ctx.beginPath();
  // 简易锯齿圆
  const spikes = 14, ro = 70, ri = 55;
  for (let i = 0; i < spikes * 2; i++) {
    const r = i % 2 === 0 ? ro : ri;
    const a = (i / (spikes * 2)) * Math.PI * 2 - Math.PI / 2;
    const x = cx + Math.cos(a) * r;
    const y = cy + Math.sin(a) * r;
    i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
  }
  ctx.closePath();
  ctx.fill();
  ctx.shadowBlur = 0;
  ctx.fillStyle = "#e30613";
  ctx.font = "900 24px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("超大", cx, cy - 12);
  ctx.fillText("増刊", cx, cy + 14);

  // 底部主标题（封面主推作品）
  const bg = ctx.createLinearGradient(0, H - 220, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(227,6,19,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 220, W, 220);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("巻頭カラー  ·  COVER STORY", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 56px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, 25, H - 60);

  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 30);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 18: ファミ通 风
// 特征：蓝红高对比、横向cross-review评分格、游戏标题列表
// ============================================
function drawFamitsu(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部蓝色色块
  ctx.fillStyle = "#0044aa";
  ctx.fillRect(0, 0, W, 130);

  // "週刊" 小字 + ファミ通巨字
  ctx.fillStyle = "#fff";
  ctx.font = "900 18px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("週刊", 25, 18);

  ctx.fillStyle = "#ffd636";
  ctx.font = "900 76px 'Shippori Mincho B1'";
  ctx.fillText("ファミ通", 25, 40);

  // 右上期号
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px Inter";
  ctx.textAlign = "right";
  ctx.fillText("No.1856  ·  " + opts.issueDate, W - 25, 22);
  ctx.fillText("¥600", W - 25, 42);
  ctx.font = "700 11px 'Noto Sans JP'";
  ctx.fillText("毎週木曜日発売", W - 25, 62);
  ctx.font = "italic 700 12px 'Playfair Display'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText("FAMITSU WEEKLY", W - 25, 84);

  // 横向 cross-review 评分格（ファミ通灵魂！）
  const boxY = 145;
  ctx.fillStyle = "#fff";
  ctx.fillRect(20, boxY, W - 40, 70);
  ctx.strokeStyle = "#0044aa";
  ctx.lineWidth = 3;
  ctx.strokeRect(20, boxY, W - 40, 70);

  ctx.fillStyle = "#0044aa";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("クロスレビュー", 30, boxY + 10);
  ctx.font = "600 11px 'Noto Sans JP'";
  ctx.fillStyle = "#666";
  ctx.fillText("CROSS REVIEW · プラチナ殿堂入り", 30, boxY + 30);

  // 4 个评分
  const scores = ["9", "10", "9", "10"];
  const startX = W - 220;
  scores.forEach((s, i) => {
    const sx = startX + i * 40;
    ctx.fillStyle = "#0044aa";
    ctx.fillRect(sx, boxY + 18, 32, 36);
    ctx.fillStyle = "#fff";
    ctx.font = "900 24px 'Shippori Mincho B1'";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(s, sx + 16, boxY + 36);
  });
  // 合计
  ctx.fillStyle = "#e30613";
  ctx.fillRect(W - 60, boxY + 18, 40, 36);
  ctx.fillStyle = "#fff";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.fillText("合計", W - 40, boxY + 28);
  ctx.font = "900 18px Inter";
  ctx.fillText("38/40", W - 40, boxY + 46);

  // 左侧游戏列表 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "PS5 / Switch2 / Xbox", 25, 280, { font: "900 14px Inter", color: "#ffd636" });
  drawCoverline(ctx, "今週の超注目作", 25, 305, { font: "900 22px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "完全攻略 256 PAGES", 25, 340, { font: "700 13px 'Noto Sans JP'", color: "#fff" });
  drawCoverline(ctx, "独占インタビュー", 25, 380, { font: "900 18px 'Shippori Mincho B1'", color: "#ffd636" });
  drawCoverline(ctx, "Game Director 公開", 25, 405, { font: "600 12px Inter", color: "#fff" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 220, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,68,170,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 220, W, 220);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("THIS WEEK'S COVER · 表紙特集", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 54px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, 25, H - 60);

  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 30);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 19: Newtype 风
// 特征：青蓝/银色金属感、动漫月刊、Newtype wordmark
// ============================================
function drawNewtypeMag(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 上方深蓝渐变
  const grad = ctx.createLinearGradient(0, 0, 0, 200);
  grad.addColorStop(0, "rgba(10,30,80,0.85)");
  grad.addColorStop(1, "rgba(10,30,80,0)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, 200);

  // Newtype wordmark（金属银色感，用渐变实现）
  const wordGrad = ctx.createLinearGradient(0, 25, 0, 100);
  wordGrad.addColorStop(0, "#fff");
  wordGrad.addColorStop(0.5, "#aac8ff");
  wordGrad.addColorStop(1, "#fff");
  ctx.fillStyle = wordGrad;
  ctx.font = "italic 900 84px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("Newtype", 25, 25);

  // ニュータイプ 副标
  ctx.fillStyle = "#aac8ff";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.fillText("ニュータイプ  ·  THE ANIME MAGAZINE", 28, 110);

  // 右上
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px Inter";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText("No.482  ·  " + opts.issueDate, W - 25, 30);
  ctx.fillText("¥820", W - 25, 50);

  // 左侧 anime 标题 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  drawCoverline(ctx, "巻頭スペシャル", 25, 240, { font: "900 16px 'Shippori Mincho B1'", color: "#aac8ff" });
  drawCoverline(ctx, "ANIME NOW", 25, 265, { font: "italic 900 28px 'DM Serif Display'", color: "#fff" });
  drawCoverline(ctx, "话题作TOP 10", 25, 305, { font: "700 13px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "MECHA SPECIAL", 25, 380, { font: "900 22px 'Anton'", color: "#aac8ff" });
  drawCoverline(ctx, "戦う少年たちの今", 25, 410, { font: "500 12px 'Noto Sans JP'", color: "#fff" });

  // 右侧
  drawCoverline(ctx, "INTERVIEW", W - 25, 440, { font: "900 22px 'Anton'", color: "#aac8ff", align: "right" });
  drawCoverline(ctx, "監督 & 声優 独占", W - 25, 470, { font: "500 12px 'Noto Sans JP'", color: "#fff", align: "right" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 240, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(10,30,80,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 240, W, 240);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  ctx.fillStyle = "#aac8ff";
  ctx.font = "italic 700 14px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("COVER STORY · 表紙特集", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 54px 'DM Serif Display'";
  ctx.fillText(opts.mainTitle, 25, H - 55);

  ctx.font = "500 14px 'Noto Sans JP'";
  ctx.fillStyle = "#aac8ff";
  ctx.fillText(opts.subtitle, 25, H - 25);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 20: コロコロコミック 风
// 特征：彩虹爆炸感、儿童漫画、巨字+贴纸+对话气泡
// ============================================
function drawCorocoro(ctx, opts) {
  // 黄色背景
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(0, 0, W, H);

  // 上方红色波浪条
  ctx.fillStyle = "#e30613";
  ctx.beginPath();
  ctx.moveTo(0, 110);
  for (let x = 0; x <= W; x += 30) {
    ctx.lineTo(x, 110 + Math.sin(x / 25) * 8);
  }
  ctx.lineTo(W, 0);
  ctx.lineTo(0, 0);
  ctx.closePath();
  ctx.fill();

  // コロコロコミック 大字
  ctx.fillStyle = "#fff";
  ctx.font = "900 56px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("コロコロ", 25, 18);

  ctx.fillStyle = "#000080";
  ctx.font = "900 28px 'Shippori Mincho B1'";
  ctx.fillText("コミック", W - 200, 38);

  // 右上期号
  ctx.fillStyle = "#fff";
  ctx.font = "900 12px Inter";
  ctx.textAlign = "right";
  ctx.fillText("¥600 · " + opts.issueDate, W - 25, 18);

  // 中部照片区（带白色描边像贴纸）
  const px = 50, py = 165, pw = W - 100, ph = H - 165 - 230;
  ctx.fillStyle = "#fff";
  ctx.fillRect(px - 8, py - 8, pw + 16, ph + 16);
  drawPhoto(ctx, { x: px, y: py, w: pw, h: ph }, opts.photo);

  // 各种彩色贴纸
  // 红色"新連載"贴纸 - 左上
  ctx.save();
  ctx.translate(70, 200);
  ctx.rotate(-0.15);
  ctx.fillStyle = "#e30613";
  ctx.fillRect(-50, -25, 100, 50);
  ctx.fillStyle = "#fff";
  ctx.font = "900 20px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("新連載!", 0, 0);
  ctx.restore();

  // 蓝色"超大"贴纸 - 右上
  ctx.save();
  ctx.translate(W - 70, 230);
  ctx.rotate(0.12);
  ctx.fillStyle = "#0044aa";
  ctx.beginPath();
  ctx.arc(0, 0, 45, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 18px 'Shippori Mincho B1'";
  ctx.fillText("超 大", 0, -10);
  ctx.fillText("付録!!", 0, 14);
  ctx.restore();

  // 底部 主标题
  ctx.fillStyle = "#000080";
  ctx.font = "900 50px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText(opts.mainTitle, W / 2, H - 200);

  // 红色描边主标 - 再叠一层
  ctx.fillStyle = "#e30613";
  ctx.font = "900 18px 'Shippori Mincho B1'";
  ctx.fillText("巻頭 巨大カラー！！", W / 2, H - 145);

  // 副标题 + 装饰
  ctx.fillStyle = "#000";
  ctx.font = "700 16px 'Noto Sans JP'";
  ctx.fillText(opts.subtitle, W / 2, H - 110);

  // 底部条
  ctx.fillStyle = "#e30613";
  ctx.fillRect(0, H - 60, W, 60);
  ctx.fillStyle = "#fff";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("毎月15日発売  ·  小学生のキング", W / 2, H - 30);
}

// ============================================
// 风格 21: りぼん 风
// 特征：粉色少女漫画、闪闪发光、cute、爱心和星星装饰
// ============================================
function drawRibon(ctx, opts) {
  // 粉色渐变背景
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, "#ffd9e8");
  grad.addColorStop(0.5, "#ffb3d1");
  grad.addColorStop(1, "#ff8fbc");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // 装饰星星
  function drawStar(cx, cy, size, color) {
    ctx.fillStyle = color;
    ctx.beginPath();
    for (let i = 0; i < 10; i++) {
      const r = i % 2 === 0 ? size : size * 0.45;
      const a = (i / 10) * Math.PI * 2 - Math.PI / 2;
      const x = cx + Math.cos(a) * r;
      const y = cy + Math.sin(a) * r;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.fill();
  }
  // 散落的星星
  const stars = [
    [60, 170, 10], [W - 60, 200, 14], [40, 280, 7], [W - 80, 320, 9],
    [80, 410, 8], [W - 50, 480, 12], [60, 580, 6], [W - 90, 620, 10],
  ];
  stars.forEach(([x, y, s]) => drawStar(x, y, s, "rgba(255,255,255,0.85)"));

  // りぼん 巨字（粉色描边白底）
  ctx.fillStyle = "#fff";
  ctx.font = "900 96px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.strokeStyle = "#e85a8a";
  ctx.lineWidth = 6;
  ctx.strokeText("りぼん", W / 2, 25);
  ctx.fillText("りぼん", W / 2, 25);

  // 副标
  ctx.fillStyle = "#fff";
  ctx.font = "900 12px Inter";
  ctx.fillText("MONTHLY RIBON  ·  少女漫画の王国", W / 2, 135);

  // 期号
  ctx.fillStyle = "#fff";
  ctx.font = "700 11px 'Noto Sans JP'";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate + "  ·  No.812", 25, 30);
  ctx.textAlign = "right";
  ctx.fillText("¥580", W - 25, 30);

  // 照片区（带粉色描边像贴纸）
  const px = 60, py = 165, pw = W - 120, ph = H - 165 - 240;
  ctx.fillStyle = "#fff";
  ctx.fillRect(px - 10, py - 10, pw + 20, ph + 20);
  ctx.strokeStyle = "#e85a8a";
  ctx.lineWidth = 3;
  ctx.setLineDash([6, 4]);
  ctx.strokeRect(px - 10, py - 10, pw + 20, ph + 20);
  ctx.setLineDash([]);
  drawPhoto(ctx, { x: px, y: py, w: pw, h: ph }, opts.photo);

  // 爱心装饰（左上贴纸）
  ctx.save();
  ctx.translate(80, 200);
  ctx.rotate(-0.2);
  ctx.fillStyle = "#e85a8a";
  // 简单的爱心
  ctx.beginPath();
  ctx.arc(-10, -5, 12, 0, Math.PI * 2);
  ctx.arc(10, -5, 12, 0, Math.PI * 2);
  ctx.moveTo(-22, -2);
  ctx.lineTo(0, 22);
  ctx.lineTo(22, -2);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 10px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("LOVE", 0, -2);
  ctx.restore();

  // 主标题
  ctx.fillStyle = "#7a1a4a";
  ctx.font = "900 44px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText(opts.mainTitle, W / 2, H - 215);

  ctx.fillStyle = "#fff";
  ctx.font = "900 14px Inter";
  ctx.fillText("巻頭カラー  ·  COVER STORY", W / 2, H - 165);

  ctx.fillStyle = "#7a1a4a";
  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillText(opts.subtitle, W / 2, H - 130);

  // 底部条
  ctx.fillStyle = "#e85a8a";
  ctx.fillRect(0, H - 70, W, 70);
  ctx.fillStyle = "#fff";
  ctx.font = "900 12px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("毎月3日発売  ·  ときめきの少女まんが", W / 2, H - 35);
}

// ============================================
// 风格 22: 週刊少年マガジン 风（講談社蓝色阵营）
// ============================================
function drawShonenMagazine(ctx, opts) {
  // 顶部蓝色色块
  ctx.fillStyle = "#0050b4";
  ctx.fillRect(0, 0, W, 145);

  // "週刊" 小字
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 22px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("週刊", 25, 18);

  // "少年マガジン" 巨大主字
  ctx.fillStyle = "#fff";
  ctx.font = "900 72px 'Shippori Mincho B1'";
  ctx.fillText("少年マガジン", 25, 50);

  // 右上 期号定价
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px Inter";
  ctx.textAlign = "right";
  ctx.fillText("No.34 / " + opts.issueDate, W - 25, 25);
  ctx.fillStyle = "#fff";
  ctx.fillText("¥390", W - 25, 45);
  ctx.font = "700 11px 'Noto Sans JP'";
  ctx.fillText("毎週水曜日発売 · 講談社", W - 25, 65);

  // 黄色横条
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(0, 145, W, 5);

  drawPhoto(ctx, { x: 0, y: 150, w: W, h: H - 150 }, opts.photo);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  const list = [
    ["巻頭カラー!!", "#ffd636"],
    ["新章開幕", "#fff"],
    ["センターカラー", "#ffd636"],
    ["熱血スポーツ", "#fff"],
    ["最新話 80P", "#ffd636"],
  ];
  let yy = 200;
  list.forEach(([t, col]) => {
    drawCoverline(ctx, t, 25, yy, { font: "900 18px 'Shippori Mincho B1'", color: col });
    yy += 28;
  });

  // 右侧蓝色方形 badge
  ctx.save();
  ctx.translate(W - 70, 280);
  ctx.rotate(-0.1);
  ctx.fillStyle = "#0050b4";
  ctx.fillRect(-55, -45, 110, 90);
  ctx.strokeStyle = "#ffd636";
  ctx.lineWidth = 3;
  ctx.strokeRect(-55, -45, 110, 90);
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 22px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("読切", 0, -15);
  ctx.fillStyle = "#fff";
  ctx.font = "900 14px Inter";
  ctx.fillText("SPECIAL", 0, 12);
  ctx.fillText("READ NOW!", 0, 30);
  ctx.restore();
  ctx.shadowBlur = 0;

  const bg = ctx.createLinearGradient(0, H - 220, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,80,180,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 220, W, 220);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("COVER STORY · 表紙特集", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 54px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, 25, H - 55);

  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 25);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 23: 週刊少年サンデー 风（小学館橙黄阵营）
// ============================================
function drawShonenSunday(ctx, opts) {
  // 顶部橙色色块
  ctx.fillStyle = "#f08000";
  ctx.fillRect(0, 0, W, 140);

  // "週刊" 小字
  ctx.fillStyle = "#fff";
  ctx.font = "900 22px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("週刊", 25, 18);

  // "少年サンデー" 巨大主字
  ctx.fillStyle = "#fff";
  ctx.font = "900 74px 'Shippori Mincho B1'";
  ctx.fillText("少年サンデー", 25, 50);

  // 顶部小太阳标志
  ctx.fillStyle = "#ffd636";
  ctx.beginPath();
  ctx.arc(W - 55, 60, 28, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#f08000";
  ctx.font = "900 12px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("SUN", W - 55, 53);
  ctx.fillText("DAY", W - 55, 68);

  ctx.fillStyle = "#fff";
  ctx.font = "900 13px Inter";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText("No.42 · " + opts.issueDate, W - 100, 28);
  ctx.fillText("¥350 · 小学館", W - 100, 48);

  ctx.fillStyle = "#005baa";
  ctx.fillRect(0, 140, W, 6);

  drawPhoto(ctx, { x: 0, y: 146, w: W, h: H - 146 }, opts.photo);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "ミステリー", 25, 200, { font: "900 22px 'Shippori Mincho B1'", color: "#ffd636" });
  drawCoverline(ctx, "急展開!!", 25, 230, { font: "900 28px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "犯人は意外な人物だった", 25, 275, { font: "500 13px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "ラブコメ", 25, 350, { font: "900 22px 'Shippori Mincho B1'", color: "#ffd636" });
  drawCoverline(ctx, "胸キュン青春!", 25, 380, { font: "900 22px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "幼なじみと恋する季節", 25, 415, { font: "500 13px 'Noto Sans JP'", color: "#fff" });
  ctx.shadowBlur = 0;

  // 底部
  const bg = ctx.createLinearGradient(0, H - 220, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(240,128,0,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 220, W, 220);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("巻頭センターカラー", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 54px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, 25, H - 55);

  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 25);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 24: ちゃお 风（小学館少女向，比りぼん更低龄、更彩虹）
// ============================================
function drawCiao(ctx, opts) {
  // 多彩渐变
  const grad = ctx.createLinearGradient(0, 0, W, H);
  grad.addColorStop(0, "#ffe0f0");
  grad.addColorStop(0.5, "#e8f0ff");
  grad.addColorStop(1, "#fff0d8");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // 满天彩色小点点
  const dotColors = ["#ff6fa6", "#5fb6ff", "#ffd636", "#7ad88a"];
  for (let i = 0; i < 50; i++) {
    ctx.fillStyle = dotColors[i % dotColors.length];
    ctx.beginPath();
    ctx.arc(Math.random() * W, Math.random() * H, 3 + Math.random() * 5, 0, Math.PI * 2);
    ctx.fill();
  }

  // ちゃお 巨字（粉色描边白底）
  ctx.fillStyle = "#fff";
  ctx.font = "900 110px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.strokeStyle = "#ff6fa6";
  ctx.lineWidth = 8;
  ctx.strokeText("ちゃお", W / 2, 15);
  ctx.fillText("ちゃお", W / 2, 15);

  ctx.fillStyle = "#5fb6ff";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.fillText("Ciao  ·  小学館の少女まんが", W / 2, 145);

  ctx.fillStyle = "#666";
  ctx.font = "700 11px 'Noto Sans JP'";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate + "号 · ¥680", 25, 30);

  // 照片区（彩色虚线方框）
  const px = 60, py = 175, pw = W - 120, ph = H - 175 - 250;
  ctx.fillStyle = "#fff";
  ctx.fillRect(px - 10, py - 10, pw + 20, ph + 20);
  drawPhoto(ctx, { x: px, y: py, w: pw, h: ph }, opts.photo);
  ctx.strokeStyle = "#ff6fa6";
  ctx.lineWidth = 3;
  ctx.setLineDash([8, 4]);
  ctx.strokeRect(px - 10, py - 10, pw + 20, ph + 20);
  ctx.setLineDash([]);

  // 左上 黄色"新連載"贴纸
  ctx.save();
  ctx.translate(80, 210);
  ctx.rotate(-0.15);
  ctx.fillStyle = "#ffd636";
  ctx.beginPath();
  ctx.arc(0, 0, 40, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#ff6fa6";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("新", 0, -10);
  ctx.fillText("連載!!", 0, 10);
  ctx.restore();

  // 右上 蓝色付録 badge
  ctx.save();
  ctx.translate(W - 80, 250);
  ctx.rotate(0.12);
  ctx.fillStyle = "#5fb6ff";
  ctx.fillRect(-50, -30, 100, 60);
  ctx.fillStyle = "#fff";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.fillText("超豪華", 0, -8);
  ctx.fillText("付録!!", 0, 12);
  ctx.restore();

  // 底部主标题
  ctx.fillStyle = "#ff3a85";
  ctx.font = "900 38px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText(opts.mainTitle, W / 2, H - 220);

  ctx.fillStyle = "#5fb6ff";
  ctx.font = "900 14px 'Noto Sans JP'";
  ctx.fillText("巻頭オールカラー", W / 2, H - 170);

  ctx.fillStyle = "#000";
  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillText(opts.subtitle, W / 2, H - 135);

  // 底部条
  ctx.fillStyle = "#ff6fa6";
  ctx.fillRect(0, H - 60, W, 60);
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("毎月3日発売 · 小学生の女の子大集合!", W / 2, H - 30);
}

// ============================================
// 风格 25: ヤングジャンプ 风（集英社青年向）
// ============================================
function drawYoungJump(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部黑色色块
  ctx.fillStyle = "#000";
  ctx.fillRect(0, 0, W, 130);

  // ヤング 小字红底
  ctx.fillStyle = "#e30613";
  ctx.fillRect(25, 18, 130, 38);
  ctx.fillStyle = "#fff";
  ctx.font = "900 26px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("ヤング", 90, 37);

  // ジャンプ 巨字黄底
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 64px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("ジャンプ", 165, 50);

  // 右上
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px Inter";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText("No.36 · " + opts.issueDate, W - 25, 25);
  ctx.fillStyle = "#ffd636";
  ctx.fillText("¥420", W - 25, 45);
  ctx.font = "italic 700 11px 'Playfair Display'";
  ctx.fillStyle = "#fff";
  ctx.fillText("WEEKLY YOUNG JUMP", W - 25, 70);

  // 黄色横条
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(0, 130, W, 4);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  drawCoverline(ctx, "巻頭グラビア", 25, 200, { font: "900 22px 'Shippori Mincho B1'", color: "#ffd636" });
  drawCoverline(ctx, "夏の独占撮り下ろし", 25, 232, { font: "500 14px 'Noto Sans JP'", color: "#fff" });
  drawCoverline(ctx, "PHOTO BOOK SPECIAL", 25, 255, { font: "900 14px Inter", color: "#ffd636" });

  drawCoverline(ctx, "新連載", 25, 340, { font: "900 22px 'Shippori Mincho B1'", color: "#e30613" });
  drawCoverline(ctx, "BATTLE OF THE YEAR", 25, 370, { font: "900 22px 'Anton'", color: "#fff" });
  drawCoverline(ctx, "今もっとも熱い青年漫画", 25, 400, { font: "500 13px 'Noto Sans JP'", color: "#fff" });
  ctx.shadowBlur = 0;

  // 右下角红色"独占"印章
  ctx.save();
  ctx.translate(W - 65, 460);
  ctx.rotate(-0.18);
  ctx.fillStyle = "#e30613";
  ctx.beginPath();
  ctx.arc(0, 0, 45, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = "#fff";
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.arc(0, 0, 38, 0, Math.PI * 2);
  ctx.stroke();
  ctx.fillStyle = "#fff";
  ctx.font = "900 16px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("独占", 0, -10);
  ctx.fillText("撮影", 0, 12);
  ctx.restore();

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 230, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 230, W, 230);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("CENTER COLOR · 巻頭センターカラー", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 52px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, 25, H - 55);

  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 25);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 26: 週刊プレイボーイ 风（便利店写真偶像周刊）
// ============================================
function drawWeeklyPlayboy(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部白色色块（写真杂志通常顶部留白）
  ctx.fillStyle = "#fff";
  ctx.fillRect(0, 0, W, 115);

  // 週刊 小字
  ctx.fillStyle = "#000";
  ctx.font = "900 18px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("週刊", 25, 22);

  // プレイボーイ 巨大主字 + 兔子图标
  ctx.fillStyle = "#e30613";
  ctx.font = "900 66px 'Shippori Mincho B1'";
  ctx.fillText("プレイボーイ", 25, 45);

  // 简易兔头剪影
  const bx = W - 95, by = 60;
  ctx.fillStyle = "#000";
  ctx.beginPath();
  ctx.ellipse(bx, by, 22, 22, 0, 0, Math.PI * 2);
  ctx.fill();
  // 两只耳朵
  ctx.beginPath();
  ctx.ellipse(bx - 9, by - 22, 7, 18, -0.2, 0, Math.PI * 2);
  ctx.ellipse(bx + 4, by - 25, 6, 18, 0.3, 0, Math.PI * 2);
  ctx.fill();
  // 蝴蝶结
  ctx.fillStyle = "#e30613";
  ctx.fillRect(bx - 6, by + 12, 12, 5);

  // 右上信息
  ctx.fillStyle = "#000";
  ctx.font = "900 12px Inter";
  ctx.textAlign = "right";
  ctx.fillText("No.32 · " + opts.issueDate, W - 25, 25);
  ctx.fillText("¥520", W - 25, 45);

  ctx.fillStyle = "#e30613";
  ctx.fillRect(0, 115, W, 4);

  // 左侧 coverlines（夏日健康风）
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  drawCoverline(ctx, "巻頭独占", 25, 180, { font: "900 20px 'Shippori Mincho B1'", color: "#ffd636" });
  drawCoverline(ctx, "SUMMER GRAVURE", 25, 210, { font: "900 26px 'Anton'", color: "#fff" });
  drawCoverline(ctx, "今夏のアイドル特集", 25, 250, { font: "500 13px 'Noto Sans JP'", color: "#fff" });
  drawCoverline(ctx, "海・水着・スマイル", 25, 273, { font: "500 13px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "完全保存版", 25, 360, { font: "900 22px 'Shippori Mincho B1'", color: "#e30613" });
  drawCoverline(ctx, "60 PAGE PHOTOBOOK", 25, 392, { font: "900 16px Inter", color: "#fff" });
  drawCoverline(ctx, "巻末ポスター付き", 25, 418, { font: "500 13px 'Noto Sans JP'", color: "#ffd636" });
  ctx.shadowBlur = 0;

  // 主标题（人物名）
  const bg = ctx.createLinearGradient(0, H - 240, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.92)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 240, W, 240);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("巻頭グラビア · COVER STAR", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 52px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, 25, H - 55);

  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 25);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 27: FRIDAY 风（八卦/狗仔写真周刊）
// ============================================
function drawFriday(ctx, opts) {
