    "🍷 奢华生活方式": [
      { key: "dom_perignon", label: "Dom Pérignon 香槟", prompt: "holding or with a bottle of Dom Pérignon vintage champagne with iconic shield label and a champagne flute" },
      { key: "krug", label: "Krug 香槟", prompt: "with a bottle of Krug Grande Cuvée champagne in the iconic gold-foil bottle" },
