  // 期号
  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#1a1a1a";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText(opts.issueDate + "  ·  光文社", 30, 30);
  ctx.textAlign = "right";
  ctx.fillText("¥850", W - 30, 30);

  // 金色装饰条
  ctx.fillStyle = "#a37c4f";
  ctx.fillRect(0, 135, W, 3);

  // 左侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.6)";
  ctx.shadowBlur = 10;
  drawCoverline(ctx, "40代の輝き", 30, 220, { font: "italic 700 28px 'Bodoni Moda'", color: "#fff" });
  drawCoverline(ctx, "ELEGANT BEAUTY", 30, 258, { font: "700 14px Inter", color: "#a37c4f" });
  drawCoverline(ctx, "本当に上質な大人の装い", 30, 290, { font: "500 13px 'Shippori Mincho B1'", color: "#fff" });

  drawCoverline(ctx, "BEAUTY", W - 30, 410, { font: "italic 700 22px 'Bodoni Moda'", color: "#fff", align: "right" });
  drawCoverline(ctx, "美容医学", W - 30, 440, { font: "700 14px 'Shippori Mincho B1'", color: "#a37c4f", align: "right" });
  drawCoverline(ctx, "アラフォーのための", W - 30, 465, { font: "500 12px 'Shippori Mincho B1'", color: "#fff", align: "right" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 260, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(20,15,10,0.92)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 260, W, 260);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  ctx.fillStyle = "#a37c4f";
  ctx.font = "italic 600 14px 'Bodoni Moda'";
  ctx.textAlign = "center";
  ctx.textBaseline = "bottom";
  ctx.fillText("COVER STAR  ·  表紙特集", W / 2, H - 130);

  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 58px 'Bodoni Moda'";
  ctx.fillText(opts.mainTitle, W / 2, H - 70);

  ctx.font = "italic 500 16px 'DM Serif Display'";
  ctx.fillStyle = "#a37c4f";
  ctx.fillText(opts.subtitle, W / 2, H - 35);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 30: sweet 风（宝島社 · 糖系明星封面）
// ============================================
function drawSweet(ctx, opts) {
  // 粉色渐变
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, "#fff0f5");
  grad.addColorStop(1, "#ffd9e8");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // 散落小心心
  ctx.fillStyle = "rgba(255, 130, 180, 0.25)";
  for (let i = 0; i < 18; i++) {
    const x = Math.random() * W;
    const y = Math.random() * H;
    const s = 3 + Math.random() * 5;
    ctx.beginPath();
    ctx.arc(x - s * 0.4, y, s * 0.5, 0, Math.PI * 2);
    ctx.arc(x + s * 0.4, y, s * 0.5, 0, Math.PI * 2);
    ctx.moveTo(x - s * 0.8, y + s * 0.2);
    ctx.lineTo(x, y + s * 1.2);
    ctx.lineTo(x + s * 0.8, y + s * 0.2);
    ctx.fill();
  }

  // "sweet" 大字
  ctx.fillStyle = "#e85a8a";
  ctx.font = "italic 900 110px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("sweet", W / 2, 20);

  // tagline
  ctx.font = "500 12px 'Shippori Mincho B1'";
  ctx.fillStyle = "#3a2e26";
  ctx.fillText("スウィート  ·  ハッピー & キュート", W / 2, 145);

  // 期号
  ctx.font = "500 11px Inter";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate + "  ·  宝島社", 30, 30);
  ctx.textAlign = "right";
  ctx.fillText("¥1,200", W - 30, 30);

  // 照片
  const px = 75, py = 180, pw = W - 150, ph = H - 180 - 260;
  ctx.fillStyle = "#fff";
  ctx.fillRect(px - 8, py - 8, pw + 16, ph + 16);
  drawPhoto(ctx, { x: px, y: py, w: pw, h: ph }, opts.photo);

  // 特别附录星形 badge - 左侧
  ctx.save();
  ctx.translate(85, 250);
  ctx.rotate(-0.15);
  ctx.fillStyle = "#e85a8a";
  const spikes = 12, ro = 55, ri = 40;
  ctx.beginPath();
  for (let i = 0; i < spikes * 2; i++) {
    const r = i % 2 === 0 ? ro : ri;
    const a = (i / (spikes * 2)) * Math.PI * 2 - Math.PI / 2;
    const xx = Math.cos(a) * r;
    const yy = Math.sin(a) * r;
    i === 0 ? ctx.moveTo(xx, yy) : ctx.lineTo(xx, yy);
  }
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("特別付録", 0, -15);
  ctx.fillText("豪華", 0, 4);
  ctx.font = "900 9px Inter";
  ctx.fillText("BRAND BAG", 0, 20);
  ctx.restore();

  // 右侧另一个 badge
  ctx.save();
  ctx.translate(W - 70, 320);
  ctx.rotate(0.12);
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(-45, -20, 90, 40);
  ctx.fillStyle = "#e85a8a";
  ctx.font = "900 12px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("最新号", 0, -4);
  ctx.fillText("もうすぐ!", 0, 12);
  ctx.restore();

  // 主标题
  ctx.fillStyle = "#e85a8a";
  ctx.font = "900 38px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText(opts.mainTitle, W / 2, H - 235);

  // 白底加粉字小标签
  ctx.fillStyle = "#fff";
  ctx.fillRect(W / 2 - 100, H - 185, 200, 30);
  ctx.fillStyle = "#e85a8a";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textBaseline = "middle";
  ctx.fillText("巻頭オールカラー", W / 2, H - 170);

  ctx.fillStyle = "#3a2e26";
  ctx.font = "700 14px 'Shippori Mincho B1'";
  ctx.textBaseline = "top";
  ctx.fillText(opts.subtitle, W / 2, H - 140);

  // 底部条
  ctx.fillStyle = "#e85a8a";
  ctx.fillRect(0, H - 60, W, 60);
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textBaseline = "middle";
  ctx.fillText("happy & kawaii  —  sweet で恋する毎日", W / 2, H - 30);
}

// ============================================
// 风格 31: ViVi 风（講談社 · K-Pop 韩流爆炸感）
// ============================================
function drawViVi(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部高饱和色块
  ctx.fillStyle = "#ff0080";
  ctx.fillRect(0, 0, W, 130);

  // ViVi 巨字
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 100px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("ViVi", 25, 10);

  // 副信息
  ctx.font = "900 12px Inter";
  ctx.textAlign = "right";
  ctx.fillText(opts.issueDate, W - 25, 25);
  ctx.fillText("¥780  ·  講談社", W - 25, 45);
  ctx.font = "italic 700 11px 'DM Serif Display'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText("VIVI  ·  韓流 × 美容 × ファッション", W - 25, 75);

  // 黄色横条
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(0, 130, W, 5);

  // 大量小 coverline
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "K-BEAUTY", 25, 200, { font: "900 30px 'Anton'", color: "#ffd636" });
  drawCoverline(ctx, "全攻略", 25, 235, { font: "900 30px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "アイドル級美肌の作り方", 25, 275, { font: "500 12px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "OOTD 100", 25, 350, { font: "900 26px 'Anton'", color: "#ff0080" });
  drawCoverline(ctx, "今着るべき", 25, 380, { font: "900 16px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "韓国ストリート最新", 25, 405, { font: "500 12px 'Noto Sans JP'", color: "#ffd636" });

  // 右下圆形 badge
  ctx.save();
  ctx.translate(W - 80, 460);
  ctx.rotate(-0.1);
  ctx.fillStyle = "#ff0080";
  ctx.beginPath();
  ctx.arc(0, 0, 55, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = "#fff";
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.arc(0, 0, 48, 0, Math.PI * 2);
  ctx.stroke();
  ctx.fillStyle = "#fff";
  ctx.font = "900 16px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("独占", 0, -14);
  ctx.font = "900 11px Inter";
  ctx.fillText("INTERVIEW", 0, 6);
  ctx.fillText("K-POP IDOL", 0, 22);
  ctx.restore();
  ctx.shadowBlur = 0;

  // 底部
  const bg = ctx.createLinearGradient(0, H - 240, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(255,0,128,0.92)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 240, W, 240);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffd636";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("COVER STAR  ·  巻頭独占", 25, H - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 56px 'Anton'";
  ctx.fillText(opts.mainTitle.toUpperCase(), 25, H - 55);

  ctx.font = "700 14px 'Noto Sans JP'";
  ctx.fillStyle = "#ffd636";
  ctx.fillText(opts.subtitle, 25, H - 25);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 32: VoCE 风（講談社 · 美妆杂志，大头特写）
// ============================================
function drawVoCE(ctx, opts) {
  // 白底
  ctx.fillStyle = "#fff";
  ctx.fillRect(0, 0, W, H);

  // VoCE 巨字
  ctx.fillStyle = "#000";
  ctx.font = "italic 900 96px 'Bodoni Moda'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("VoCE", W / 2, 22);

  // tagline
  ctx.font = "italic 500 13px 'DM Serif Display'";
  ctx.fillStyle = "#e85a8a";
  ctx.fillText("BEAUTY EDITORIAL  ·  ヴォーチェ", W / 2, 130);

  // 期号
  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#666";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate + "  ·  講談社", 30, 35);
  ctx.textAlign = "right";
  ctx.fillText("¥720", W - 30, 35);

  // 粉色装饰条
  ctx.fillStyle = "#e85a8a";
  ctx.fillRect(0, 158, W, 3);

  // 照片 - 大头特写区域
  drawPhoto(ctx, { x: 0, y: 161, w: W, h: H - 161 - 210 }, opts.photo);

  // 散落美容标签
  function makeTag(x, y, label, sub, bg, fg) {
    ctx.save();
    ctx.translate(x, y);
    ctx.shadowColor = "rgba(0,0,0,0.3)";
    ctx.shadowBlur = 8;
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, 130, 52);
    ctx.shadowBlur = 0;
    ctx.fillStyle = fg;
    ctx.font = "900 15px 'Shippori Mincho B1'";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(label, 65, 18);
    ctx.font = "500 9px Inter";
    ctx.fillText(sub, 65, 38);
    ctx.restore();
  }
  makeTag(25, 220, "BEST COSME", "ベストコスメ大賞", "#e85a8a", "#fff");
  makeTag(W - 155, 330, "美肌", "PORE-LESS SKIN", "#000", "#fff");

  // 主标题
  ctx.fillStyle = "#e85a8a";
  ctx.font = "900 13px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("COVER STORY  ·  特集", W / 2, H - 195);

  ctx.fillStyle = "#000";
  ctx.font = "900 40px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, W / 2, H - 168);

  ctx.font = "italic 500 16px 'Bodoni Moda'";
  ctx.fillStyle = "#666";
  ctx.fillText(opts.subtitle, W / 2, H - 100);

  // 底部细线
  ctx.strokeStyle = "#000";
  ctx.lineWidth = 0.5;
  ctx.beginPath();
  ctx.moveTo(30, H - 65);
  ctx.lineTo(W - 30, H - 65);
  ctx.stroke();

  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#888";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("VoCE  —  JAPAN'S BEAUTY MAGAZINE", 30, H - 55);
  ctx.textAlign = "right";
  ctx.fillText("KODANSHA", W - 30, H - 55);

  ctx.font = "italic 500 11px 'Bodoni Moda'";
  ctx.fillStyle = "#e85a8a";
  ctx.textAlign = "center";
  ctx.fillText("MAKEUP  ·  SKINCARE  ·  HAIR  ·  WELLNESS", W / 2, H - 30);
}

// ============================================
