  // 副信息
  ctx.font = "500 11px 'Shippori Mincho B1'";
  ctx.fillStyle = "#000";
  ctx.fillText("誰でも簡単に人気キャラになれる!! ウィッグ＆衣装もMAKEもこっちゃおっ☆", 25, 125);

  // 红色横条
  ctx.fillStyle = "#e30613";
  ctx.fillRect(0, 150, W, 4);

  // 左侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "夏コスメ", 25, 220, { font: "900 20px 'Shippori Mincho B1'", color: "#ffd636" });
  drawCoverline(ctx, "トラブル全力回避術", 25, 250, { font: "500 13px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "極めろ! 刀キャラ", 25, 295, { font: "900 20px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "やっぱりBL撮影!", 25, 325, { font: "500 13px 'Noto Sans JP'", color: "#ffd636" });

  // 右侧
  drawCoverline(ctx, "小顔になれる", W - 25, 220, { font: "900 18px 'Shippori Mincho B1'", color: "#ffd636", align: "right" });
  drawCoverline(ctx, "テクニック!", W - 25, 248, { font: "900 18px 'Shippori Mincho B1'", color: "#fff", align: "right" });

  drawCoverline(ctx, "アイドル撮影 11テク", W - 25, 295, { font: "900 16px 'Shippori Mincho B1'", color: "#fff", align: "right" });
  drawCoverline(ctx, "ふた重を描いて作ろう!", W - 25, 320, { font: "500 13px 'Noto Sans JP'", color: "#ffd636", align: "right" });

  drawCoverline(ctx, "「AR performers」特集", W - 25, 370, { font: "900 14px 'Shippori Mincho B1'", color: "#fff", align: "right" });
  ctx.shadowBlur = 0;

  // 左下角圆形 before/after
  ctx.save();
  ctx.translate(75, H - 230);
  ctx.fillStyle = "#fff";
  ctx.strokeStyle = "#e30613";
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.arc(0, 0, 38, 0, Math.PI * 2);
  ctx.fill();
  ctx.stroke();
  ctx.fillStyle = "#e30613";
  ctx.font = "900 12px Inter";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("Before", -10, -8);
  ctx.fillText("After", 10, 8);
  ctx.fillStyle = "#000";
  ctx.font = "500 9px 'Noto Sans JP'";
  ctx.fillText("レイヤー直伝", 0, 25);
  ctx.restore();

  // 底部主标题 - 黑色横幅
  ctx.fillStyle = "#000";
  ctx.fillRect(0, H - 165, W, 5);

  const bg = ctx.createLinearGradient(0, H - 160, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.92)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 160, W, 160);

  // 大字 今、アイドルがアツイ!
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 38px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("今、" + opts.mainTitle + "が", 25, H - 60);

  ctx.fillStyle = "#ffd636";
  ctx.font = "italic 900 56px 'Anton'";
  ctx.fillText("アツイ!", 25, H - 15);

  ctx.fillStyle = "#fff";
  ctx.font = "500 13px 'Noto Sans JP'";
  ctx.textBaseline = "top";
  ctx.fillText(opts.subtitle, 25, H - 50);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 42: JKegg 风（成人 Y2K GAL 街头时尚）
// ============================================
function drawJKegg(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部半透明色块让标志可见
  ctx.fillStyle = "rgba(255, 230, 240, 0.4)";
  ctx.fillRect(0, 0, W, 165);

  // "JK" 巨字粉色泡泡
  ctx.fillStyle = "#ff3a85";
  ctx.font = "900 130px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("JK", 25, 5);
  ctx.fillStyle = "#fff";
  ctx.strokeStyle = "#ff3a85";
  ctx.lineWidth = 4;
  // "egg" 紧贴 JK，小一些
  ctx.font = "900 110px 'Anton'";
  ctx.strokeText("egg", 215, 18);
  ctx.fillStyle = "#ff85c0";
  ctx.fillText("egg", 215, 18);

  // ジェイケー・エッグ 副标
  ctx.fillStyle = "#ff3a85";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.fillText("ジェイケー・エッグ", 215, 130);

  // 顶部 tagline
  ctx.fillStyle = "#ff3a85";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.fillText("GAL STREET STYLE SPECIAL", W - 330, 18);
  ctx.fillText("Y2K MIX SNAP ISSUE", W - 330, 36);

  // 右上 Vol & Price
  ctx.fillStyle = "#ff3a85";
  ctx.font = "900 16px 'Shippori Mincho B1'";
  ctx.textAlign = "right";
  ctx.fillText("2012春号", W - 25, 70);
  ctx.font = "900 28px 'Anton'";
  ctx.fillText("Vol.01", W - 25, 90);
  // PRICE 圆形
  ctx.save();
  ctx.translate(W - 60, 145);
  ctx.fillStyle = "#ff85c0";
  ctx.beginPath();
  ctx.arc(0, 0, 30, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 11px Inter";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("PRICE", 0, -8);
  ctx.fillText("500", 0, 4);
  ctx.fillText("YEN", 0, 18);
  ctx.restore();

  // 左中爱心粉色 badge
  ctx.save();
  ctx.translate(70, 220);
  ctx.rotate(-0.12);
  ctx.fillStyle = "#ff85c0";
  ctx.beginPath();
  // 爱心形状
  ctx.arc(-15, -10, 22, 0, Math.PI * 2);
  ctx.arc(15, -10, 22, 0, Math.PI * 2);
  ctx.moveTo(-30, -3);
  ctx.lineTo(0, 35);
  ctx.lineTo(30, -3);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 12px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("STYLE", 0, -8);
  ctx.fillText("TALK", 0, 6);
  ctx.fillText("SNAP", 0, 20);
  ctx.restore();

  // 左侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.6)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "アゲぽよGAL", 25, 330, { font: "900 22px 'Shippori Mincho B1'", color: "#ff3a85" });
  drawCoverline(ctx, "大集合", 25, 360, { font: "900 22px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "盛れるヘア", 25, 405, { font: "900 18px 'Shippori Mincho B1'", color: "#5fb6ff" });
  drawCoverline(ctx, "メイク完全攻略", 25, 430, { font: "900 18px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "Y2K 小物LIST", 25, 470, { font: "900 16px Inter", color: "#ff85c0" });
  drawCoverline(ctx, "バッグ・ネイル・アクセ", 25, 492, { font: "900 14px 'Shippori Mincho B1'", color: "#fff" });
  ctx.shadowBlur = 0;

  // 右下圆形章
  ctx.save();
  ctx.translate(W - 75, 350);
  ctx.rotate(0.1);
  ctx.fillStyle = "#ff3a85";
  ctx.beginPath();
  ctx.arc(0, 0, 45, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 14px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("THE", 0, -14);
  ctx.fillText("モチケン!", 0, 4);
  ctx.font = "900 8px Inter";
  ctx.fillText("ガサ入れ♪", 0, 22);
  ctx.restore();

  // 右侧竖排小标题
  ctx.save();
  ctx.translate(W - 28, 250);
  ctx.rotate(Math.PI / 2);
  ctx.fillStyle = "#fff";
  ctx.font = "900 13px Inter";
  ctx.textAlign = "left";
  ctx.fillText("HAIR / MAKE / NAIL / STREET SNAP / LOVE BRAND", 0, 0);
  ctx.restore();

  // 底部主标题
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#fff";
  ctx.strokeStyle = "#ff3a85";
  ctx.lineWidth = 4;
  ctx.font = "italic 900 36px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.strokeText("コレがリアル系", 25, H - 240);
  ctx.fillText("コレがリアル系", 25, H - 240);

  // 春のY2K STYLE!!! 渐变粉蓝
  ctx.font = "italic 900 56px 'Anton'";
  ctx.fillStyle = "#5fb6ff";
  ctx.strokeText("春のY2K", 25, H - 195);
  ctx.fillText("春のY2K", 25, H - 195);

  ctx.fillStyle = "#5fb6ff";
  ctx.font = "italic 900 68px 'Anton'";
  ctx.strokeText("STYLE!!!", 25, H - 135);
  ctx.fillText("STYLE!!!", 25, H - 135);
  ctx.shadowBlur = 0;

  // 底部 5DAYS 圆章
  ctx.save();
  ctx.translate(W - 80, H - 75);
  ctx.fillStyle = "#ff3a85";
  ctx.beginPath();
  ctx.arc(0, 0, 50, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = "#fff";
  ctx.font = "900 12px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("EGG", 0, -22);
  ctx.font = "900 42px 'Anton'";
  ctx.fillText("5", 0, 0);
  ctx.font = "900 16px 'Anton'";
  ctx.fillText("DAYS", 0, 25);
  ctx.restore();

  // 底部杂志信息条 + 条码感
  ctx.fillStyle = "rgba(255,255,255,0.88)";
  ctx.fillRect(22, H - 28, 330, 14);
  ctx.fillStyle = "#ff3a85";
  ctx.font = "900 9px Inter";
  ctx.textAlign = "left";
  ctx.fillText("STREET SNAP 100 / Y2K BRAND MIX / ADULT GAL BEAUTY / TOKYO NIGHT GUIDE", 28, H - 26);
  ctx.fillStyle = "rgba(255,255,255,0.92)";
  ctx.fillRect(W - 78, H - 42, 52, 28);
  ctx.fillStyle = "#111";
  for (let i = 0; i < 12; i++) {
    const bw = i % 3 === 0 ? 3 : 1;
    ctx.fillRect(W - 72 + i * 4, H - 38, bw, 20);
  }

  // GLIDE MEDIA 顶部右
  ctx.fillStyle = "#ff3a85";
  ctx.font = "900 10px Inter";
  ctx.textAlign = "right";
  ctx.fillText("GLIDE MEDIA MOOK62", W - 25, 5);
}

