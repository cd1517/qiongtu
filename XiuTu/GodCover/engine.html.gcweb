  // 主分类标签 (用于下拉 / 渲染)
  const MAIN_CATEGORIES = Object.keys(SCENE_LIBRARY);


  function buildBeautyRetouchPrompt(gender, strength, parts) {
    if (strength === "none") {
      return " === BEAUTY RETOUCHING === Keep the subject's natural face and body. Do not apply beauty-filter changes beyond normal photographic color correction.";
    }
    const selectedKeys = Array.isArray(parts) && parts.length ? parts : RETOUCH_PARTS.map((item) => item.key);
    const selected = selectedKeys.map((key) => RETOUCH_LOOKUP[key]).filter(Boolean);
    const base = (gender === "male" ? MALE_BEAUTY_PROMPTS[strength] : BEAUTY_PROMPTS[strength]) || BEAUTY_PROMPTS.subtle;
    const partText = selected.map((item) => item.prompt).join(" ");
    const scope = Array.isArray(parts) && parts.length
      ? "Use the selected areas below as the priority retouch focus; keep unselected facial/body features more natural and less changed."
      : "No priority area was selected by the user, so apply the chosen retouching strength evenly across the full face, hair, neck, and body styling.";
    return ` === TARGETED BEAUTY RETOUCHING === Retouching strength: ${base}. ${scope} Retouch instructions: ${partText} Preserve identity, asymmetry, natural skin texture, real facial proportions, and realistic photographic appearance.`;
  }

  function buildHairColorPrompt(colors) {
    const selected = (colors || []).map((key) => HAIR_COLOR_LOOKUP[key]).filter(Boolean);
    if (!selected.length) return "";
    const colorText = selected.map((item) => item.prompt).join(" + ");
    const mode = selected.length === 1
      ? "Apply this hair color naturally across the hair while preserving realistic roots, shadows, and strand detail."
      : "Create a tasteful multi-tone hair color look using these selected colors as highlights, ombre, underlayer color, streaks, or gradient dye; keep it fashionable and believable.";
    return ` === HAIR COLOR TRY-ON === ${mode} Selected colors: ${colorText}. Preserve the original hairstyle shape unless the persona asks for styling changes; do not change eyebrows unless it looks naturally coordinated.`;
  }


  function buildBrandPrompt(brandKeys) {
    if (!brandKeys || brandKeys.length === 0) return "";
    const items = brandKeys
      .map((k) => BRAND_LOOKUP[k])
      .filter(Boolean)
      .map((b, i) => `(${i + 1}) ${b.prompt}`)
      .join("; ");
    return ` === LUXURY BRAND ITEMS — INTEGRATE NATURALLY (same items across ALL photos in the album, must remain visually consistent) === The subject is naturally paired with the following luxury items, integrated tastefully as part of the subject's lifestyle in this editorial photoshoot (not as a logo-pasted advertisement — render the iconic shape, silhouette, color, and signature design elements of each item rather than focusing on fine logo details): ${items}. Integrate these items naturally into the composition — held, worn, alongside the subject, or in the background as appropriate. The SAME items must appear consistently across all photos in this album.`;
  }


  function plan(p) {
    var isExplore = !!p.explore;
    var photographerKeys = Object.keys(PHOTO_SCHOOLS_PROMPTS);
    var photographer = p.photographer === "random" || !p.photographer
      ? photographerKeys[Math.floor(Math.random() * photographerKeys.length)] : p.photographer;
    var scene = SCENE_LIBRARY[p.mainCategory][p.subScene];
    var sceneHint = String(p.sceneHint || "").trim();
    var personaPrompt = PERSONA_PROMPTS[p.persona] || "";
    var genderPrompt = GENDER_PROMPTS[p.gender] || "";
    var agePrompt = AGE_PROMPTS[p.age] || "";
    var beautyPrompt = buildBeautyRetouchPrompt(p.gender, p.beauty, p.retouchParts || []);
    var hairColorPrompt = buildHairColorPrompt(p.hairColors || []);
    var timeOfDay = p.timeOfDay || "auto";
    if (timeOfDay === "random") {
      var timeKeys = Object.keys(TIME_OF_DAY_PROMPTS).filter(function (k) { return k !== "auto" && k !== "random"; });
      timeOfDay = timeKeys[Math.floor(Math.random() * timeKeys.length)];
    }
    var timeOfDayPrompt = TIME_OF_DAY_PROMPTS[timeOfDay] || "";
    var brandPrompt = buildBrandPrompt(p.brands || []);
    var equipment = p.equipment || "auto";
    if (equipment === "random") {
      var eqKeys = Object.keys(EQUIPMENT_PROMPTS).filter(function (k) { return k !== "auto" && k !== "random"; });
      equipment = eqKeys[Math.floor(Math.random() * eqKeys.length)];
    }
    var equipmentPromptDefault = EQUIPMENT_PROMPTS[equipment] || "";
    var total = isExplore ? 6 : Number(p.count || 3);
    var combos = null;
    if (isExplore) {
      var eqPool = Object.keys(EQUIPMENT_PROMPTS).filter(function (k) { return k !== "auto" && k !== "random"; });
      var phShuffled = photographerKeys.slice().sort(function () { return Math.random() - 0.5; }).slice(0, total);
      var eqShuffled = eqPool.slice().sort(function () { return Math.random() - 0.5; }).slice(0, total);
      combos = phShuffled.map(function (ph, i) { return { photographer: ph, equipment: eqShuffled[i % eqShuffled.length] }; });
    }
    var shots = buildShotVariations(total, p.gender);
    var fullScenePrompt = " === SETTING / LOCATION === " + scene.prompt + (sceneHint ? " Additional setting note: " + sceneHint + "." : "");
    return shots.map(function (shot, i) {
      var shotPh = combos ? combos[i].photographer : photographer;
      var shotEq = combos ? combos[i].equipment : equipment;
      var photoSchoolPrompt = PHOTO_SCHOOLS_PROMPTS[shotPh] || "";
      var equipmentPrompt = EQUIPMENT_PROMPTS[shotEq] || equipmentPromptDefault;
      var shotPrompt = buildShotPrompt(shot, i, total, p.gender);
      var consistencyPrompt = isExplore ? ` === EXPLORE MODE — STYLE SAMPLING SHOT === This is photo ${i + 1} of a ${total}-photo style-exploration set. Each photo intentionally uses a DIFFERENT photographer style and camera/film combination so the user can preview multiple aesthetic directions. Keep the SAME person/face/identity and the SAME scene/location, but the photographic style, color, grain, and aesthetic SHOULD differ between photos to showcase the chosen photographer + equipment combination clearly.` : ` === CRITICAL CONSISTENCY — PHOTO ALBUM SHOT === This is photo ${i + 1} of a ${total}-photo album. ALL ${total} photos must feature the SAME person (same identity, face, ethnicity), SAME outfit/clothing, SAME hairstyle and makeup, SAME location/setting, all shot by the SAME photographer. ONLY the pose, framing, expression, and lighting moment vary between photos — like contact-sheet frames from a single photoshoot session. Do NOT change the outfit, location, or core appearance between photos.`;
      var prompt = STUDIO_SAFETY_PREAMBLE + agePrompt + personaPrompt + beautyPrompt + hairColorPrompt + fullScenePrompt +
        timeOfDayPrompt + photoSchoolPrompt + equipmentPrompt + brandPrompt + shotPrompt + consistencyPrompt + genderPrompt + STUDIO_SAFETY_FINAL;
      return {
        prompt: sanitizeGenerationPrompt(prompt),
        framing: shot.framingKey || "",
        photographer: PHOTOGRAPHER_LABEL[shotPh] || shotPh,
        equipment: EQUIPMENT_LABEL[shotEq] || "",
      };
    });
  }
  function pairs(obj) { return Object.keys(obj).map(function (k) { return { id: k, title: obj[k] }; }); }
  function catalog() {
    var brands = Object.keys(BRAND_LIBRARY).map(function (c) {
      return { title: c, items: BRAND_LIBRARY[c].map(function (b) { return { id: b.key, title: b.label }; }) };
    });
    return {
      categories: Object.keys(SCENE_LIBRARY).map(function (c) {
        return { title: c, scenes: Object.keys(SCENE_LIBRARY[c]).map(function (k) { return { id: k, title: SCENE_LIBRARY[c][k].label }; }) };
      }),
      photographers: [{ id: "random", title: "🎲 随机大师" }].concat(pairs(PHOTOGRAPHER_LABEL)),
      equipment: pairs(EQUIPMENT_LABEL),
      timeOfDay: pairs(TIME_OF_DAY_LABEL),
      retouchParts: RETOUCH_PARTS.map(function (r) { return { id: r.key, title: r.label }; }),
      hairColors: HAIR_COLORS.map(function (h) { return { id: h.key, title: h.label, swatch: h.swatch }; }),
      brands: brands,
    };
  }
  return { plan: plan, catalog: catalog };
})();

</script></body></html>
