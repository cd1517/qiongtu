      tokyotower: { label: "东京塔街拍", prompt: "Photographed with the iconic red-and-white Tokyo Tower lit up in the background, evening cityscape, atmospheric urban Tokyo landmark shot, soft directional bokeh on the tower lights." },
      tokyoskytree: { label: "晴空塔街拍", prompt: "Photographed in Asakusa or Sumida with the Tokyo Skytree visible in the background — the iconic blue-lit tallest tower in Japan, dramatic modern Tokyo skyline composition." },
      shimokita: { label: "下北沢文艺街", prompt: "Photographed in Shimokitazawa Tokyo — bohemian indie neighborhood with vintage clothing shops, indie cafes, small live music venues, colorful murals on alley walls, artsy hipster Tokyo subculture vibe." },
