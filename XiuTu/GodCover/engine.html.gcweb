};



function buildCoverPrompt(task) {
  const stylePrompt = STYLE_PROMPTS[task.style];
  const beautyPrompt =
    (task.gender === "male"
      ? MALE_BEAUTY_PROMPTS[task.beauty]
      : BEAUTY_PROMPTS[task.beauty]) || "";
  const beautyTail =
    (task.gender === "male"
      ? MALE_BEAUTY_REINFORCE_TAIL[task.beauty]
      : BEAUTY_REINFORCE_TAIL[task.beauty]) || "";
  const agePrompt = AGE_PROMPTS[task.age] || "";
  const personaPrompt = PERSONA_PROMPTS[task.persona] || "";
  const genderPrompt = GENDER_PROMPTS[task.gender] || "";
  const photoSchoolPrompt = PHOTO_SCHOOLS_PROMPTS[task.photoSchool] || "";
  const variationPrompt = buildVariationPrompt();
  let customTextPrompt = "";
  if (task.forceCustomText) {
    const t1 = (task.customMainTitle || "").trim();
    const t2 = (task.customSubtitle || "").trim();
    const t3 = (task.customIssueDate || "").trim();
    const t4 = (task.customPrice || "").trim();
    const parts = [];
    if (t1) parts.push(`MAIN TITLE / HEADLINE: "${t1}"`);
    if (t2) parts.push(`SUBTITLE / TAGLINE: "${t2}"`);
    if (t3) parts.push(`ADDITIONAL TEXT 1 (sponsor / issue / studio / etc.): "${t3}"`);
    if (t4) parts.push(`ADDITIONAL TEXT 2 (cast / director / price / credits): "${t4}"`);
    if (parts.length > 0) {
      customTextPrompt = ` === IMPORTANT: USE THESE EXACT USER-SPECIFIED TEXTS ON THE COVER === You MUST render these EXACT texts on the generated image (word-for-word as specified — replace any placeholder/generic text from the style instructions above with these user-specified texts): ${parts.join(". ")}. Adapt placement and styling to fit the design, but the actual wording must match these specifications exactly.`;
    }
  }
  return agePrompt + personaPrompt + beautyPrompt + " " + stylePrompt + photoSchoolPrompt + variationPrompt + buildBrandLockPrompt(task.style) + buildStyleSpecificVariationGuard(task.style) + beautyTail + genderPrompt + customTextPrompt;
}




// ---------- 取自网站后端：指令清理和无字版 ----------
function getCoverPromptBuilder() { return buildCoverPrompt; }
function buildCoverPromptFromWebTask(rawTask) { return buildCoverPrompt(normalizeCoverPromptTask(rawTask || {})); }
function buildCoverPhotoPromptFromWebTask(rawTask = {}) {
  const task = normalizeCoverPromptTask({
    ...rawTask,
    forceCustomText: false,
    customText: [],
    customMainTitle: "",
    customSubtitle: "",
    customIssueDate: "",
    customPrice: "",
  });
  return `${getCoverPromptBuilder()(task)}

=== FINAL OUTPUT MODE: CLEAN EDITORIAL PHOTOGRAPHY ONLY / NO-TEXT VERSION ===
Use the same publication/poster art direction, wardrobe styling, persona, photographer aesthetic, lighting, camera angle, pose variety, retouching level, and premium photographic quality described above, but output it as a clean standalone photo.
CRITICAL OVERRIDE: do NOT add any magazine cover design, masthead, title, logo, subtitle, coverlines, badges, stickers, issue date, barcode, price tag, captions, typography, letters, numbers, watermarks, UI elements, poster billing block, or graphic text of any kind.
The final image should look like the original high-end photo shoot before the magazine designer added typography: full photographic scene, tasteful composition, natural camera depth, subject and environment visible, no extreme meaningless close-up crops, no text anywhere.`;
}

function normalizeCoverPromptTask(rawTask = {}) {
  const customText = Array.isArray(rawTask.customText) ? rawTask.customText : [];
  return {
    style: String(rawTask.style || "vogue"),
    styleName: String(rawTask.styleName || rawTask.name || rawTask.style || "GodCover"),
    beauty: String(rawTask.beauty || rawTask.beautyLevel || "medium"),
    age: String(rawTask.age || rawTask.ageLevel || "original"),
    persona: String(rawTask.persona || "random"),
    gender: String(rawTask.gender || "auto"),
    photoSchool: String(rawTask.photoSchool || rawTask.photographer || "random"),
    forceCustomText: Boolean(rawTask.forceCustomText || customText.length),
    customMainTitle: String(rawTask.customMainTitle || customText[0] || ""),
    customSubtitle: String(rawTask.customSubtitle || customText[1] || ""),
    customIssueDate: String(rawTask.customIssueDate || customText[2] || ""),
    customPrice: String(rawTask.customPrice || customText[3] || ""),
  };
}
function sanitizeGenerationPrompt(prompt) {
  let next = String(prompt || "");
  const replacements = [
    [
      /=== AGE TRANSFORMATION: render subject as a YOUNG ADULT IN EARLY TWENTIES \(around age 19-22\) ===[\s\S]*?just rendered with the freshness and skin quality of a young adult\./g,
      "=== AGE TRANSFORMATION: render subject as an ADULT WOMAN IN HER EARLY TWENTIES (around age 22-25) === Apply fresh adult fashion-model rendering — smooth bright dewy skin, healthy luminous eyes, fresh natural makeup, confident adult energy with a bright expression. The result should clearly look like a 22-25 year old adult woman, never a teenager or student. IDENTITY: preserve the subject's core facial features and recognizable identity — same eye shape character, nose orientation, mouth shape, ethnicity — just rendered with the freshness and skin quality of an adult in her early twenties.",
    ],
    [
      /=== PERSONA: コスプレイヤー \(Cosplayer Character Aesthetic\) ===[\s\S]*?an aura of dedicated character embodiment\./g,
      "=== PERSONA: コスプレイヤー (Adult Cosplayer Character Aesthetic) === Style the subject as a passionate adult Japanese cosplayer in a polished character costume: wearing an elaborate anime/game-style wig, dramatic character makeup with defined eyeliner and dimensional eyeshadow, optional colored contact lenses while keeping adult facial proportions, and a fully dressed character-specific costume such as fantasy warrior, sci-fi heroine, elegant gothic fantasy, cyberpunk, historical fantasy, or game-hero attire. Keep the styling mature, professional, convention-photo-shoot appropriate, and not suggestive; avoid school, student, childlike, or minor-coded cues.",
    ],
    [
      /=== PHOTOGRAPHY STYLE: Tim Walker aesthetic ===[\s\S]*?magical childhood-imagination atmosphere\./g,
      "=== PHOTOGRAPHY STYLE: whimsical high-fashion fantasy editorial aesthetic === Use an adult high-fashion fantasy set: elaborate handcrafted set design with oversized flowers, vintage objects, sculptural props, painterly soft color palette, British eccentric romanticism, and mature couture styling. Keep the mood artistic and fashion-forward, never childlike.",
    ],
    [
      /=== PERSONA: 地雷系 \(Jirai-kei \/ 'Landmine' Dark-Cute Subculture\) ===[\s\S]*?an aura of melancholic dark cuteness\./g,
      "=== PERSONA: 黒ピンク暗黒スウィート (Black-Pink Dark Sweet Fashion Aesthetic) === Style the subject with a mature dark-sweet Japanese street-fashion vibe: black or dark hair with a split-color pink or red inner layer, pale polished skin, graphic black-and-red eye makeup, wine-red lipstick, subtle blush, confident composed gaze, black-and-pink fashion palette with ribbons as styling accents, lace-textured layers, fitted jacket or structured cardigan, silver accessories, and polished adult street-fashion attitude. Keep it fashionable, confident, and adult; avoid vulnerable, vacant, distressed, childlike, or mascot-like cues.",
    ],
    [
      /=== PHOTOGRAPHY STYLE: Bruce Weber aesthetic ===[\s\S]*?intimate brotherly\/family quality\./g,
      "=== PHOTOGRAPHY STYLE: sun-drenched adult lifestyle fashion aesthetic === Use warm sunlit adult lifestyle photography: athletic healthy adult fashion energy, black-and-white or warm sepia tones, outdoor natural settings, nostalgic Americana feel, classic preppy aesthetic, golden-hour warmth, relaxed editorial confidence.",
    ],
    [
      /IMPORTANT: This is an INSTALLATION ART EXHIBITION POSTER[\s\S]*?Installation art exhibition poster layout\./g,
      "IMPORTANT: This is a MUSEUM INSTALLATION ART EXHIBITION POSTER — NOT a magazine, NOT performance art, NOT body art. Transform the person in this photo into a fully clothed contemporary installation artist or curator featured on a public museum exhibition poster. Keep their face recognizable. Style: minimalist black/white gallery attire such as a structured blazer, long coat, turtleneck, wide-leg trousers, or simple architectural dress; composed professional expression; no sensual pose. Setting: a clean museum gallery with large-scale sculptural objects, mirrored geometric forms, LED light corridors, projection-mapping walls, colored glass, reflective spheres, suspended fabric panels, and safe public-gallery atmosphere. The artwork surrounds the person but never touches or covers the body. IMPORTANT SAFETY: no nudity, no lingerie, no body paint, no painted-on clothing, no exposed-skin focus, no erotic performance, no bondage, no body-as-canvas, no intimate pose. Exhibition poster layout: large readable title 'IMMERSIVE LIGHT / INSTALLATION ART', artist name, museum/gallery venue, exhibition dates, curator line, ticket information, clean modern typography. Contemporary installation art museum poster, architectural, fully clothed, gallery-safe, elegant and non-suggestive.",
    ],
  ];
  for (const [pattern, replacement] of replacements) {
    next = next.replace(pattern, replacement);
  }
  if (/INSTALLATION ART/i.test(next)) {
    next = next
      .replace(/body-as-canvas aesthetic with painted-on elements or graphic body styling/gi, "clean graphic museum-poster composition using clothing, lighting, and set design")
      .replace(/painted-on elements/gi, "graphic poster elements")
      .replace(/graphic body styling/gi, "graphic gallery styling")
      .replace(/intimate intense portrait photography/gi, "formal museum-poster portrait photography")
      .replace(/intimate candid feel/gi, "composed documentary gallery feel")
      .replace(/intimate-access glamour/gi, "polished editorial glamour");
    if (!/INSTALLATION ART SAFETY LOCK/i.test(next)) {
      next += " === INSTALLATION ART SAFETY LOCK === This must be a fully clothed public museum/gallery exhibition poster. The person is an adult artist, curator, or gallery visitor standing among sculptural light installations. No nudity, lingerie, body paint, painted-on clothing, skin-focused framing, erotic performance, bondage, or body-as-canvas concept. Keep the composition architectural, gallery-safe, professional, and non-suggestive.";
    }
  }
  if (/KOGYARU/i.test(next)) {
    next = next
      .replace(/'I CAN HUSTLE' tagline/gi, "small secondary 'I CAN HUSTLE' tagline")
      .replace(/I CAN HUSTLE tagline/gi, "small secondary I CAN HUSTLE tagline");
    if (!/STRICT MAGAZINE TITLE LOCK[\s\S]*KOGYARU/i.test(next)) {
      next += " === STRICT MAGAZINE TITLE LOCK === The main magazine masthead MUST read exactly 'KOGYARU'. It must be the largest and most prominent wordmark on the cover, placed across the top area or upper-left area in bold yellow/orange letters with a black outline. Do NOT replace the masthead with 'I CAN HUSTLE' or any other phrase. 'I CAN HUSTLE' is only a small secondary tagline, never the title. The generated cover is invalid if 'KOGYARU' is missing, tiny, hidden, or only appears as a small sticker.";
    }
  }
  return next
    .replace(/\b19-22\b/g, "22-25")
    .replace(/\b10代\b/g, "20代前半")
    .replace(/big anime-style eyes/gi, "expressive adult eyes")
    .replace(/doll-like big eyes/gi, "expressive adult eyes")
    .replace(/colored contact lenses to enlarge irises/gi, "optional colored contact lenses")
    .replace(/voluminous false lashes/gi, "defined lashes")
    .replace(/magical girl/gi, "fantasy heroine")
    .replace(/gothic Lolita/gi, "elegant gothic fantasy")
    .replace(/school uniform with cape/gi, "fantasy academy-inspired costume")
    .replace(/cute idol outfit/gi, "polished performance outfit")
    .replace(/childhood-imagination/gi, "high-fashion fantasy")
    .replace(/fantastical creatures/gi, "sculptural fantasy props")
    .replace(/young adult women/gi, "adult women")
    .replace(/young-adult urban/gi, "adult urban")
    .replace(/Landmine/gi, "Black-Pink Dark Sweet Fashion")
    .replace(/tear-stained/gi, "dramatic gradient")
    .replace(/vacant gaze/gi, "confident composed gaze")
    .replace(/melancholic/gi, "moody fashion")
    .replace(/plushie accessories/gi, "silver accessories")
    .replace(/frilly elements/gi, "lace-textured layers")
    .replace(/youthful subjects/gi, "adult fashion subjects")
    .replace(/brotherly\/family quality/gi, "relaxed editorial confidence")
    .replace(/minimalist editorial layout — large clean photo dominates with very few coverlines, lots of breathing room, almost art-poster feel/gi, "dense maximalist magazine layout with many coverlines, stickers, badges, and readable masthead");
}

// ---------- 给 App 原生界面调用的接口 ----------
function __gcLoad(dataUrl) {
  return new Promise(function (resolve, reject) {
    var img = new Image();
    img.onload = function () { resolve(img); };
    img.onerror = function () { reject(new Error("图片加载失败")); };
    img.src = dataUrl;
  });
}
function __gcApply(p) {
  if (!p) return;
  ["style", "mainTitle", "subtitle", "issueDate", "price", "scale", "offsetX", "offsetY", "filter", "showTemplate", "forceCustomText"].forEach(function (k) {
    if (p[k] !== undefined) state[k] = p[k];
  });
  if (p.photoMode) {
    state.photoMode = p.photoMode;
    state.photo = p.photoMode === "ai" && state.aiPhoto ? state.aiPhoto : state.originalPhoto;
  }
}
window.gc = {
  styles: function () { return Object.keys(STYLES); },
  setPhoto: async function (kind, dataUrl) {
    var img = await __gcLoad(dataUrl);
    if (kind === "ai") { state.aiPhoto = img; state.photo = img; state.photoMode = "ai"; }
    else { state.originalPhoto = img; state.aiPhoto = null; state.photo = img; state.photoMode = "original"; }
    return true;
  },
  clearAI: function () { state.aiPhoto = null; state.photo = state.originalPhoto; state.photoMode = "original"; return true; },
  render: async function (p) {
    __gcApply(p);
    render();
    try { await document.fonts.ready; } catch (e) {}
    render();
    return canvas.toDataURL("image/jpeg", 0.9);
  },
  // 导出：同一套模板按 k 倍分辨率重画一遍，文字是矢量的所以放大后依然清晰。
  exportCover: async function (p, k) {
    __gcApply(p);
    try { await document.fonts.ready; } catch (e) {}
    var c = document.createElement("canvas");
    c.width = W * k; c.height = H * k;
    var x = c.getContext("2d");
    x.scale(k, k);
    if (state.showTemplate) { var fn = STYLES[state.style]; if (fn) fn(x, state); }
    else { x.fillStyle = "#0a0a0a"; x.fillRect(0, 0, W, H); drawPhoto(x, { x: 0, y: 0, w: W, h: H }, state.photo, "contain"); }
    return c.toDataURL("image/jpeg", 0.95);
  },
  prompt: function (task, noText) {
    return sanitizeGenerationPrompt(noText ? buildCoverPhotoPromptFromWebTask(task) : buildCoverPromptFromWebTask(task));
  },
  randomText: function (style) {
    var p = PRESETS[style];
    if (!p) return null;
    return { title: p.titles[Math.floor(Math.random() * p.titles.length)], sub: p.subs[Math.floor(Math.random() * p.subs.length)] };
  },
};


// ============ 摄影棚引擎（取自网站 studio.js，放在独立作用域里避免和封面引擎重名） ============
window.gcStudio = (function () {
  // 14 位摄影大师
  const PHOTO_SCHOOLS_PROMPTS = {
    newton:
      " === PHOTOGRAPHY STYLE: Helmut Newton aesthetic === Shoot in the style of Helmut Newton: high-contrast black-and-white photography, theatrical glamour with edgy provocative tension, dramatic chiaroscuro lighting with hard shadows, polished mid-century glamour, often featuring strong powerful poses, urban or hotel interior settings, refined elegance with subversive edge. Render in black-and-white with bold contrast.",
    avedon:
      " === PHOTOGRAPHY STYLE: Richard Avedon aesthetic === Shoot in the style of Richard Avedon: minimalist seamless white or pale grey background, stark studio lighting that reveals every detail, the subject isolated against pure white, intimate intense portrait photography, refined elegant simplicity, often black-and-white or muted tones, focus entirely on the subject with no environmental distractions.",
    lindbergh:
      " === PHOTOGRAPHY STYLE: Peter Lindbergh aesthetic === Shoot in the style of Peter Lindbergh: 'anti-glamour' naturalist black-and-white photography, minimal/no retouching ethos showing authentic skin and natural beauty, soft natural daylight, intimate candid feel, the subject in casual unstudied poses, raw emotional honesty, often with wind-tousled hair and minimal makeup, classic film grain quality.",
    leibovitz:
      " === PHOTOGRAPHY STYLE: Annie Leibovitz aesthetic === Shoot in the style of Annie Leibovitz: theatrical narrative portrait photography, elaborate conceptual staging that tells a story, dramatic cinematic lighting (often with strong direction and color gels), the subject in an elaborate environment or scenario, painterly composition, celebrity-portrait-grandeur quality, rich vibrant colors with deep shadows.",
    klein:
      " === PHOTOGRAPHY STYLE: Steven Klein aesthetic === Shoot in the style of Steven Klein: dark, moody, conceptual fashion photography with provocative undertones, high-contrast cinematic lighting (often single source, strong shadow), psychological intensity, edgy avant-garde styling, deep saturated dark color palette, atmospheric mysterious mood, theatrical fashion-as-art quality.",
    lachapelle:
      " === PHOTOGRAPHY STYLE: David LaChapelle aesthetic === Shoot in the style of David LaChapelle: hyper-saturated pop-surreal photography, candy-bright colors with absurdly maximalist staging, religious/mythological iconography mixed with pop culture, exaggerated theatrical compositions, often with elaborate props and impossible scenarios, kitsch-meets-art-history sensibility, glossy hyperreal quality.",
    walker:
      " === PHOTOGRAPHY STYLE: Tim Walker aesthetic === Shoot in the style of Tim Walker: whimsical fairy-tale fantasy photography, elaborate handcrafted set design with oversized props (giant flowers, vintage objects, fantastical creatures), painterly soft color palette, British eccentric romanticism, the subject placed in a dreamlike storybook environment, magical childhood-imagination atmosphere.",
    knight:
      " === PHOTOGRAPHY STYLE: Nick Knight aesthetic === Shoot in the style of Nick Knight: experimental forward-thinking fashion photography, digital manipulation and 3D imagery integration, bold avant-garde compositions, futuristic styling, vivid colors with experimental texture, fashion-as-art innovation, often with motion blur or digital effects, conceptual cutting-edge feel.",
    mertmarcus:
      " === PHOTOGRAPHY STYLE: Mert & Marcus aesthetic === Shoot in the style of Mert and Marcus: hyper-glossy contemporary glamour, ultra-polished surface quality, vibrant saturated colors with extreme color grading, intense beauty-retouch finish, sleek glossy studio look with dramatic colored backgrounds, contemporary high-fashion glamour at maximum intensity.",
    testino:
      " === PHOTOGRAPHY STYLE: Mario Testino aesthetic === Shoot in the style of Mario Testino: vibrant joyful celebrity photography, intimate-access glamour with a warm friendly quality, bright sunny color palette, the subject genuinely smiling or laughing, breezy effortless luxury, often outdoor/sunset settings, accessible-yet-aspirational quality, warm golden tones.",
    demarchelier:
      " === PHOTOGRAPHY STYLE: Patrick Demarchelier aesthetic === Shoot in the style of Patrick Demarchelier: refined classic-elegance fashion photography, timeless feminine grace, soft beautiful lighting, often black-and-white or sepia tones, the subject in poised classical poses, refined understated luxury, gentle warmth.",
    inezvinoodh:
      " === PHOTOGRAPHY STYLE: Inez & Vinoodh aesthetic === Shoot in the style of Inez and Vinoodh: clean editorial fashion photography, body-as-canvas aesthetic with painted-on elements or graphic body styling, often pure white or solid colored backgrounds, precise refined composition, contemporary art-meets-fashion quality, sleek minimalist directness.",
    weber:
      " === PHOTOGRAPHY STYLE: Bruce Weber aesthetic === Shoot in the style of Bruce Weber: All-American sun-drenched photography, athletic healthy youthful subjects, often black-and-white or warm sepia tones, outdoor natural settings (beach, ranch, summer house), nostalgic Americana feel, classic preppy aesthetic, golden hour warmth, intimate brotherly/family quality.",
    teller:
      " === PHOTOGRAPHY STYLE: Juergen Teller aesthetic === Shoot in the style of Juergen Teller: raw flash-on-camera documentary photography, anti-glamour casual aesthetic, intentionally unposed-feeling moments, harsh on-camera flash creating shadows, indie/grunge mood, no retouching ethos, sometimes humorous or awkward composition, authentic snapshot feel.",

    // ===== 日本摄影大师 =====
    ninagawa:
      " === PHOTOGRAPHY STYLE: Mika Ninagawa (蜷川实花) aesthetic === Shoot in the style of Mika Ninagawa: hyper-saturated vivid candy-bright colors, lush floral overload (cherry blossoms, peonies, hydrangeas, lilies engulfing the frame), goldfish swimming, neon-pink and electric-blue palettes, Japanese feminine maximalist visual feast, surreal dreamlike composition, the subject submerged in flowers or surrounded by colorful kitsch elements, glossy hyperreal Japanese pop-art quality.",
    okuyama:
      " === PHOTOGRAPHY STYLE: Yoshiyuki Okuyama (奥山由之) aesthetic === Shoot in the style of Yoshiyuki Okuyama: contemporary Japanese youth portrait photography on film, soft natural sunlight through windows, gentle dreamy nostalgic atmosphere, fine 35mm film-grain texture, muted warm pastel color palette, intimate diary-like feel, the subject in candid casual moments, sense of Japanese summer-afternoon stillness, modern J-pop / actress portrait quality.",
    hamada:
      " === PHOTOGRAPHY STYLE: Hideaki Hamada (滨田英明) aesthetic === Shoot in the style of Hideaki Hamada: tender family-life documentary photography, soft warm natural daylight in Japanese domestic spaces, muted earthy color palette, intimate candid family/lifestyle moments, gentle quiet emotion, wooden floors and white-washed Japanese interiors, sense of peaceful Japanese everyday-life poetry, soft skin tones with film-like quality.",
    kawauchi:
      " === PHOTOGRAPHY STYLE: Rinko Kawauchi (川内伦子) aesthetic === Shoot in the style of Rinko Kawauchi: poetic everyday Japanese photography, ethereal soft pastel color palette, dreamy overexposed soft light, intimate quiet observation of small moments and tiny details, delicate fragile atmosphere, square-format-influenced composition, lyrical haiku-like visual sensibility, gentle suspended-moment quality.",
    moriyama:
      " === PHOTOGRAPHY STYLE: Daido Moriyama (森山大道) aesthetic === Shoot in the style of Daido Moriyama: gritty high-contrast black-and-white street photography (are-bure-boke 粗れ・ブレ・ボケ — grainy / blurry / out-of-focus aesthetic), intense black shadows and burnt-out whites, raw urban Tokyo nightlife edge, motion-blurred or off-kilter framing, dramatic film grain, post-war Japanese psychological intensity, Shinjuku stray-dog rough-edged quality.",
    uedashoji:
      " === PHOTOGRAPHY STYLE: Shoji Ueda (植田正治) aesthetic === Shoot in the style of Shoji Ueda: surrealist Japanese 'Ueda-cho' staged photography, the subject placed precisely against vast empty sand-dune or wide-open horizon landscapes, geometric theatrical composition with figures arranged like silent stage actors, monochrome or muted tones, dreamlike absurdity, sense of poetic isolation against minimalist horizon-line backdrop.",
    araki:
      " === PHOTOGRAPHY STYLE: Nobuyoshi Araki (荒木经惟) — sentimental Tokyo aesthetic === Shoot in the style of Nobuyoshi Araki's gentle 'Sentimental Journey' Tokyo-portrait side: intimate diary-like Tokyo street photography, the subject in tender candid moments (sitting in train carriages, lying on tatami, eating noodles, walking neighborhood alleys), warm grainy color film with red/orange tonal warmth, sometimes slightly overcast soft daylight, Tokyo-melancholic atmosphere of love and everyday life, deeply personal Japanese photographic poetry.",
    uedayoshihiko:
      " === PHOTOGRAPHY STYLE: Yoshihiko Ueda (上田义彦) aesthetic === Shoot in the style of Yoshihiko Ueda: refined contemplative Japanese commercial portraiture (famous for Suntory Oolong Tea ad campaigns), minimalist Zen composition, restrained soft directional light revealing form, muted desaturated palette, the subject placed in still meditative pose against simple backdrop, sense of quiet eastern philosophy and contemplative spaciousness, refined emotional restraint.",

    // ===== 港台电影导演 =====
    wongdoyle:
      " === PHOTOGRAPHY STYLE: Wong Kar-wai × Christopher Doyle (王家卫×杜可风) aesthetic === Shoot in the style of Wong Kar-wai films photographed by Christopher Doyle: richly saturated jewel-tone color palette (deep teal-greens, warm oranges, rich crimson reds), neon and warm tungsten lighting bathing the scene, slow-shutter motion-blur trails for atmospheric movement, dense smoke / steam / rain creating cinematic atmosphere, narrow vertical Hong Kong alleyways and crowded interiors, intimate handheld camera close to the subject, fragmented dreamlike framing through windows / curtains / doorways / mirrors, signature romantic-melancholic urban Asian cinema mood reminiscent of In the Mood for Love, Chungking Express, Fallen Angels — heavy 35mm film grain with rich shadow detail.",
    shya:
      " === PHOTOGRAPHY STYLE: Wing Shya (夏永康) aesthetic === Shoot in the style of Wing Shya: cinematic still-from-a-film aesthetic developed from his work as Wong Kar-wai's set photographer, dreamy washed pastel color shifts, soft motion-blur or out-of-focus moments, scratched film grain like an aged 35mm frame, romantic moody atmosphere of Hong Kong urban poetry, blurring boundary between fashion editorial and film stills, light leaks at the edges, the subject feels caught in an emotional movie frame.",
    hou:
      " === PHOTOGRAPHY STYLE: Hou Hsiao-hsien (侯孝贤) aesthetic === Shoot in the style of Hou Hsiao-hsien films: long static observational take, the subject placed naturally in everyday Taiwanese settings (small-town streets, old train stations, family courtyards, traditional Taiwanese tea houses), soft natural daylight or warm tungsten interior light, muted earthy color palette with subtle greens and browns, the camera observing from a respectful patient distance with deep focus, Taiwanese nostalgia and quiet dignity, gentle melancholic mood reminiscent of A City of Sadness, The Assassin, Three Times.",
    yang:
      " === PHOTOGRAPHY STYLE: Edward Yang (杨德昌) aesthetic === Shoot in the style of Edward Yang films: urban Taipei modernist alienation, geometric architectural framing through windows / glass / steel beams / mirrors, the subject reflected or split by reflective surfaces, cool blue-grey color palette with restrained accents, modern office buildings, apartment hallways, glass-walled cafes, sense of contemporary Asian urban isolation and intellectual coolness, classical composed framing, reminiscent of Yi Yi, A Brighter Summer Day, Taipei Story.",
    tsai:
      " === PHOTOGRAPHY STYLE: Tsai Ming-liang (蔡明亮) aesthetic === Shoot in the style of Tsai Ming-liang films: extremely long static composed take, the subject standing or sitting alone in austere desolate urban Asian space (empty corridor, rain-soaked street, abandoned cinema, dim public bathroom, peeling apartment wall), water dripping somewhere, neon flickering, dramatic minimal raking light from one source, profound urban solitude and existential silence, the subject motionless and meditative, reminiscent of Vive L'Amour, The Hole, Goodbye Dragon Inn.",
    anglee:
      " === PHOTOGRAPHY STYLE: Ang Lee (李安) aesthetic === Shoot in the style of Ang Lee films: refined cross-cultural cinematic portrait quality, the subject placed in beautifully composed natural environment or classical Chinese setting (bamboo forest, traditional courtyard, 1940s Shanghai interior, mountain mist), soft natural light with painterly warm-and-cool color balance, deep emotional restraint and refined dignity, classical balanced composition with gentle storytelling atmosphere, reminiscent of Crouching Tiger Hidden Dragon, Lust Caution, Eat Drink Man Woman.",
    kwan:
      " === PHOTOGRAPHY STYLE: Stanley Kwan (关锦鹏) aesthetic === Shoot in the style of Stanley Kwan films: refined feminine cinematic portraiture, soft glowing window light filtering through silk curtains, the subject in elegant qipao or vintage Hong Kong fashion against atmospheric old-Hong-Kong interiors with mahogany furniture / red silk drapes / brass details, deeply emotional restraint and inner intensity, warm amber color palette with rich shadows, reminiscent of Center Stage (阮玲玉), Rouge (胭脂扣), Lan Yu (蓝宇) — refined Cantonese cinematic intimacy.",
  };

  const PHOTOGRAPHER_LABEL = {
    // 西方大师
