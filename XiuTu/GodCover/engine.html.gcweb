      { key: "iphone", label: "iPhone Pro", prompt: "holding a current-generation iPhone Pro in titanium finish" },
      { key: "leica", label: "Leica 相机", prompt: "with a Leica M-series rangefinder camera in the iconic black-leather-and-chrome body" },
      { key: "rimowa", label: "Rimowa 行李箱", prompt: "with a Rimowa iconic grooved aluminum or polycarbonate luggage suitcase" },
    ],
  };

  // 把所有品牌按 key 平展成查找表
  const BRAND_LOOKUP = {};
  Object.values(BRAND_LIBRARY).forEach((cat) => {
    cat.forEach((b) => { BRAND_LOOKUP[b.key] = b; });
  });

  // 男性专属变化池 —— 性别=男时切换到这一套，避免出现"花式手势/twirling/peace-sign"等女性默认动作
  const MALE_VARIATION_POOL = {
    poses: [
      "standing tall confidently with one hand in pocket",
      "arms crossed in firm grounded masculine stance",
      "seated relaxed with elbow resting on knee, hand loose",
      "leaning against a wall with shoulder, one hand in pocket",
      "hand on chin in thoughtful contemplative gesture",
      "adjusting watch / cufflink / collar / tie",
      "walking forward purposefully toward or past camera",
      "hand running through hair in casual masculine gesture",
      "looking up with chin raised in confident stance",
      "looking back over shoulder with serious expression",
      "hands clasped behind back, standing tall and composed",
      "both hands in trouser pockets, broad-shouldered stance",
      "one foot up on a step, ledge, or bench, elbow on knee",
      "holding a drink glass, coffee, phone, briefcase, or umbrella",
      "seated cross-legged in composed masculine posture",
      "leaning casually against a car / motorcycle / railing / bar counter",
      "adjusting glasses with one hand, the other in pocket",
      "subject mid-stride in cinematic walking shot",
      "running hand along the back of his neck in relaxed gesture",
      "standing with hands clasped in front, dignified pose",
    ],
    expressions: [
      "serious neutral direct stare into camera with strong eye contact",
      "subtle confident closed-mouth smile with knowing eyes",
      "pensive serious gaze toward something off-camera",
      "contemplative looking into the far distance",
      "slight knowing smirk with one eyebrow slightly raised",
      "intense focused gaze with furrowed brow",
      "relaxed grounded confident expression",
      "charming closed-mouth gentle smile",
      "looking down with eyes momentarily closed in thought",
      "candid genuine open laugh caught in the moment",
      "cool composed deadpan stare",
      "determined commanding stare with set jaw",
      "subtle warm smile with eyes softly squinting",
      "thoughtful introspective expression with relaxed mouth",
      "stoic dignified expression with composed jawline",
    ],
    moods: [
      "confident and powerful",
      "sophisticated and refined",
      "intense and focused",
      "relaxed and grounded",
      "mysterious and brooding",
      "warm and approachable",
      "cool and effortless masculine",
      "contemplative and introspective",
      "charismatic and magnetic",
      "quiet inner strength",
      "edgy rebellious masculine",
      "stoic dignified masculine",
    ],
  };

  function pickRandom(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  // 生成 N 个 shot 变化，景别按审美权重分配 + 姿势/表情/心情不重复
  // gender 控制使用哪套姿势/表情池：male 用男性专属池，其他用通用池
  function buildShotVariations(n, gender) {
    const pool = gender === "male" ? MALE_VARIATION_POOL : VARIATION_POOL;

    // Step 1: 构造景别"排片表"
    // 比例大约为：近景 20%，中景 30%，全身 30%，环境远景 20%，极端特写 0%。
    // 近景保留完整头肩肖像；只禁止眼睛/嘴唇/额头这种无意义局部裁切。
    const distanceKeys = [
      "closeup", "closeup",
      "medium", "medium", "medium",
      "full_body", "full_body", "full_body",
      "wide", "wide",
    ];
    const framingPlan = [];
    while (framingPlan.length < n) {
      const shuffled = [...distanceKeys].sort(() => Math.random() - 0.5);
      framingPlan.push(...shuffled);
    }
    framingPlan.length = n;

    // Step 2: 在每个位置上抽具体 composition + 不重复的 pose/mood/expression
    const remain = {
      poses: [...pool.poses],
      moods: [...pool.moods],
      expressions: [...pool.expressions],
    };
    function popRandom(arr) {
      if (arr.length === 0) return null;
      const idx = Math.floor(Math.random() * arr.length);
      return arr.splice(idx, 1)[0];
    }

    return framingPlan.map((distKey) => {
      const dist = FRAMING_DISTANCES[distKey];
      const composition = dist.shots[Math.floor(Math.random() * dist.shots.length)];
      return {
        framingKey: distKey,
        framingLabel: dist.label,
        composition,
        pose: popRandom(remain.poses) || pickRandom(pool.poses),
        mood: popRandom(remain.moods) || pickRandom(pool.moods),
        expression: popRandom(remain.expressions) || pickRandom(pool.expressions),
      };
    });
  }

  function buildShotPrompt(shot, idx, total, gender) {
    const maleOverride = gender === "male"
      ? " *** MASCULINE POSE/EXPRESSION HARD CONSTRAINT *** This pose, expression, and body language are explicitly MASCULINE. DO NOT render with feminine body language (no twirling skirts, no cute peace-signs, no playful coy poses, no feminine hand-on-cheek pose, no feminine head-tilt). Render with confident masculine body language, grounded stance, broader shoulders, and masculine facial expression as described below."
      : "";
    return ` === SHOT ${idx + 1} OF ${total} — UNIQUE VARIATION FOR THIS FRAME === This is photo ${idx + 1} of a ${total}-photo set, all featuring the SAME person in the SAME scene wearing the SAME outfit, shot by the same photographer. *** CRITICAL FRAMING DISTANCE OVERRIDE FOR THIS SHOT *** This specific frame MUST be a ${shot.framingLabel}. Do not create meaningless facial-fragment crops: NO isolated eyes-only crop, NO lips-only crop, NO forehead-only crop, NO face cut off by the frame edge. The album uses deliberately varied but useful fashion-editorial framing distances: mostly medium shots, full-body shots, and wide environmental shots, with only occasional complete head-and-shoulders portraits.${maleOverride} SHOT / COMPOSITION (follow exactly): ${shot.composition}. POSE / BODY LANGUAGE: ${shot.pose}. FACIAL EXPRESSION: ${shot.expression}. EMOTIONAL MOOD: ${shot.mood}. The photographer is capturing a different moment from the same shoot. CRITICAL CONSISTENCY: keep the same person's identity, same outfit, same makeup, same scene/location, same photographer's signature aesthetic. ONLY the framing distance, pose, expression, and angle change — like different frames of the same photo session.`;
  }

  // ============================================
  // 场景库（主分类 → 子场景）
  // 每个场景给出一段英文 prompt，由 AI 据此构图
  // ============================================
  const SCENE_LIBRARY = {
    "🇯🇵 日本街拍·东京": {
      shinjuku: { label: "新宿街拍", prompt: "Photographed on the streets of Shinjuku Tokyo — towering neon signs, billboards, crowds of people in business attire, the iconic colorful Kabuki-cho gate visible in soft background bokeh, evening street energy, asphalt and reflective puddles, urban Japan at its most cinematic." },
      kabukicho: { label: "歌舞伎町夜景", prompt: "Photographed in Kabuki-cho Shinjuku — the famous red-themed entertainment district at night, glowing red and pink Japanese neon signs in soft bokeh, vibrant nightlife energy, narrow alleys lined with izakaya and host clubs, atmospheric film-noir Tokyo." },
