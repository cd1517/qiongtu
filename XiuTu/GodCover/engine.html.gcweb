// ============================================
// 主渲染函数
// ============================================
function render() {
  ctx.clearRect(0, 0, W, H);
  if (state.showTemplate) {
    // 走完整的模板渲染流程（cover 模式让照片填满）
    const drawFn = STYLES[state.style];
    if (drawFn) drawFn(ctx, state);
  } else {
    // 关闭模板：用 contain 模式完整显示 AI 生成的图（避免边缘被裁掉）
    // 先填一层深色背景作为可能的边条
    ctx.fillStyle = "#0a0a0a";
    ctx.fillRect(0, 0, W, H);
    drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, state.photo, "contain");
  }
}



