  drawCoverline(ctx, "あの人気者の素顔", 25, 432, { font: "900 18px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "現場直撃 PHOTO", 25, 462, { font: "700 13px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "今週の事件簿", 25, 525, { font: "900 18px 'Shippori Mincho B1'", color: "#e30613" });
  drawCoverline(ctx, "TOP 5 SCOOPS THIS WEEK", 25, 552, { font: "700 11px Inter", color: "#fff" });
  ctx.shadowBlur = 0;

  // 底部红黑大标题
  const bg = ctx.createLinearGradient(0, H - 220, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 220, W, 220);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#e30613";
