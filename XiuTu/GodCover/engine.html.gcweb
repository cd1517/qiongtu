  drawCoverline(ctx, "&  BEAUTY  BOOK", 25, 308, { font: "700 12px Inter", color: "#fff" });
  drawCoverline(ctx, "大学生最旬コーデ全集", 25, 335, { font: "500 12px 'Noto Sans JP'", color: "#fff" });

  // 右下小标签
  drawCoverline(ctx, "巻頭スペシャル", W - 25, 410, { font: "italic 700 16px 'DM Serif Display'", color: "#fff", align: "right" });
  drawCoverline(ctx, "100 LOOKS", W - 25, 432, { font: "900 14px Inter", color: "#fff", align: "right" });
  ctx.shadowBlur = 0;

  // 底部主标题
  ctx.fillStyle = "#fafafa";
