};

// 本期变化池：每次生成时随机抽取，让同一杂志的不同期号有不同的拍摄方向
// 重点：只变"照片本身"的姿势/服装/背景/氛围，不动品牌字标和签名色
const VARIATION_POOL = {
  poses: [
    "standing confidently with hand on hip or in pocket",
    "seated in a relaxed pose on a chair or floor",
    "leaning casually against a wall, doorway, or surface",
    "in mid-motion walking or turning",
    "hand near face or chin in a thoughtful gesture",
    "arms crossed in confident pose",
    "playful peace-sign, wink, or hand-pose",
    "looking up with raised chin",
    "looking down or with eyes closed",
    "natural laughing or smiling moment",
    "hand running through hair",
    "subject in dynamic action or jumping",
  ],
  // 镜头构图/景别/角度：把"正面大头照"霸权打破
  compositions: [
    "head-and-shoulders close-up facing the camera directly with intense eye contact",
    "head-and-shoulders close-up with face turned 3/4 away from camera, eyes glancing toward us",
    "tight extreme close-up focused on just the eyes — graphic and intimate",
    "tight extreme close-up on the lips, hands, or other facial/body details only",
    "half-body framing showing torso and outfit details",
    "full-body framing showing the subject's complete silhouette in the environment",
    "wide cinematic shot where the subject occupies only a small part of a vast atmospheric landscape — figure dwarfed by the setting",
    "pure side profile classical view — face shown in clean profile silhouette",
    "back view — subject seen entirely from behind, looking away into the scene",
    "over-the-shoulder shot from behind the subject's shoulder, looking outward at the scene",
    "subject looking back over their shoulder toward the camera",
    "dramatic silhouette of the subject against strong backlight — graphic outline only",
    "low-angle hero shot — camera positioned below subject, looking up dramatically",
    "high-angle intimate shot — camera positioned above subject, looking down",
    "asymmetric off-center composition with significant negative space on one side",
    "face partially obscured by hair, hand, shadow, an object, smoke, or veil — mysterious and intriguing",
    "subject viewed through window, mirror, fogged glass, or reflection — atmospheric layered framing",
    "motion-blur shot where the subject is in slight motion while environment slightly blurred — cinematic energy",
  ],
  outfits: [
    "casual streetwear with statement accessories",
    "elegant formal outfit with refined sophisticated details",
    "trendy fashion-forward look with bold patterns and textures",
    "minimalist chic outfit in neutral monochrome tones",
    "vibrant colorful outfit with playful eye-catching styling",
    "sporty athleisure with modern athletic wear",
    "vintage-inspired retro fashion (70s, 80s, or 90s influence)",
    "dressy glamorous evening attire",
    "denim-heavy casual cool styling",
    "layered seasonal outfit (knitwear, scarves, coats)",
  ],
  backgrounds: [
    "clean white minimalist studio backdrop",
    "vibrant solid color studio backdrop (could be sky blue, deep red, mustard yellow, or forest green)",
    "soft gradient pastel background (peach to lavender, etc.)",
    "urban Tokyo street scene at twilight with city lights",
    "modern architectural interior with clean geometric lines",
    "outdoor natural setting (park, garden, beach, or forest)",
    "abstract artistic backdrop with creative directional lighting",
    "atmospheric night scene with bokeh lights and warm glow",
    "fashion editorial lit setting with strong directional shadows",
    "industrial loft or warehouse with raw textured walls",
    "sunny rooftop or terrace with sky and clouds",
  ],
  moods: [
    "confident and powerful",
    "playful and cheerful",
    "edgy and rebellious",
    "sophisticated and refined",
    "dreamy and ethereal",
    "energetic and joyful",
    "mysterious and intriguing",
    "soft tender feminine",
    "cool and effortlessly aloof",
    "warm and approachable",
  ],
  lightings: [
    "soft natural daylight from a large window",
    "dramatic high-contrast directional lighting with strong shadows",
    "golden hour warm sunset lighting",
    "cool blue-toned evening lighting",
    "vibrant colorful gelled studio lighting",
    "flat even beauty-shot lighting",
    "moody low-key lighting with deep shadows",
    "bright airy high-key lighting",
  ],
  // 标题位置：12 种放置策略，打破"标题永远在下 1/3"的固化
  titlePositions: [
    "TITLE placed prominently at the BOTTOM 1/3 of the cover (classic Hollywood/magazine placement)",
    "TITLE placed prominently at the TOP of the cover (gives a 'cover-story' / 'big-news' feel like a tabloid)",
    "TITLE CENTERED in the middle of the cover, large and overlapping with the subject for dramatic effect",
    "TITLE arranged VERTICALLY along the LEFT or RIGHT side of the cover (Vogue-style vertical title)",
    "TITLE SPLIT across the cover — part at top, part at bottom — sandwiching the photo in the middle",
    "TITLE positioned BEHIND the subject — the subject's hair/head partially obscures parts of the title for layered depth (Vogue 'masked logo' technique)",
    "TITLE in a SMALL CORNER (upper-right or lower-left) as a subtle accent, with the photo dominating most of the frame (A24 arthouse minimal style)",
    "TITLE WRAPPED AROUND the subject — curving text or text positioned to follow the subject's silhouette",
    "TITLE MASSIVE and FULL-WIDTH, dominating the upper or lower half as a major graphic element (Tarantino / Quentin Dupieux style)",
    "TITLE SCATTERED across multiple positions with each word at a different size and angle for typographic drama",
    "TITLE in clean NEGATIVE SPACE beside the subject — asymmetric composition with subject on one side, title in the empty space on the other",
    "TITLE in the FOREGROUND large and prominent with the subject smaller in the background — text-led design",
  ],
  layouts: [
    "standard editorial layout (wordmark prominent at top, full coverline arrangement as described in the style instructions)",
    "subject-dominant layout — the wordmark is partially overlapping with the subject's hair or shoulder, integrated cinematically into the composition like a VOGUE 'masked logo' cover",
    "minimalist editorial layout — large clean photo dominates with very few coverlines, lots of breathing room, almost art-poster feel",
    "maximalist energetic layout — extra dense coverlines, multiple tilted sticker badges and small text everywhere, busy newsstand-pop energy",
    "special anniversary edition look — incorporate gold or silver foil-stamp accents and an 'ANNIVERSARY ISSUE' or 'SPECIAL EDITION' subtitle near the wordmark",
    "alternate wordmark color/finish — use a metallic, gradient, neon, or seasonal-themed color treatment for the wordmark while keeping it recognizable as the same brand",
    "wordmark slightly displaced — at the side, at an angle, or rotated rather than the standard top-center position, for editorial drama",
    "bold experimental typography — oversized text treatment where the title is enlarged and integrated into the photo composition (could intersect with the subject)",
    "seasonal special edition — incorporate seasonal motifs (sakura petals, falling snow, summer beach elements, autumn leaves, neon nightlife accents) tied to the season",
    "asymmetric split-cover layout — wordmark and coverlines arranged in a split or asymmetric composition, with sparse left/dense right or top/bottom split for drama",
    "vintage/nostalgic edition — slightly aged film-grain texture, retro print imperfections, vintage color treatment over the layout while keeping wordmark recognizable",
    "high-fashion editorial poster style — minimal text, large photo, wordmark in unexpected size or alternate font weight for artistic effect",
  ],
};

function pickRandom(arr) {
  return arr[Math.floor(Math.random() * arr.length)];
}

function buildVariationPrompt() {
  // 给每期一个独立的拍摄方向 + 排版变化组合（通用：杂志和电影海报都适用）
  // 关键：CAMERA COMPOSITION + TITLE PLACEMENT 维度打破默认套路
  return ` === THIS COVER'S UNIQUE DIRECTION (vary between issues / posters for variety) === For this specific cover, vary multiple dimensions: CAMERA COMPOSITION / SHOT TYPE: ${pickRandom(VARIATION_POOL.compositions)}. PHOTO POSE / BODY LANGUAGE: ${pickRandom(VARIATION_POOL.poses)}. TITLE/WORDMARK PLACEMENT (where the main title sits on the design): ${pickRandom(VARIATION_POOL.titlePositions)}. OUTFIT/COSTUME: ${pickRandom(VARIATION_POOL.outfits)}. BACKGROUND/SETTING: ${pickRandom(VARIATION_POOL.backgrounds)}. LIGHTING: ${pickRandom(VARIATION_POOL.lightings)}. MOOD: ${pickRandom(VARIATION_POOL.moods)}. LAYOUT TREATMENT: ${pickRandom(VARIATION_POOL.layouts)}. CRITICAL: do NOT always put a frontal close-up face in the center with title at the bottom 1/3 — that is the boring default. Embrace the chosen composition AND title placement above as a deliberate design choice, even if it's unconventional (silhouette, back view, side profile, partial face, wide environmental shot; title at top, side, center, scattered, or behind subject). Real magazine covers and movie posters are designed by different art directors who break convention to express meaning. BRAND/TITLE IDENTITY CONSTRAINT: keep the main title text (whether it's a magazine wordmark or a movie title) and the overall signature color palette clearly recognizable as the publication/film described in the style instructions above — but the title's POSITION/SIZE/TREATMENT may vary radically. Embrace this designer-driven variability.`;
}

function buildBrandLockPrompt(style) {
  const locks = {
    kogyaru:
      " === STRICT MAGAZINE TITLE LOCK === The main magazine masthead MUST read exactly 'KOGYARU'. It must be the largest and most prominent wordmark on the cover, placed across the top area or upper-left area in bold yellow/orange letters with a black outline. Do NOT replace the masthead with 'I CAN HUSTLE' or any other phrase. 'I CAN HUSTLE' is only a small secondary tagline, never the title. The generated cover is invalid if 'KOGYARU' is missing, tiny, hidden, or only appears as a small sticker.",
    happienuts:
      " === STRICT MAGAZINE TITLE LOCK === The main magazine masthead MUST read exactly 'nuts' with a small 'Happie' subtitle. The 'nuts' masthead must be the largest and most prominent title on the cover. Do NOT replace it with a coverline or slogan.",
    jkegg:
      " === STRICT MAGAZINE TITLE LOCK === The main magazine masthead MUST read exactly 'JKeGG'. It must be the largest pink bubble wordmark on the cover. Do NOT replace it with a coverline, slogan, or badge text.",
    cosmake:
      " === STRICT MAGAZINE TITLE LOCK === The main magazine masthead MUST read exactly 'コスプレ MAKE'. It must be the largest title on the cover. Do NOT replace it with a tutorial coverline or slogan.",
    cosplaymode:
      " === STRICT MAGAZINE TITLE LOCK === The main magazine masthead MUST read exactly 'COSPLAY MODE'. It must be the largest title on the cover. Do NOT replace it with any badge, coverline, or subtitle.",
  };
  return locks[style] || "";
}

function buildStyleSpecificVariationGuard(style) {
  const guards = {
    jkegg:
      " === JKeGG LAYOUT GUARD === Ignore any variation instruction that asks for a minimalist layout, very few coverlines, or an art-poster feel. JKeGG must remain a dense maximalist Japanese magazine cover with many decorative coverlines, stickers, badges, sparkles, barcode/details, and a large readable 'JKeGG' masthead.",
    kogyaru:
      " === KOGYARU LAYOUT GUARD === Keep KOGYARU as a maximalist Y2K Japanese magazine cover with dense coverlines and the large readable KOGYARU masthead. Do not make the design minimalist or poster-like.",
  };
  return guards[style] || "";
}

// ============================================
// 工具函数
// ============================================

// 画出经过滤镜处理的照片（覆盖整个画布或指定区域）
// fitMode: "cover" = 填满画布并裁切（模板叠加时用）
//          "contain" = 完整显示，可能有边条（AI 模式看完整封面时用）
function drawPhoto(ctx, area, photo, fitMode = "cover") {
  if (!photo) {
    // 没有上传照片时：画一个深灰色背景 + 占位文字
    ctx.fillStyle = "#1a1a1a";
    ctx.fillRect(area.x, area.y, area.w, area.h);
    ctx.fillStyle = "rgba(255,255,255,0.15)";
    ctx.font = "300 16px Inter";
    ctx.textAlign = "center";
    ctx.fillText("上传照片以查看效果", area.x + area.w / 2, area.y + area.h / 2);
    return;
  }

  // 计算照片缩放
  const photoRatio = photo.width / photo.height;
  const areaRatio = area.w / area.h;
  let drawW, drawH;

  if (fitMode === "contain") {
    // contain 模式：整张图完整装进 area，可能留边条
    if (photoRatio > areaRatio) {
      // 图更宽，按宽度贴边
      drawW = area.w * state.scale;
      drawH = drawW / photoRatio;
    } else {
      // 图更高，按高度贴边
      drawH = area.h * state.scale;
      drawW = drawH * photoRatio;
    }
  } else {
    // cover 模式（默认）：填满 area，超出部分被剪
    if (photoRatio > areaRatio) {
      drawH = area.h * state.scale;
      drawW = drawH * photoRatio;
    } else {
      drawW = area.w * state.scale;
      drawH = drawW / photoRatio;
    }
  }
  const drawX = area.x + (area.w - drawW) / 2 + state.offsetX;
  const drawY = area.y + (area.h - drawH) / 2 + state.offsetY;

  // 应用滤镜
  ctx.save();
  ctx.beginPath();
  ctx.rect(area.x, area.y, area.w, area.h);
  ctx.clip();
  ctx.filter = getFilterString(state.filter);
  ctx.drawImage(photo, drawX, drawY, drawW, drawH);
  ctx.filter = "none";
  ctx.restore();
}

function getFilterString(name) {
  switch (name) {
    case "bw":       return "grayscale(1) contrast(1.1)";
    case "vintage":  return "sepia(0.4) contrast(1.05) saturate(0.85)";
    case "contrast": return "contrast(1.3) saturate(1.2)";
    case "warm":     return "saturate(1.15) hue-rotate(-10deg) brightness(1.05)";
    case "cool":     return "saturate(1.1) hue-rotate(15deg) brightness(0.95)";
    default:         return "none";
  }
}

// 画简单的条形码（杂志封面的标志性元素）
function drawBarcode(ctx, x, y, w, h) {
  ctx.fillStyle = "#fff";
  ctx.fillRect(x - 4, y - 4, w + 8, h + 8);
  ctx.fillStyle = "#000";
  let cx = x;
  while (cx < x + w) {
    const barW = 1 + Math.floor(Math.random() * 3);
    if (Math.random() > 0.3) ctx.fillRect(cx, y, barW, h);
    cx += barW + 1;
  }
}

// 画一行带颜色装饰的小标题（VOGUE 经常用）
function drawCoverline(ctx, text, x, y, opts = {}) {
  const { font = "700 14px Inter", color = "#fff", bg = null, align = "left" } = opts;
  ctx.font = font;
  ctx.textAlign = align;
  ctx.textBaseline = "top";
  if (bg) {
    const metrics = ctx.measureText(text);
    const tw = metrics.width;
    const padX = 6, padY = 4;
    let bgX = x;
    if (align === "center") bgX = x - tw / 2;
    if (align === "right")  bgX = x - tw;
    ctx.fillStyle = bg;
    ctx.fillRect(bgX - padX, y - padY, tw + padX * 2, 22);
  }
  ctx.fillStyle = color;
  ctx.fillText(text, x, y);
}

// ============================================
// 风格 1: VOGUE 风
// 特征：超大衬线 wordmark、左右两侧 coverlines、白底为主
// ============================================
function drawVogue(ctx, opts) {
  // 照片铺满整个画布
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部轻微暗化，让 wordmark 更突出
  const grad = ctx.createLinearGradient(0, 0, 0, 200);
  grad.addColorStop(0, "rgba(0,0,0,0.35)");
  grad.addColorStop(1, "rgba(0,0,0,0)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, 200);

  // VOGUE 大标题
  ctx.fillStyle = "#fff";
  ctx.font = "900 130px 'Playfair Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("VOGUE", W / 2, 30);

  // 顶部期号和价格
  ctx.font = "600 13px Inter";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate, 30, 30);
  ctx.textAlign = "right";
  ctx.fillText(opts.price, W - 30, 30);

  // 左侧 coverlines
  const lineColor = "#fff";
  ctx.shadowColor = "rgba(0,0,0,0.6)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "FASHION", 30, 220, { font: "900 28px 'Playfair Display'", color: "#ff3a3a" });
  drawCoverline(ctx, "FORWARD", 30, 252, { font: "900 28px 'Playfair Display'", color: "#fff" });
  drawCoverline(ctx, "100+ 春夏新造型", 30, 295, { font: "500 13px 'Noto Serif SC'", color: lineColor });
  drawCoverline(ctx, "顶级造型师私藏建议", 30, 318, { font: "500 13px 'Noto Serif SC'", color: lineColor });

  // 右侧 coverlines
  drawCoverline(ctx, "BEAUTY", W - 30, 400, { font: "900 24px 'Playfair Display'", color: "#fff", align: "right" });
  drawCoverline(ctx, "ICONS", W - 30, 428, { font: "900 24px 'Playfair Display'", color: "#ff3a3a", align: "right" });
  drawCoverline(ctx, "本季最值得入手的", W - 30, 470, { font: "500 13px 'Noto Serif SC'", color: lineColor, align: "right" });
  drawCoverline(ctx, "10 件单品", W - 30, 493, { font: "500 13px 'Noto Serif SC'", color: lineColor, align: "right" });
  ctx.shadowBlur = 0;

  // 底部大标题（主 coverline）
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 12;
  ctx.fillStyle = "#fff";
  ctx.font = "900 56px 'Playfair Display'";
  ctx.textAlign = "center";
  ctx.fillText(opts.mainTitle, W / 2, H - 180);

  ctx.font = "500 16px 'Noto Serif SC'";
  ctx.fillText(opts.subtitle, W / 2, H - 110);
  ctx.shadowBlur = 0;

  // 条形码
  drawBarcode(ctx, W - 100, H - 50, 70, 28);
}

// ============================================
// 风格 2: TIME 风
// 特征：红色粗边框、TIME wordmark、人物 + 大标题
// ============================================
function drawTime(ctx, opts) {
  // 红色边框
  const border = 22;
  ctx.fillStyle = "#cc0000";
  ctx.fillRect(0, 0, W, H);

  // 内部照片
  drawPhoto(ctx, { x: border, y: border, w: W - border * 2, h: H - border * 2 }, opts.photo);

  // 顶部黑色渐变让 TIME 字突出
  const grad = ctx.createLinearGradient(0, 0, 0, 180);
  grad.addColorStop(0, "rgba(0,0,0,0.5)");
  grad.addColorStop(1, "rgba(0,0,0,0)");
  ctx.fillStyle = grad;
  ctx.fillRect(border, border, W - border * 2, 180);

  // TIME wordmark
  ctx.fillStyle = "#fff";
  ctx.font = "900 90px 'Playfair Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("TIME", W / 2, 50);

  // 顶部小字
  ctx.font = "600 11px Inter";
  ctx.fillStyle = "rgba(255,255,255,0.9)";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate.toUpperCase() + "  |  TIME.COM", border + 16, 48);
  ctx.textAlign = "right";
  ctx.fillText(opts.price, W - border - 16, 48);

  // 底部大标题
  const bottomBoxH = 240;
  const grad2 = ctx.createLinearGradient(0, H - bottomBoxH, 0, H);
  grad2.addColorStop(0, "rgba(0,0,0,0)");
  grad2.addColorStop(1, "rgba(0,0,0,0.85)");
  ctx.fillStyle = grad2;
  ctx.fillRect(border, H - bottomBoxH - border, W - border * 2, bottomBoxH);

  ctx.fillStyle = "#fff";
  ctx.font = "900 62px 'Playfair Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "bottom";
  ctx.fillText(opts.mainTitle, W / 2, H - 110);

  ctx.font = "italic 500 18px 'Playfair Display'";
  ctx.fillStyle = "#ffcc00";
  ctx.fillText(opts.subtitle, W / 2, H - 70);
}

// ============================================
// 风格 3: GQ 风
// 特征：粗壮无衬线、对比强烈、时髦
// ============================================
function drawGq(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部白色块
  ctx.fillStyle = "rgba(0,0,0,0.5)";
  ctx.fillRect(0, 0, W, 130);

  // GQ wordmark - 超大
  ctx.fillStyle = "#fff";
  ctx.font = "700 120px 'Bebas Neue'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("GQ", 30, 15);

  // 副文字
  ctx.font = "600 12px Inter";
  ctx.fillStyle = "rgba(255,255,255,0.85)";
  ctx.fillText("GENTLEMEN'S QUARTERLY · " + opts.issueDate, 200, 40);
  ctx.fillText("THE STYLE BIBLE FOR MEN", 200, 60);
  ctx.font = "700 14px Inter";
  ctx.fillStyle = "#ffcc00";
  ctx.fillText("MAN OF THE YEAR", 200, 85);

  // 右侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  drawCoverline(ctx, "STYLE", W - 30, 250, { font: "700 32px 'Bebas Neue'", color: "#ffcc00", align: "right" });
  drawCoverline(ctx, "GUIDE 2026", W - 30, 285, { font: "700 32px 'Bebas Neue'", color: "#fff", align: "right" });
  drawCoverline(ctx, "本年度最值得拥有的", W - 30, 330, { font: "500 12px 'Noto Serif SC'", color: "#fff", align: "right" });
  drawCoverline(ctx, "50 件男士单品", W - 30, 350, { font: "500 12px 'Noto Serif SC'", color: "#fff", align: "right" });

  drawCoverline(ctx, "INSIDE", W - 30, 430, { font: "700 28px 'Bebas Neue'", color: "#fff", align: "right" });
  drawCoverline(ctx, "顶级私人订制的世界", W - 30, 465, { font: "500 12px 'Noto Serif SC'", color: "#fff", align: "right" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const grad = ctx.createLinearGradient(0, H - 280, 0, H);
  grad.addColorStop(0, "rgba(0,0,0,0)");
  grad.addColorStop(1, "rgba(0,0,0,0.85)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, H - 280, W, 280);

  ctx.fillStyle = "#fff";
  ctx.font = "700 64px 'Bebas Neue'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText(opts.mainTitle, 30, H - 100);

  ctx.font = "500 16px 'Noto Serif SC'";
  ctx.fillStyle = "rgba(255,255,255,0.8)";
  ctx.fillText(opts.subtitle, 30, H - 65);
}

// ============================================
// 风格 4: Sports Illustrated 风
// 特征：动感斜体、运动感、品牌色蓝白
// ============================================
function drawSports(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部红色横条
  ctx.fillStyle = "#e30613";
  ctx.fillRect(0, 0, W, 80);

  // 标题
  ctx.fillStyle = "#fff";
  ctx.font = "italic 800 50px 'Oswald'";
  ctx.textAlign = "left";
  ctx.textBaseline = "middle";
  ctx.fillText("SPORTS ILLUSTRATED", 25, 40);

  // 副信息
  ctx.font = "600 11px Inter";
  ctx.textAlign = "right";
  ctx.fillText(opts.issueDate + "  ·  " + opts.price, W - 25, 40);

  // 中间的"主角光环"标语
  ctx.shadowColor = "rgba(0,0,0,0.8)";
  ctx.shadowBlur = 10;
  ctx.fillStyle = "#ffcc00";
  ctx.font = "italic 800 40px 'Oswald'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("ATHLETE", 30, 130);
  ctx.fillStyle = "#fff";
  ctx.fillText("OF THE YEAR", 30, 175);

  // 主标题（人名感）
  const grad = ctx.createLinearGradient(0, H - 320, 0, H);
  grad.addColorStop(0, "rgba(0,0,0,0)");
  grad.addColorStop(1, "rgba(0,0,0,0.9)");
  ctx.fillStyle = grad;
  ctx.shadowBlur = 0;
  ctx.fillRect(0, H - 320, W, 320);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 80px 'Oswald'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText(opts.mainTitle, 30, H - 90);

  ctx.font = "italic 600 18px 'Oswald'";
  ctx.fillStyle = "#ffcc00";
  ctx.fillText(opts.subtitle.toUpperCase(), 30, H - 50);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 5: Rolling Stone 风
// 特征：红色粗体衬线 wordmark、摇滚感、暗色调
// ============================================
function drawRollingStone(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部暗化
  const grad = ctx.createLinearGradient(0, 0, 0, 180);
  grad.addColorStop(0, "rgba(0,0,0,0.55)");
  grad.addColorStop(1, "rgba(0,0,0,0)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, 180);

  // Rolling Stone 红色 wordmark（手写斜体衬线）
  ctx.fillStyle = "#e02020";
  ctx.font = "italic 900 84px 'Playfair Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("Rolling Stone", W / 2, 30);

  // 顶部小字
  ctx.font = "600 11px Inter";
  ctx.fillStyle = "rgba(255,255,255,0.85)";
  ctx.textAlign = "left";
  ctx.fillText("ISSUE No.1474  ·  " + opts.issueDate, 30, 130);
  ctx.textAlign = "right";
  ctx.fillText("ROLLINGSTONE.COM  ·  " + opts.price, W - 30, 130);

  // 左侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  drawCoverline(ctx, "EXCLUSIVE", 30, 240, { font: "italic 800 18px 'Playfair Display'", color: "#e02020" });
  drawCoverline(ctx, "THE MAKING OF", 30, 268, { font: "800 22px 'Anton'", color: "#fff" });
  drawCoverline(ctx, "AN ICON", 30, 295, { font: "800 22px 'Anton'", color: "#fff" });
  drawCoverline(ctx, "幕后那些没人告诉你的事", 30, 330, { font: "500 12px 'Noto Serif SC'", color: "#fff" });

  // 右侧 coverlines
  drawCoverline(ctx, "100 GREATEST", W - 30, 430, { font: "800 18px 'Anton'", color: "#e02020", align: "right" });
  drawCoverline(ctx, "ALBUMS OF 2026", W - 30, 455, { font: "800 18px 'Anton'", color: "#fff", align: "right" });
  drawCoverline(ctx, "你不能错过的", W - 30, 488, { font: "500 12px 'Noto Serif SC'", color: "#fff", align: "right" });
  drawCoverline(ctx, "年度音乐榜单", W - 30, 508, { font: "500 12px 'Noto Serif SC'", color: "#fff", align: "right" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 300, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.9)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 300, W, 300);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 56px 'Playfair Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("“" + opts.mainTitle + "”", 30, H - 95);

  ctx.font = "italic 500 17px 'Playfair Display'";
  ctx.fillStyle = "#e02020";
  ctx.fillText("— " + opts.subtitle, 30, H - 55);
  ctx.shadowBlur = 0;

  drawBarcode(ctx, W - 100, H - 50, 70, 28);
}

// ============================================
// 风格 6: National Geographic 风
// 特征：标志性黄色矩形粗边框
// ============================================
function drawNatGeo(ctx, opts) {
  // 黄色边框（NatGeo 灵魂）
  ctx.fillStyle = "#ffcc00";
  ctx.fillRect(0, 0, W, H);
  const b = 36;
  drawPhoto(ctx, { x: b, y: b + 60, w: W - b * 2, h: H - (b + 60) - b }, opts.photo);

  // 顶部黄框区域里写 NATIONAL GEOGRAPHIC
  ctx.fillStyle = "#000";
  ctx.font = "700 24px 'Bebas Neue'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("NATIONAL GEOGRAPHIC", W / 2, b + 30);

  // 期号 / 价格
  ctx.font = "600 11px Inter";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate.toUpperCase(), b + 8, b + 30);
  ctx.textAlign = "right";
  ctx.fillText(opts.price, W - b - 8, b + 30);

  // 右侧竖向 coverlines（黄背景白字 / 黑字）
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#fff";
  ctx.font = "700 22px 'Bebas Neue'";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText("EXPLORERS", W - b - 16, b + 80);
  ctx.fillText("OF THE YEAR", W - b - 16, b + 105);

  ctx.font = "500 12px 'Noto Serif SC'";
  ctx.fillText("跨越七大洲的", W - b - 16, b + 140);
  ctx.fillText("年度探险者", W - b - 16, b + 158);
  ctx.shadowBlur = 0;

  // 底部黄色信息条 + 主标题
  const titleBg = ctx.createLinearGradient(0, H - 260, 0, H - b);
  titleBg.addColorStop(0, "rgba(0,0,0,0)");
  titleBg.addColorStop(1, "rgba(0,0,0,0.85)");
  ctx.fillStyle = titleBg;
  ctx.fillRect(b, H - 260, W - b * 2, 260 - b);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 8;
  ctx.fillStyle = "#ffcc00";
  ctx.font = "700 16px 'Bebas Neue'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("COVER STORY", b + 16, H - b - 110);

  ctx.fillStyle = "#fff";
  ctx.font = "900 46px 'Playfair Display'";
  ctx.fillText(opts.mainTitle, b + 16, H - b - 65);

  ctx.font = "500 14px 'Noto Serif SC'";
  ctx.fillStyle = "rgba(255,255,255,0.85)";
  ctx.fillText(opts.subtitle, b + 16, H - b - 35);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 7: Forbes 风
// 特征：粗黑斜体衬线 Forbes 字、商业感、蓝/金色调
// ============================================
function drawForbes(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部白色色块带（Forbes 经典布局）
  ctx.fillStyle = "#fff";
  ctx.fillRect(0, 0, W, 105);

  // Forbes wordmark
  ctx.fillStyle = "#000";
  ctx.font = "italic 900 80px 'Bodoni Moda'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("Forbes", 30, 18);

  // 右上副信息
  ctx.font = "600 11px Inter";
  ctx.fillStyle = "#333";
  ctx.textAlign = "right";
  ctx.fillText(opts.issueDate + "  ·  FORBES.COM", W - 30, 30);
  ctx.fillText(opts.price, W - 30, 50);
  ctx.font = "italic 500 12px 'Playfair Display'";
  ctx.fillStyle = "#c5a046";
  ctx.fillText("CAPITALIST TOOL", W - 30, 75);

  // 顶部金条
  ctx.fillStyle = "#c5a046";
  ctx.fillRect(0, 105, W, 4);

  // 右侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  drawCoverline(ctx, "30 UNDER 30", W - 30, 200, { font: "900 30px 'Playfair Display'", color: "#c5a046", align: "right" });
  drawCoverline(ctx, "ASIA 2026", W - 30, 232, { font: "900 30px 'Playfair Display'", color: "#fff", align: "right" });
  drawCoverline(ctx, "亚洲最具影响力的", W - 30, 273, { font: "500 13px 'Noto Serif SC'", color: "#fff", align: "right" });
  drawCoverline(ctx, "年轻创业者们", W - 30, 295, { font: "500 13px 'Noto Serif SC'", color: "#fff", align: "right" });

  drawCoverline(ctx, "BILLIONAIRES", W - 30, 380, { font: "800 20px 'Playfair Display'", color: "#fff", align: "right" });
  drawCoverline(ctx, "他是怎么做到的？", W - 30, 410, { font: "500 12px 'Noto Serif SC'", color: "#c5a046", align: "right" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 300, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.9)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 300, W, 300);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  ctx.fillStyle = "#c5a046";
  ctx.font = "italic 700 16px 'Playfair Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText("COVER STORY · 封面人物", 30, H - 130);

  ctx.fillStyle = "#fff";
  ctx.font = "900 54px 'Playfair Display'";
  ctx.fillText(opts.mainTitle, 30, H - 75);

  ctx.font = "italic 500 16px 'Playfair Display'";
  ctx.fillStyle = "rgba(255,255,255,0.85)";
  ctx.fillText(opts.subtitle, 30, H - 40);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 8: The New Yorker 风
// 特征：奶白色调、衬线字标、极简、知识分子气
// ============================================
function drawNewYorker(ctx, opts) {
  // 奶白底色
  ctx.fillStyle = "#f3eedb";
  ctx.fillRect(0, 0, W, H);

  // 上方 wordmark 区
  ctx.fillStyle = "#000";
  ctx.font = "italic 900 50px 'Playfair Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("The New Yorker", W / 2, 40);

  // 期号
  ctx.font = "italic 400 13px 'Playfair Display'";
  ctx.fillStyle = "#666";
  ctx.fillText(opts.issueDate + "  ·  " + opts.price, W / 2, 100);

  // 分隔细线
  ctx.strokeStyle = "#000";
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(60, 135);
  ctx.lineTo(W - 60, 135);
  ctx.stroke();

  // 中央照片区（仿插画感）
  drawPhoto(ctx, { x: 60, y: 160, w: W - 120, h: H - 160 - 200 }, opts.photo);

  // 底部主标题（衬线）
  ctx.fillStyle = "#000";
  ctx.font = "italic 700 26px 'Playfair Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("“" + opts.mainTitle + "”", W / 2, H - 170);

  ctx.font = "italic 400 14px 'Playfair Display'";
  ctx.fillStyle = "#555";
  ctx.fillText(opts.subtitle, W / 2, H - 130);

  // 底部署名
  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#888";
  ctx.textAlign = "left";
  ctx.fillText("ILLUSTRATION BY  · 本期画师", 60, H - 60);
  ctx.textAlign = "right";
  ctx.fillText("PRICE  " + opts.price, W - 60, H - 60);

  // 底部 wordmark 小图标（简化处理）
  ctx.font = "italic 700 14px 'Playfair Display'";
  ctx.fillStyle = "#000";
  ctx.textAlign = "center";
  ctx.fillText("· newyorker.com ·", W / 2, H - 35);
}

// ============================================
// 风格 9: Movie Poster 风（电影海报）
// 特征：黑暗大片感、底部巨大片名、演员名小字、上映日期
// ============================================
function drawMovie(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 整体压暗（电影海报的氛围）
  ctx.fillStyle = "rgba(0,0,0,0.25)";
  ctx.fillRect(0, 0, W, H);

  // 顶部小字（导演 / 类型）
  ctx.shadowColor = "rgba(0,0,0,0.8)";
  ctx.shadowBlur = 6;
  ctx.fillStyle = "rgba(255,255,255,0.9)";
  ctx.font = "600 11px Inter";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("A FILM BY · 导演 ZHANG", W / 2, 30);

  // 主演名单（小字）
  ctx.font = "800 16px Inter";
  ctx.fillStyle = "#fff";
  ctx.fillText((opts.subtitle || "STARRING THE ICONIC ROLE").toUpperCase(), W / 2, 56);
  ctx.shadowBlur = 0;

  // 底部黑色渐变
  const bg = ctx.createLinearGradient(0, H - 380, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(0.4, "rgba(0,0,0,0.6)");
  bg.addColorStop(1, "rgba(0,0,0,0.95)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 380, W, 380);

  // 巨大片名
  ctx.shadowColor = "rgba(255,255,255,0.15)";
  ctx.shadowBlur = 20;
  ctx.fillStyle = "#fff";
  ctx.font = "900 72px 'Cinzel'";
  ctx.textAlign = "center";
  ctx.textBaseline = "bottom";
  ctx.fillText(opts.mainTitle, W / 2, H - 170);
  ctx.shadowBlur = 0;

  // 上映信息
  ctx.fillStyle = "rgba(255,255,255,0.85)";
  ctx.font = "600 13px Inter";
  ctx.fillText("IN THEATERS  ·  " + opts.issueDate, W / 2, H - 135);

  // 评级框
  const rateX = W / 2 - 25;
  const rateY = H - 110;
  ctx.strokeStyle = "rgba(255,255,255,0.6)";
  ctx.lineWidth = 1.5;
  ctx.strokeRect(rateX, rateY, 50, 24);
  ctx.fillStyle = "#fff";
  ctx.font = "800 13px Inter";
  ctx.fillText("PG-13", W / 2, rateY + 16);

  // 制片厂 / 演职员小字
  ctx.font = "500 9px Inter";
  ctx.fillStyle = "rgba(255,255,255,0.6)";
  ctx.fillText("STUDIO PICTURES PRESENTS A FILM PRODUCTION", W / 2, H - 60);
  ctx.fillText("MUSIC  CINEMATOGRAPHY  EDITED  PRODUCED  DIRECTED", W / 2, H - 44);
  ctx.fillText("© 2026 ALL RIGHTS RESERVED", W / 2, H - 28);
}

// ============================================
// 风格 10: Wanted Poster 风（西部通缉令）
// 特征：仿羊皮纸、复古衬线、DEAD OR ALIVE、悬赏金额
// ============================================
function drawWanted(ctx, opts) {
  // 羊皮纸底色
  const paper = ctx.createLinearGradient(0, 0, W, H);
  paper.addColorStop(0, "#e8d8a8");
  paper.addColorStop(0.5, "#d9c285");
  paper.addColorStop(1, "#c5a85f");
  ctx.fillStyle = paper;
  ctx.fillRect(0, 0, W, H);

  // 加一些粗糙感（小污点）
  ctx.fillStyle = "rgba(80, 50, 20, 0.08)";
  for (let i = 0; i < 40; i++) {
    const x = Math.random() * W;
    const y = Math.random() * H;
    const r = 2 + Math.random() * 18;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
  }

  // 边框装饰
  ctx.strokeStyle = "#3b2510";
  ctx.lineWidth = 6;
  ctx.strokeRect(20, 20, W - 40, H - 40);
  ctx.lineWidth = 1;
  ctx.strokeRect(34, 34, W - 68, H - 68);

  // WANTED 巨字
  ctx.fillStyle = "#3b2510";
  ctx.font = "900 92px 'Cinzel'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("WANTED", W / 2, 60);

  // DEAD OR ALIVE
  ctx.font = "700 22px 'Special Elite'";
  ctx.fillText("— DEAD OR ALIVE —", W / 2, 170);

  // 照片区域（带sepia色调框）
  const photoY = 220;
  const photoH = 440;
  ctx.fillStyle = "#3b2510";
  ctx.fillRect(80, photoY - 6, W - 160, photoH + 12);

  // 用 sepia 滤镜画照片
  const oldFilter = state.filter;
  ctx.save();
  ctx.beginPath();
  ctx.rect(80, photoY, W - 160, photoH);
  ctx.clip();
  if (opts.photo) {
    ctx.filter = "sepia(0.8) contrast(1.1) brightness(0.95)";
    // 手动复用 drawPhoto 的尺寸逻辑
    const area = { x: 80, y: photoY, w: W - 160, h: photoH };
    const ratio = opts.photo.width / opts.photo.height;
    const areaRatio = area.w / area.h;
    let dw, dh;
    if (ratio > areaRatio) {
      dh = area.h * state.scale;
      dw = dh * ratio;
    } else {
      dw = area.w * state.scale;
      dh = dw / ratio;
    }
    const dx = area.x + (area.w - dw) / 2 + state.offsetX;
    const dy = area.y + (area.h - dh) / 2 + state.offsetY;
    ctx.drawImage(opts.photo, dx, dy, dw, dh);
  } else {
    ctx.fillStyle = "#5a4020";
    ctx.fillRect(80, photoY, W - 160, photoH);
    ctx.fillStyle = "rgba(255,255,255,0.4)";
    ctx.font = "300 16px Inter";
    ctx.textAlign = "center";
    ctx.fillText("上传照片以查看效果", W / 2, photoY + photoH / 2);
  }
  ctx.restore();

  // 名字（标题）
  ctx.fillStyle = "#3b2510";
  ctx.font = "900 36px 'Cinzel'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText(opts.mainTitle.toUpperCase(), W / 2, photoY + photoH + 20);

  // 悬赏
  ctx.font = "700 20px 'Special Elite'";
  ctx.fillText("REWARD", W / 2, photoY + photoH + 70);
  ctx.font = "900 44px 'Cinzel'";
  ctx.fillStyle = "#7a1a0a";
  ctx.fillText("$10,000", W / 2, photoY + photoH + 95);

  // 底部小字
  ctx.fillStyle = "#3b2510";
  ctx.font = "500 11px 'Special Elite'";
  ctx.fillText("BY ORDER OF THE TERRITORIAL GOVERNMENT", W / 2, H - 50);
  ctx.fillText(opts.subtitle, W / 2, H - 32);
}

// ============================================
// 风格 11: POPEYE 风（City Boys 杂志）
// 特征：白底、玩味感、混搭 JP/EN 文字、彩色 coverlines
// ============================================
function drawPopeye(ctx, opts) {
  // 白底
  ctx.fillStyle = "#f5f1ea";
  ctx.fillRect(0, 0, W, H);

  // 顶部 POPEYE wordmark（粗体、字间距大）
  ctx.fillStyle = "#1a3aa8";
  ctx.font = "900 84px 'Anton'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("POPEYE", W / 2, 30);

  // tagline
  ctx.fillStyle = "#e02020";
  ctx.font = "italic 600 14px 'Playfair Display'";
  ctx.fillText("Magazine for City Boys", W / 2, 115);

  // 期号
  ctx.fillStyle = "#666";
  ctx.font = "600 11px Inter";
  ctx.textAlign = "left";
  ctx.fillText("No.928  ·  " + opts.issueDate, 30, 30);
  ctx.textAlign = "right";
  ctx.fillText("¥830  ·  日本", W - 30, 30);

  // 照片区（带内边距，City Boys 风格留白）
  drawPhoto(ctx, { x: 60, y: 150, w: W - 120, h: H - 150 - 240 }, opts.photo);

  // 黄色色块 coverline
  ctx.fillStyle = "#ffd636";
  ctx.fillRect(30, H - 230, 220, 36);
  ctx.fillStyle = "#1a3aa8";
  ctx.font = "900 18px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "middle";
  ctx.fillText("CITY BOY 指南", 42, H - 212);

  // 红色色块
  ctx.fillStyle = "#e02020";
  ctx.fillRect(W - 250, H - 230, 220, 36);
  ctx.fillStyle = "#fff";
  ctx.font = "900 18px 'Anton'";
  ctx.textAlign = "left";
  ctx.fillText("100 ITEMS WE LOVE", W - 240, H - 212);

  // 主标题（混搭日文感）
  ctx.fillStyle = "#000";
  ctx.font = "900 40px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText(opts.mainTitle.toUpperCase(), 30, H - 175);

  ctx.font = "500 14px 'Noto Sans JP'";
  ctx.fillStyle = "#444";
  ctx.fillText(opts.subtitle, 30, H - 125);

  // 底部 footer 小标签
  ctx.font = "700 11px Inter";
  ctx.fillStyle = "#1a3aa8";
  ctx.fillText("FASHION  ·  CULTURE  ·  CITY LIFE  ·  TOKYO LOOKBOOK", 30, H - 75);

  drawBarcode(ctx, W - 100, H - 60, 70, 28);
}

// ============================================
// 风格 12: BRUTUS 风
// 特征：白底极简、黑色衬线大字、文艺主题感
// ============================================
function drawBrutus(ctx, opts) {
  // 米白底
  ctx.fillStyle = "#ede8d9";
  ctx.fillRect(0, 0, W, H);

  // BRUTUS wordmark
  ctx.fillStyle = "#000";
  ctx.font = "italic 900 84px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("BRUTUS", W / 2, 25);

  // 顶部装饰条 + 期号
  ctx.fillStyle = "#000";
  ctx.fillRect(30, 115, W - 60, 2);
  ctx.font = "600 11px Inter";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("ISSUE No.1043", 30, 125);
  ctx.textAlign = "center";
  ctx.fillText("特集 · 特集", W / 2, 125);
  ctx.textAlign = "right";
  ctx.fillText(opts.issueDate.toUpperCase() + "  ¥780", W - 30, 125);

  // 大主题词（BRUTUS 标志：用主题词当封面大字）
  ctx.fillStyle = "#000";
  ctx.font = "900 44px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("特集", 30, 170);
  ctx.font = "900 60px 'DM Serif Display'";
  ctx.fillText(opts.mainTitle, 110, 162);

  // 照片
  drawPhoto(ctx, { x: 30, y: 260, w: W - 60, h: H - 260 - 160 }, opts.photo);

  // 底部副标题
  ctx.fillStyle = "#000";
  ctx.font = "500 14px 'Shippori Mincho B1'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText(opts.subtitle, 30, H - 100);
  ctx.font = "italic 500 11px 'DM Serif Display'";
  ctx.fillStyle = "#666";
  ctx.fillText("— A magazine of lifestyle and culture.", 30, H - 75);

  // 底部装饰条
  ctx.fillStyle = "#000";
  ctx.fillRect(30, H - 50, W - 60, 1);
  ctx.font = "700 10px Inter";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("BRUTUS.MAGAZINE", 30, H - 40);
  ctx.textAlign = "right";
  ctx.fillText("MAGAZINE HOUSE", W - 30, H - 40);
}

// ============================================
// 风格 13: &Premium 风
// 特征：奶咖色调、女性生活美学、超干净留白
// ============================================
function drawAndPremium(ctx, opts) {
  // 奶咖底色
  ctx.fillStyle = "#e8dfd0";
  ctx.fillRect(0, 0, W, H);

  // &Premium wordmark - 优雅衬线
  ctx.fillStyle = "#3a2e26";
  ctx.font = "italic 800 60px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("&Premium", W / 2, 40);

  // tagline
  ctx.font = "400 12px 'Shippori Mincho B1'";
  ctx.fillStyle = "#6b5b50";
  ctx.fillText("THE GUIDE TO A BETTER LIFE", W / 2, 110);

  // 顶部细节
  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#6b5b50";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("ISSUE No.124  ·  " + opts.issueDate, 30, 30);
  ctx.textAlign = "right";
  ctx.fillText("¥850", W - 30, 30);

  // 照片（带留白，更优雅）
  drawPhoto(ctx, { x: 80, y: 165, w: W - 160, h: H - 165 - 230 }, opts.photo);

  // 底部内容 - 主题感
  ctx.fillStyle = "#3a2e26";
  ctx.font = "500 13px 'Shippori Mincho B1'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("特集 · 特集", W / 2, H - 200);

  ctx.font = "900 44px 'Shippori Mincho B1'";
  ctx.fillText(opts.mainTitle, W / 2, H - 175);

  ctx.font = "italic 500 16px 'DM Serif Display'";
  ctx.fillStyle = "#6b5b50";
  ctx.fillText(opts.subtitle, W / 2, H - 115);

  // 细装饰线
  ctx.strokeStyle = "#3a2e26";
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(W / 2 - 30, H - 80);
  ctx.lineTo(W / 2 + 30, H - 80);
  ctx.stroke();

  ctx.font = "500 11px Inter";
  ctx.fillStyle = "#6b5b50";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("LIFESTYLE  ·  TRAVEL  ·  FOOD  ·  CULTURE", W / 2, H - 60);
}

// ============================================
// 风格 14: GINZA 风
// 特征：东京女孩高级感、强烈对比、粉色/黑色
// ============================================
function drawGinza(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部白色色块带
  ctx.fillStyle = "#fff";
  ctx.fillRect(0, 0, W, 110);

  // GINZA 大字
  ctx.fillStyle = "#000";
  ctx.font = "900 90px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("GINZA", 25, 5);

  // 右侧元信息
  ctx.font = "700 11px Inter";
  ctx.fillStyle = "#000";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText(opts.issueDate + "  ·  No.318", W - 25, 30);
  ctx.fillText("¥980", W - 25, 50);
  ctx.font = "italic 500 12px 'Playfair Display'";
  ctx.fillStyle = "#e85a8a";
  ctx.fillText("Tokyo Cultivated Magazine", W - 25, 75);

  // 粉色装饰条
  ctx.fillStyle = "#e85a8a";
  ctx.fillRect(0, 110, W, 4);

  // 左侧 coverlines（粗黑大字 + 粉色点缀）
  ctx.shadowColor = "rgba(0,0,0,0.6)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "TOKYO", 25, 220, { font: "900 36px 'Anton'", color: "#fff" });
  drawCoverline(ctx, "GIRLS", 25, 258, { font: "900 36px 'Anton'", color: "#e85a8a" });
  drawCoverline(ctx, "今、本当に欲しいもの", 25, 305, { font: "500 13px 'Noto Sans JP'", color: "#fff" });
  drawCoverline(ctx, "ALL ABOUT FASHION 2026", 25, 326, { font: "700 12px Inter", color: "#fff" });

  // 右侧
  drawCoverline(ctx, "BEAUTY", W - 25, 420, { font: "900 24px 'Anton'", color: "#e85a8a", align: "right" });
  drawCoverline(ctx, "REVOLUTION", W - 25, 448, { font: "900 24px 'Anton'", color: "#fff", align: "right" });
  drawCoverline(ctx, "美しさの新しい定義", W - 25, 484, { font: "500 12px 'Noto Sans JP'", color: "#fff", align: "right" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 280, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.85)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 280, W, 280);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  ctx.fillStyle = "#fff";
  ctx.font = "900 56px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText(opts.mainTitle.toUpperCase(), 25, H - 90);

  ctx.font = "500 14px 'Noto Sans JP'";
  ctx.fillStyle = "#e85a8a";
  ctx.fillText(opts.subtitle, 25, H - 55);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 15: Numéro TOKYO 风
// 特征：前卫先锋、巨大衬线 wordmark、暗色调
// ============================================
function drawNumero(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部黑色渐变让 wordmark 突出
  const grad = ctx.createLinearGradient(0, 0, 0, 220);
  grad.addColorStop(0, "rgba(0,0,0,0.55)");
  grad.addColorStop(1, "rgba(0,0,0,0)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, 220);

  // Numéro wordmark
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 92px 'DM Serif Display'";
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText("Numéro", W / 2, 30);

  // TOKYO 副标
  ctx.font = "700 18px 'Inter'";
  ctx.fillStyle = "rgba(255,255,255,0.85)";
  ctx.fillText("T O K Y O", W / 2, 140);

  // 顶部细节
  ctx.font = "600 11px Inter";
  ctx.textAlign = "left";
  ctx.fillText(opts.issueDate + "  ·  No.156", 30, 30);
  ctx.textAlign = "right";
  ctx.fillText("¥1,200", W - 30, 30);

  // 中部 coverline
  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  drawCoverline(ctx, "AVANT-GARDE", 30, 260, { font: "italic 900 28px 'DM Serif Display'", color: "#fff" });
  drawCoverline(ctx, "FASHION NOW", 30, 295, { font: "italic 900 28px 'DM Serif Display'", color: "rgba(255,255,255,0.6)" });
  drawCoverline(ctx, "ファッションの新しい言葉", 30, 340, { font: "500 13px 'Noto Sans JP'", color: "#fff" });

  // 右侧装饰文字
  drawCoverline(ctx, "ART", W - 30, 430, { font: "italic 900 24px 'DM Serif Display'", color: "#fff", align: "right" });
  drawCoverline(ctx, "EXCLUSIVE INTERVIEW", W - 30, 462, { font: "700 11px Inter", color: "#fff", align: "right" });
  drawCoverline(ctx, "アーティストの世界", W - 30, 482, { font: "500 12px 'Noto Sans JP'", color: "rgba(255,255,255,0.85)", align: "right" });
  ctx.shadowBlur = 0;

  // 底部主标题
  const bg = ctx.createLinearGradient(0, H - 280, 0, H);
  bg.addColorStop(0, "rgba(0,0,0,0)");
  bg.addColorStop(1, "rgba(0,0,0,0.9)");
  ctx.fillStyle = bg;
  ctx.fillRect(0, H - 280, W, 280);

  ctx.shadowColor = "rgba(0,0,0,0.7)";
  ctx.shadowBlur = 10;
  ctx.fillStyle = "#fff";
  ctx.font = "italic 900 60px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "bottom";
  ctx.fillText(opts.mainTitle, 30, H - 95);

  ctx.font = "italic 500 18px 'DM Serif Display'";
  ctx.fillStyle = "rgba(255,255,255,0.7)";
  ctx.fillText(opts.subtitle, 30, H - 60);
  ctx.shadowBlur = 0;
}

// ============================================
// 风格 16: Men's Non-no 风
// 特征：日本男生潮流穿搭、playful、亮色 coverlines
// ============================================
function drawMensNonno(ctx, opts) {
  drawPhoto(ctx, { x: 0, y: 0, w: W, h: H }, opts.photo);

  // 顶部白色色块
  ctx.fillStyle = "#fff";
  ctx.fillRect(0, 0, W, 130);

  // Men's Non-no wordmark
  ctx.fillStyle = "#000";
  ctx.font = "italic 900 36px 'DM Serif Display'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("Men's", 25, 18);
  ctx.fillStyle = "#ff5a3c";
  ctx.font = "900 58px 'Anton'";
  ctx.fillText("Non-no", 110, 8);

  // 副信息
  ctx.fillStyle = "#000";
  ctx.font = "600 11px Inter";
  ctx.textAlign = "right";
  ctx.textBaseline = "top";
  ctx.fillText(opts.issueDate + "  No.564", W - 25, 25);
  ctx.fillText("¥720", W - 25, 45);
  ctx.font = "500 11px 'Shippori Mincho B1'";
  ctx.fillStyle = "#ff5a3c";
  ctx.fillText("毎月10日発売", W - 25, 65);

  // 顶部主题色条
  ctx.fillStyle = "#ff5a3c";
  ctx.fillRect(0, 130, W, 3);

  // 顶部主 coverline
  ctx.fillStyle = "#000";
  ctx.font = "900 22px 'Anton'";
  ctx.textAlign = "left";
  ctx.textBaseline = "top";
  ctx.fillText("BEST OF STREET STYLE 2026", 25, 95);

  // 左侧 coverlines
  ctx.shadowColor = "rgba(0,0,0,0.6)";
  ctx.shadowBlur = 8;
  drawCoverline(ctx, "今着たい", 25, 220, { font: "900 28px 'Shippori Mincho B1'", color: "#fff" });
  drawCoverline(ctx, "100 LOOKS", 25, 252, { font: "900 32px 'Anton'", color: "#ff5a3c" });
  drawCoverline(ctx, "メンズ最旬コーデ", 25, 295, { font: "500 13px 'Noto Sans JP'", color: "#fff" });

  drawCoverline(ctx, "INTERVIEW", 25, 380, { font: "900 18px 'Anton'", color: "#ffd636" });
  drawCoverline(ctx, "独家专访", 25, 405, { font: "700 14px 'Noto Sans JP'", color: "#fff" });

  // 右侧装饰圆形 badge
  ctx.fillStyle = "#ffd636";
  ctx.beginPath();
  ctx.arc(W - 70, 250, 50, 0, Math.PI * 2);
  ctx.fill();
  ctx.shadowBlur = 0;
  ctx.fillStyle = "#000";
  ctx.font = "900 14px 'Anton'";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText("NEW", W - 70, 240);
  ctx.fillText("ISSUE!", W - 70, 260);
  ctx.shadowColor = "rgba(0,0,0,0.6)";
