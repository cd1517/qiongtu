  };

  // 摄影师中文简介（选完后展示给用户）
  const PHOTOGRAPHER_BIO = {
    random: "🎲 每张照片随机抽一位摄影大师 —— 不同张数会换不同风格。想要套图统一风格请手动选定一位。",
    // 西方
    newton: "🇩🇪 Helmut Newton（1920–2004）· 德国传奇时装摄影大师。高对比黑白、戏剧化光影、强势女性形象、酒店内饰场景。代表作《Big Nudes》《Sleepless Nights》。",
    avedon: "🇺🇸 Richard Avedon（1923–2004）· 美国时装与人像之神。纯白背景、犀利极简、心理学式的眼神捕捉。Marilyn Monroe、Audrey Hepburn 经典肖像都出自他手。",
    lindbergh: "🇩🇪 Peter Lindbergh（1944–2019）· 反魔法美学的开山者。坚持黑白、自然光、无修图，把九十年代超模天团 Cindy Crawford、Linda Evangelista 推向时代封面。",
    leibovitz: "🇺🇸 Annie Leibovitz（1949– ）· 《Vanity Fair》《Vogue》御用。戏剧化叙事、复杂布景、电影感打光。约翰·列侬与小野洋子最后一张合影、奥巴马总统肖像出自她手。",
    klein: "🇺🇸 Steven Klein · 当代时装阴郁派。心理张力、神秘感、单光源硬影、深色饱和。麦当娜、布兰妮、贝克汉姆御用。",
    lachapelle: "🇺🇸 David LaChapelle · 波普超现实主义之父。糖果色、宗教意象、夸张道具、好莱坞 + 流行文化大混搭。Lady Gaga、Rihanna、Britney 都为他疯狂。",
    walker: "🇬🇧 Tim Walker · 童话森林系。手工巨型道具、英伦古怪浪漫、《Vogue》梦幻封面常客。Tilda Swinton 御用。",
    knight: "🇬🇧 Nick Knight · 时装摄影的未来主义者。数码后期、3D 融合、运动模糊、SHOWstudio 创办人。Lady Gaga、Björk 高概念视觉总舵主。",
    mertmarcus: "🇹🇷🇬🇧 Mert & Marcus · 二人组（Mert Alas + Marcus Piggott）。极致光泽、强烈色调、当代最商业化的高光泽时装美学。Kate Moss、Rihanna 大刊封面常客。",
    testino: "🇵🇪 Mario Testino · 戴安娜王妃御用，温暖、明亮、自然亲密的奢华。Madonna、贝克汉姆夫妇、凯特王妃肖像都出自他手。",
    demarchelier: "🇫🇷 Patrick Demarchelier（1943–2022）· 经典优雅黑白派。黛安娜王妃御用、《Harper's Bazaar》主力，柔和女性化的法式优雅。",
    inezvinoodh: "🇳🇱 Inez & Vinoodh · 荷兰二人组（Inez van Lamsweerde + Vinoodh Matadin）。极简编辑风、身体艺术化、《W》《Self Service》御用。",
    weber: "🇺🇸 Bruce Weber · 美式怀旧扛把子。阳光、青春、健康的 80 年代 Calvin Klein、A&F、Ralph Lauren 广告御用。金黄色调、海滩牧场氛围。",
    teller: "🇩🇪 Juergen Teller · 反高级派。机内闪光、粗粝快照感、Marc Jacobs 御用。不修图、不摆姿势，朋克气质冷淡幽默。",
    // 日本
    ninagawa: "🇯🇵 蜷川实花（1972– ）· 日本「颜色女王」。浓饱和糖果色 + 樱花/牡丹/绣球花海 + 金鱼，强烈女性主义视觉。AKB48、滨崎步、最近《Hen-na Onna》写真集御用。",
    okuyama: "🇯🇵 奥山由之（1991– ）· 新一代日本年轻人像之星。柔光、菲林颗粒、青春日记感。野田洋次郎、苍井优、菅田将晖、SEKAI NO OWARI 大刊御用。",
    hamada: "🇯🇵 滨田英明（1977– ）· 温柔家庭日常派。柔光、家居、亲情、自然光下的安静日本。代表作《Haru and Mina》系列。",
    kawauchi: "🇯🇵 川内伦子（1972– ）· 日常生活的摄影诗人。柔光淡色、生死与微小瞬间的哲学，方画幅俳句感。木村伊兵卫奖得主。",
    moriyama: "🇯🇵 森山大道（1938– ）· 日本街头摄影教父。「粗・ブレ・ボケ」黑白高对比颗粒派，新宿、东京、流浪狗的灵魂。",
    uedashoji: "🇯🇵 植田正治（1913–2000）· 鸟取沙丘超现实剧场派。人物在沙丘上的几何排列，演出式的极简静物人像，「植田调」自成一派。",
    araki: "🇯🇵 荒木经惟（1940– ）· 日本「写真之神」。这里保留温柔的「《センチメンタルな旅》/ 东京日常」侧 —— 暖色胶片、Tokyo 都市情感、电车日常、深情私写真。",
    uedayoshihiko: "🇯🇵 上田义彦（1957– ）· 东方禅意商业人像。三得利乌龙茶广告御用，光线克制、构图冥想，留白与呼吸感的极简美学。",
    // 港台导演
    wongdoyle: "🇭🇰 王家卫×杜可风 · 香港电影黄金搭档。饱和宝石色调（青绿+橙红）、霓虹+钨丝灯、慢门拖影、烟雾雨水、狭窄垂直街巷。《花样年华》《重庆森林》《堕落天使》。",
    shya: "🇭🇰 夏永康 Wing Shya · 王家卫剧照师出身的电影帧美学。柔和褪色 + 划痕颗粒 + 失焦诗意，时装与电影边界模糊。",
    hou: "🇹🇼 侯孝贤（1947– ）· 台湾新电影旗手。长镜头远观，乡村小镇火车站，温暖钨丝灯，朴素低饱和。《悲情城市》《刺客聂隐娘》。",
    yang: "🇹🇼 杨德昌（1947–2007）· 台湾现代都市疏离。几何玻璃倒影、冷蓝调台北、办公楼公寓。《一一》《牯岭街少年杀人事件》。",
    tsai: "🇹🇼 蔡明亮（1957– ）· 极简长镜头孤独诗人。空旷走廊、雨夜街道、滴水霓虹，主体静止冥想。《爱情万岁》《不散》《天边一朵云》。",
    anglee: "🇹🇼 李安（1954– ）· 东西交融大师。柔和自然光、温冷色平衡、古典构图、情感克制。《卧虎藏龙》《色戒》《饮食男女》。",
    kwan: "🇭🇰 关锦鹏（1957– ）· 女性细腻派。柔光老香港室内、旗袍丝绸、桃花心木家具、暖琥珀色。《阮玲玉》《胭脂扣》《蓝宇》。",
  };

