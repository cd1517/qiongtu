<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="UTF-8" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,700&family=Bebas+Neue&family=Oswald:wght@400;600;700&family=Inter:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@700;900&family=Cinzel:wght@700;900&family=Anton&family=Special+Elite&family=Bodoni+Moda:ital,wght@0,700;0,900;1,700&family=Noto+Sans+JP:wght@400;700;900&family=Shippori+Mincho+B1:wght@700;900&family=DM+Serif+Display:ital@0;1&display=swap" />
</head><body style="margin:0;background:#000">
<canvas id="cover" width="720" height="960"></canvas>
<script>
// ============================================
// 核心：杂志封面渲染引擎
// 思路：每种风格对应一个 draw 函数，接收 ctx + options，
//       在 720x960 的画布上画出该风格的封面。
// 后续接入真实 AI 时，只需要把"画照片"这一步换成
// "调用 AI 生成的图片"，框架完全复用。
// ============================================

const canvas = document.getElementById("cover");
const ctx = canvas.getContext("2d");
const W = canvas.width;
const H = canvas.height;

// 当前状态
const state = {
  style: "vogue",
  photo: null,          // 当前显示用的 HTMLImageElement（= 原图或 AI 图）
  originalPhoto: null,  // 用户上传的原图（保留备份，用于送给 AI）
  aiPhoto: null,        // AI 生成的图
  currentTask: null,    // 当前预览对应的服务器任务（用于继续生成无字版）
  photoMode: "original",// "original" | "ai"
  mainTitle: "",
  subtitle: "",
  issueDate: "",
  price: "",
  scale: 1,
  offsetX: 0,
  offsetY: 0,
  filter: "none",
  showTemplate: true,   // 是否叠加 Canvas 模板（标题/coverlines/边框等）
  forceCustomText: false, // 是否强制 AI 使用自定义文字
};

// 用户设置（从 localStorage 加载）
const settings = {
  model: "gpt-image-2",
  size: "1024x1536",
  quality: "medium",
  beautyLevel: "medium",     // none | subtle | medium | strong
  ageLevel: "original",      // original | teens | twenties | ... | sixties
  persona: "random",         // random | seiso | kawaii | ... (19 options)
  gender: "auto",            // auto | male | female | androgynous
  photoSchool: "random",     // random | newton | leibovitz | walker | klein | ...
};

const AUTH_TOKEN_KEY = "godcover_auth_token_v1";
let authToken = localStorage.getItem(AUTH_TOKEN_KEY) || "";
let currentUser = null;
let authMode = "login";
let registerConfig = { inviteRequired: false };
let currentGeneratingTask = null;

// 📷 摄影流派 14 位大师：每位都建立独特视觉语言
const PHOTO_SCHOOLS_PROMPTS = {
  random: "",
  // 黑白经典
  newton:
    " === PHOTOGRAPHY STYLE: Helmut Newton aesthetic === Shoot in the style of Helmut Newton: high-contrast black-and-white photography, theatrical glamour with edgy provocative tension, dramatic chiaroscuro lighting with hard shadows, polished mid-century glamour, often featuring strong powerful poses, urban or hotel interior settings, refined elegance with subversive edge. Render in black-and-white with bold contrast.",
  avedon:
    " === PHOTOGRAPHY STYLE: Richard Avedon aesthetic === Shoot in the style of Richard Avedon: minimalist seamless white or pale grey background, stark studio lighting that reveals every detail, the subject isolated against pure white, intimate intense portrait photography, refined elegant simplicity, often black-and-white or muted tones, focus entirely on the subject with no environmental distractions.",
  lindbergh:
    " === PHOTOGRAPHY STYLE: Peter Lindbergh aesthetic === Shoot in the style of Peter Lindbergh: 'anti-glamour' naturalist black-and-white photography, minimal/no retouching ethos showing authentic skin and natural beauty, soft natural daylight, intimate candid feel, the subject in casual unstudied poses, raw emotional honesty, often with wind-tousled hair and minimal makeup, classic film grain quality.",
  // 戏剧化
  leibovitz:
    " === PHOTOGRAPHY STYLE: theatrical celebrity portrait aesthetic === Use theatrical narrative portrait photography: elaborate conceptual staging that tells a story, dramatic cinematic lighting (often with strong direction and color gels), the subject in an elaborate environment or scenario, painterly composition, celebrity-portrait-grandeur quality, rich vibrant colors with deep shadows.",
  klein:
    " === PHOTOGRAPHY STYLE: Steven Klein aesthetic === Shoot in the style of Steven Klein: dark, moody, conceptual fashion photography with provocative undertones, high-contrast cinematic lighting (often single source, strong shadow), psychological intensity, edgy avant-garde styling, deep saturated dark color palette, atmospheric mysterious mood, theatrical fashion-as-art quality.",
  lachapelle:
    " === PHOTOGRAPHY STYLE: David LaChapelle aesthetic === Shoot in the style of David LaChapelle: hyper-saturated pop-surreal photography, candy-bright colors with absurdly maximalist staging, religious/mythological iconography mixed with pop culture, exaggerated theatrical compositions, often with elaborate props and impossible scenarios, kitsch-meets-art-history sensibility, glossy hyperreal quality.",
  // 梦幻 / 童话
  walker:
    " === PHOTOGRAPHY STYLE: whimsical high-fashion fantasy editorial aesthetic === Use an adult high-fashion fantasy set: elaborate handcrafted set design with oversized flowers, vintage objects, sculptural props, painterly soft color palette, British eccentric romanticism, the subject placed in a dreamlike editorial environment with mature couture styling. Keep the mood artistic and fashion-forward, never childlike.",
  knight:
    " === PHOTOGRAPHY STYLE: Nick Knight aesthetic === Shoot in the style of Nick Knight: experimental forward-thinking fashion photography, digital manipulation and 3D imagery integration, bold avant-garde compositions, futuristic styling, vivid colors with experimental texture, fashion-as-art innovation, often with motion blur or digital effects, conceptual cutting-edge feel.",
  // 光泽 / 时尚
  mertmarcus:
    " === PHOTOGRAPHY STYLE: Mert & Marcus (Alas & Piggott) aesthetic === Shoot in the style of Mert and Marcus: hyper-glossy contemporary glamour, ultra-polished surface quality, vibrant saturated colors with extreme color grading, intense beauty-retouch finish, sleek glossy studio look with dramatic colored backgrounds, contemporary high-fashion glamour at maximum intensity.",
  testino:
    " === PHOTOGRAPHY STYLE: Mario Testino aesthetic === Shoot in the style of Mario Testino: vibrant joyful celebrity photography, intimate-access glamour with a warm friendly quality, bright sunny color palette, the subject genuinely smiling or laughing, breezy effortless luxury, often outdoor/sunset settings, accessible-yet-aspirational quality, warm golden tones.",
  demarchelier:
    " === PHOTOGRAPHY STYLE: Patrick Demarchelier aesthetic === Shoot in the style of Patrick Demarchelier: refined classic-elegance fashion photography, timeless feminine grace, soft beautiful lighting, often black-and-white or sepia tones, the subject in poised classical poses, Princess-Diana-portrait-quality refinement, understated luxury, gentle warmth.",
  inezvinoodh:
    " === PHOTOGRAPHY STYLE: Inez & Vinoodh aesthetic === Shoot in the style of Inez and Vinoodh: clean editorial fashion photography, body-as-canvas aesthetic with painted-on elements or graphic body styling, often pure white or solid colored backgrounds, precise refined composition, contemporary art-meets-fashion quality, sleek minimalist directness.",
  // 自然 / 街拍
  weber:
    " === PHOTOGRAPHY STYLE: sun-drenched adult lifestyle fashion aesthetic === Use warm sunlit adult lifestyle photography: athletic healthy adult fashion energy, black-and-white or warm sepia tones, outdoor natural settings (beach, ranch, summer house), nostalgic Americana feel, classic preppy aesthetic, golden-hour warmth, relaxed editorial confidence.",
  teller:
    " === PHOTOGRAPHY STYLE: Juergen Teller aesthetic === Shoot in the style of Juergen Teller: raw flash-on-camera documentary photography, anti-glamour casual aesthetic, intentionally unposed-feeling moments, harsh on-camera flash creating shadows, indie/grunge mood, no retouching ethos, sometimes humorous or awkward composition, authentic snapshot feel.",
};

// 性别 prompt：放在最末尾作为"最终覆盖"，强制 override 上面所有可能女性化主体的指令
const GENDER_PROMPTS = {
  auto: "",
  male:
    " === FINAL OVERRIDE — SUBJECT GENDER: MALE === The subject in the photo is MALE and must be rendered as a man. This OVERRIDES any feminizing instructions above. DO NOT apply: V-shaped jaw narrowing, doll-like enlarged eyes, voluminous false lashes, glossy plump pink lips, feminine makeup, feminine outfits, frilly/cute clothing, cute feminine pose. DO apply: masculine grooming (clear healthy skin, well-groomed brows, defined masculine jawline, slight stubble if appropriate, healthy complexion), masculine fashion (suit, blazer, knitwear, streetwear, jackets — masculine equivalent of the magazine's style), masculine hairstyle (short cut, fade, undercut, side-swept, or longer styled appropriate for the magazine), confident masculine pose and expression. Render as an attractive well-groomed young man. Preserve their masculine bone structure (jawline, brow ridge) and overall masculine identity. Apply beauty retouching as 'professional male grooming' NOT 'feminine beauty filter'.",
  female:
    " === FINAL OVERRIDE — SUBJECT GENDER: FEMALE === The subject is female. Apply feminine grooming, makeup, fashion, and pose appropriate to the magazine and persona — including V-shaped jawline refinement, defined eye makeup, glossy lips, feminine styling.",
  androgynous:
    " === FINAL OVERRIDE — SUBJECT GENDER: ANDROGYNOUS === Style the subject with a gender-neutral androgynous look — soft balanced features, minimal makeup, gender-neutral fashion (oversized blazer, neutral colors, structured pieces), composed expression. Don't lean strongly masculine or feminine. Modern Tokyo androgynous fashion aesthetic.",
};

// 人设 prompt：18 种角色档案，每个建立独立的"封面人物气质"
const PERSONA_PROMPTS = {
  random: "",
  seiso:
    " === PERSONA: 清純系 (Seiso / Japanese Pure-Innocent Aesthetic) === Style the subject with the iconic Japanese 清楚 vibe: sleek long natural-brown or black straight hair, minimal barely-there natural makeup (clear skin, soft natural brows, light pink balm-tinted lips, no heavy eye makeup), gentle warm expression with a soft serene smile, refined elegant clothing in white/cream/soft pastel tones, an aura of refined purity and quiet elegance.",
  kawaii:
    " === PERSONA: 可愛系 (Kawaii Cute Aesthetic) === Style the subject as a classic kawaii cute girl: soft wavy or curled hair (natural brown or light honey blonde), bright doll-like makeup (rounded eye makeup, peachy blush across cheeks, glossy pink lips, tear-bag emphasis to enlarge eyes), bright happy expression with a playful big smile, cute outfit (frilly cardigan, sweet pastel colors with bow accents), an aura of bubbly cuteness and girlish charm.",
  natural:
    " === PERSONA: 天然系 (Natural Minimal Aesthetic) === Style the subject with effortless natural vibe: natural-textured loose-wave hair, almost no visible makeup (clear bare skin, natural brows, no heavy eye makeup, balm-tinted lips, 'just-woke-up' beauty feel), relaxed gentle expression, simple natural clothing (linen, cotton, oversized basics in neutral earth tones), an aura of unpretentious natural beauty.",
  gyaru:
    " === PERSONA: 辣妹 ギャル (Japanese Gyaru Street-Fashion Subculture) === Note: this is a fashion/style subculture aesthetic, NOT suggestive content. Style the subject with the classic Japanese gyaru street-fashion look: bleached blonde, honey-brown, or multi-color long wavy hair, lightly tanned skin tone, gyaru fashion makeup (eye makeup with eyeliner and mascara, blush, lipstick, groomed brows), playful confident expression often with a peace sign or cute pose, classic gyaru street-fashion outfit (chunky accessories, statement jewelry, decorated nails, signature gyaru attitude), an aura of confident gyaru fashion-subculture energy.",
  half:
    " === PERSONA: 混血ハーフ (East-Asian-Caucasian Mixed-Race Aesthetic) === Style the subject with the classic ハーフ顔 (hāfu face) look: deep-set expressive double-eyelid eyes, defined higher nose bridge, slightly more contoured facial structure with subtle Western-influenced bone structure, brown or light-colored hair (could include balayage or highlights), natural sophisticated makeup that enhances Eurasian features, an aura of exotic mixed-race charm. While preserving the subject's identity, render their features with subtly more Western-Caucasian-influenced facial structure suggesting mixed-race heritage.",
  jirai:
    " === PERSONA: 黒ピンク暗黒スウィート (Black-Pink Dark Sweet Fashion Aesthetic) === Style the subject with a mature dark-sweet Japanese street-fashion vibe: black or dark hair with a split-color pink or red inner layer, pale polished skin, graphic black-and-red eye makeup, wine-red lipstick, subtle blush, confident composed gaze, black-and-pink fashion palette with ribbons as styling accents, lace-textured layers, fitted jacket or structured cardigan, silver accessories, and polished adult street-fashion attitude. Keep it fashionable, confident, and adult; avoid vulnerable, vacant, distressed, childlike, or mascot-like cues.",
  ryousan:
    " === PERSONA: 量産型 (Ryousan / Mass-Produced Mainstream Cute) === Style the subject with classic 量産 vibe: soft curly hair in pink-tinted or light honey-brown wavy locks tied with ribbon bows, doll-like sweet makeup (rounded soft pink eye makeup, peachy blush, glossy pink heart-shaped lips, perfect porcelain skin), sweet innocent expression with closed-mouth smile, the iconic 量産 outfit (frilly pastel dress with bows, lace tops, ribbon accessories, baby pink or baby blue palette), an aura of romantic mainstream sweetness.",
  onee:
    " === PERSONA: 御姉 / 成熟 (Onee-san Sophisticated Elegant Aesthetic) === Style the subject with elegant sophisticated confident vibe: sleek polished hair (long straight, elegant bob, or refined waves in dark brown or black), refined sophisticated makeup (defined elegant eye makeup, contoured features, defined burgundy or wine-red lips), confident composed expression with subtle smile or direct gaze, sophisticated tailored fashion (tailored blazer, elegant dress, silk blouse, refined accessories), an aura of refined feminine power and established sophisticated confidence.",
  coser:
    " === PERSONA: コスプレイヤー (Adult Cosplayer Character Aesthetic) === Style the subject as a passionate adult Japanese cosplayer in a polished character costume: wearing an elaborate anime/game-style wig (colorful — blonde, silver, pink, blue, or vivid character colors), dramatic character makeup (sharp upward winged eyeliner, defined lashes, bold dimensional eyeshadow, optional colored contact lenses while keeping adult facial proportions), and a full character-specific costume such as fantasy warrior, sci-fi heroine, elegant gothic fantasy, historical fantasy, cyberpunk, or game-hero attire. Keep the styling fully dressed, mature, professional, and convention-photo-shoot appropriate; avoid school, student, childlike, or suggestive cues.",
  alt:
    " === PERSONA: 暗黒・亜文化 (Dark Alt Subculture Aesthetic) === Style the subject with edgy alt-subculture vibe: dark-dyed hair (jet black, deep red, or two-tone) with edgy styling, pale porcelain skin, dark dramatic makeup (smoky dark eye makeup, sharp winged eyeliner, dark lipstick — black, burgundy, or dark plum), intense moody expression, dark alt fashion (black leather, chains, fishnet layers, dark coats, platform boots, silver jewelry), an aura of mysterious rebellious darkness.",
  nightclub:
    " === PERSONA: 夜場系 / Festive Glam Aesthetic === Style the subject with bold festive glam vibe: voluminous styled hair (often with shimmer or sparkle accents), bronzed glowing skin, dramatic glam makeup (bold shimmer eye makeup, glossy bold lips, contoured features, glitter accents), confident expressive face, glamorous evening fashion (sparkly dress, sequins, metallics, statement jewelry), atmospheric warm-lit setting with bokeh accents and soft purple-pink lighting, an aura of confident festive energy.",
  queen:
    " === PERSONA: 女王系 (Queen / Powerful Commanding Aesthetic) === Style the subject with commanding queen vibe: sleek styled hair (sharp bob, slicked back, or dramatic long waves), bold powerful makeup (sharp winged eyeliner, defined contoured features, bold red or burgundy lips, dramatic eye shadow), confident dominant expression with direct piercing gaze, powerful commanding fashion (sharp black blazer, structured tailoring, dramatic high heels, dark red or burgundy accents, statement gold or silver jewelry), an aura of commanding feminine power and authority.",
  cabaret:
    " === PERSONA: 華麗グラム (Luxury Glamour Editorial Aesthetic) === Style the subject with a sophisticated red-carpet glamour fashion-editorial vibe: voluminous styled long curled hair (often honey-blonde or light brown), glamorous polished makeup (defined elegant eye makeup with long lashes, contoured cheekbones, glossy pink or red lips, perfectly applied luminous complexion), warm refined smile, sophisticated luxury fashion (elegant gala-style dress, satin-finish evening gown, statement crystal jewelry, designer accessories), atmospheric soft glamour lighting, an aura of polished luxury fashion-magazine glamour and refined elegance.",
  hkretro:
    " === PERSONA: 港風 (90s Hong Kong Retro Cinema Aesthetic) === Style the subject with iconic 90s Hong Kong vibe: voluminous permed or styled wavy hair (classic 90s perm volume), refined polished makeup (defined brows, classic red lips, soft contoured cheeks, romantic vintage eye makeup), classic Hong Kong cinema expression (knowing smile or wistful gaze), 90s Hong Kong fashion (silky blouse, slip dress, statement vintage jewelry, sometimes qipao influence), warm golden-hour or moody noir lighting, an aura of 90s Hong Kong silver-screen romance reminiscent of classic cinema era.",
  kclean:
    " === PERSONA: 韓系 / K-Style Clean Aesthetic === Style the subject with iconic K-beauty clean-girl vibe: sleek glossy hair (long straight or soft waves in natural dark brown or chocolate), porcelain glass-skin (dewy luminous flawless skin), minimal Korean beauty makeup (clear glowing skin, natural straight brows, peachy gradient lips, subtle natural eye makeup), serene composed expression, refined minimal Korean fashion (oversized blazer, white t-shirt, simple knitwear, neutral monochrome colors), an aura of clean refined Korean modernity.",
  genki:
    " === PERSONA: 元気 (Genki / Energetic Bright Aesthetic) === Style the subject with bright cheerful energetic vibe: bouncy energetic hair (high ponytail, playful waves, or pigtails with hair clips), bright clear skin with rosy blush, fresh natural happy makeup (rosy cheeks, bright eyes, glossy pink lips), big beaming joyful smile with energetic expression, casual sporty or bright cheerful fashion (oversized t-shirt, hoodie, varsity jacket, sneakers, bright colors), an aura of pure happy sunshine energy.",
  lolita:
    " === PERSONA: ロリータ (Lolita Fashion Aesthetic) === Style the subject as a Lolita fashion enthusiast: elaborate Lolita-style hair (ringlet curls, braided pigtails, or styled with bonnet or crown), refined doll-like makeup (rounded eye makeup, soft pink blush, glossy pink lips), elegant composed expression, full Lolita outfit (elaborate dress with petticoat, lace trim, ribbons and bows, blouse with puffy sleeves — could be Sweet Lolita pink-and-white, Gothic Lolita black-and-white, or Classic Lolita muted vintage palette), an aura of refined alternative fashion artistry.",
  jk:
    " === PERSONA: 学院風 / Preppy Academic Fashion Aesthetic === Style the subject as a confident young-adult woman in trendy Japanese preppy academic-style street fashion (an adult fashion-subculture inspired by classic preppy/collegiate looks): long brown or honey-tinted hair styled in soft curls or twin tails with side bangs, fresh youthful makeup (subtle eye makeup, peachy cheeks, glossy pink lips), playful cheerful expression with peace sign or cute pose, an iconic preppy outfit (collared button-down blouse with ribbon tie or bow tie at the collar, navy or grey tailored blazer or knit cardigan vest, A-line knee-length plaid or solid-color skirt, ankle socks, loafers or fashion sneakers), an aura of fresh playful collegiate-inspired fashion energy. Note: this is adult fashion-subculture styling inspired by collegiate aesthetics, NOT a depiction of an actual student.",
  // === 男性向人设 ===
  business:
    " === PERSONA: 商业精英 (Business Elite / CEO Male Aesthetic) === Style the subject as a polished young-to-middle-aged male business executive: sharp well-styled short hair (could be slicked back, side-parted, or modern crop), confident composed expression with direct strong eye contact, perfectly tailored sharp business suit (charcoal, navy, or black, slim-fit modern cut) with crisp white shirt and silk tie or refined open-collar look, well-groomed clean shave or neatly trimmed defined stubble, classic luxury watch and minimal refined accessories, sharp masculine jawline. An aura of refined CEO power and confident male success.",
  scholar:
    " === PERSONA: 文弱书生 (Gentle Scholar / Indie Literary Male Aesthetic) === Style the subject as a thoughtful intellectual young man: soft slightly tousled hair (natural brown or black), gentle contemplative expression with a soft introspective smile, classic round-frame or rectangular glasses, layered intellectual outfit (oversized knit cardigan or sweater over collared shirt, corduroy trousers, leather satchel), bookshelf or quiet cafe backdrop, soft scholarly demeanor, indie-academia masculine aesthetic. An aura of quiet intellectual masculine charm.",
  athlete:
    " === PERSONA: 体育明星 (Athletic Male Sports Star) === Style the subject as a confident male athletic sports star: well-toned muscular athletic build with lean defined physique, sharp masculine jawline and defined facial features, intense focused sports-star expression, athletic apparel (premium sports jersey, designer training gear, polished athletic streetwear), possibly with subtle sports motif background or stadium-lit setting, healthy bronzed skin tone. An aura of athletic male prowess and competitive confidence.",
  fitness:
    " === PERSONA: 健身教练 (Fitness Coach / Muscular Male Aesthetic) === Style the subject as a muscular male fitness coach: visibly muscular toned athletic build with defined arms, chest, and shoulders, sharp masculine features and chiseled jawline, confident gym-pose expression, fitted athletic gym attire (fitted t-shirt, athletic tank top, or workout hoodie showing physique, athletic joggers or shorts), healthy bronzed glowing skin tone, possibly in a modern gym or training setting. An aura of disciplined masculine fitness energy.",
  rocker:
    " === PERSONA: 摇滚青年 (Rock Star / Rebellious Male Musician) === Style the subject as a brooding male rock musician: medium-length or longer tousled rocker hair (natural or dyed dark), intense moody rebellious expression, signature rock outfit (worn leather jacket, vintage band tee, ripped or distressed jeans, black skinny pants), silver jewelry (rings, chains, cross necklaces), short stubble, atmospheric backstage or concert-venue setting, dark moody lighting. An aura of rebellious masculine rock-and-roll charisma.",
  gentleman:
    " === PERSONA: 英伦绅士 (British Gentleman / Old Money Male) === Style the subject as a refined old-money British gentleman: classic neatly side-parted hair, composed dignified masculine expression, refined three-piece tailored tweed or wool suit in heritage earthy tones (camel, tweed, navy), pocket square, classic Oxford or brogue shoes, refined timepiece, possibly with a vintage car, library, or members club setting, well-groomed clean shave or short trimmed beard. An aura of refined masculine heritage elegance and quiet-luxury old-money confidence.",
  kpopboy:
    " === PERSONA: 韩系欧巴 (K-pop Idol / Korean Oppa Aesthetic) === Style the subject as a polished K-pop idol young man: soft styled hair (often dyed natural brown, black, or pastel ash), perfect porcelain dewy masculine skin with subtle natural-look male grooming makeup (concealer, light contour, slight lip tint — refined masculine version, NOT feminine), gentle warm magnetic expression with charming half-smile, trendy modern K-pop fashion (oversized blazer with chains, layered streetwear, baggy designer pants, fitted knitwear, or stylized airport-fashion look), idol-grade polished appearance. An aura of charming masculine K-pop boy-next-door appeal.",
  cityboy:
    " === PERSONA: 文艺男青年 / POPEYE City Boy (Japanese Ivy/Workwear Aesthetic) === Style the subject as a classic POPEYE-magazine 'City Boy' Japanese young man: clean fresh styled hair (slightly tousled but neat, natural color), warm relaxed gentle masculine expression, classic Ivy League / preppy / workwear-inspired Japanese street fashion (vintage tees, chinos, oxford button-down, denim jacket, chore coat, layered cardigan, classic sneakers like New Balance or Converse), Japanese book-store, cafe, or vintage-shop background. An aura of literary masculine city-boy charm with Japanese Ivy aesthetic.",
  bachelor:
    " === PERSONA: 邻家男孩 (Boy Next Door / Clean Sunshine Male) === Style the subject as a charming clean-cut wholesome young man: neat short well-groomed styled hair (natural color), bright friendly genuine smile with warm eye contact, clean fresh healthy masculine skin, casual smart-casual outfit (crisp white tee with denim or beige chinos, simple knitwear or henley shirt, classic minimalist sneakers), wholesome relatable boy-next-door energy. An aura of approachable masculine boy-next-door charm and sunshine warmth.",
  artist:
    " === PERSONA: 艺术家 (Creative Artist / Bohemian Visionary Male) === Style the subject as a creative young male artist: artistic styled hair (could be longer, slightly intentionally messy, or trendy textured cut), thoughtful intense creative masculine expression, layered artistic indie fashion (paint-splattered or vintage workwear apron, oversized vintage coat over band tee, neutral earth tones, vintage scarves, beanie or fedora, beaded bracelets), possibly with art studio, canvases, or sketchbooks visible. An aura of creative bohemian masculine artistic vision.",
};

// 年龄变换对应的 prompt 片段
// 关键：每档都强调"保留五官识别度"——只改年龄表征（皮肤质感、面部丰润度、纹路），不改五官几何
const AGE_PROMPTS = {
  original: "",
  teens:
    " === AGE TRANSFORMATION: render subject as an ADULT WOMAN IN HER EARLY TWENTIES (around age 22-25) === Apply fresh adult fashion-model rendering — smooth bright dewy skin, healthy luminous eyes, fresh natural makeup, confident adult energy with a bright expression. The result should clearly look like a 22-25 year old adult woman, never a teenager or student. IDENTITY: preserve the subject's core facial features and recognizable identity — same eye shape character, nose orientation, mouth shape, ethnicity — just rendered with the freshness and skin quality of an adult in her early twenties.",
  twenties:
    " === AGE TRANSFORMATION: render subject as a YOUNG ADULT in their TWENTIES (Japanese '20代', age 22-28) === Peak youthful adult beauty — smooth fresh skin (no fine lines or wrinkles), confident vibrant young-adult energy, healthy luminous complexion, balanced facial proportions of someone in their twenties, polished young-adult styling. The result should clearly look like a 22-28 year old. IDENTITY: preserve core facial features and recognizable identity.",
  thirties:
    " === AGE TRANSFORMATION: render subject as an ELEGANT ADULT in their THIRTIES (Japanese '30代', age 30-38) === Mature confident beauty — smooth healthy skin with the subtle natural texture of someone in their early thirties (very subtle expression lines around eyes when smiling, but no deep wrinkles), sophisticated polished refined appearance, balanced mature facial proportions, peak-of-career poise and elegance. The result should clearly look like a 30-38 year old. IDENTITY: preserve core facial features and recognizable identity.",
  forties:
    " === AGE TRANSFORMATION: render subject as a GRACEFUL ADULT in their FORTIES (Japanese '40代', age 40-48) === Refined mature beauty — well-maintained healthy skin with gentle visible fine lines around eyes and mouth that show character without aging dramatically, slightly softer facial fullness, possibly a touch of grey at temples, dignified elegant timeless appearance. The result should clearly look like a 40-48 year old. IDENTITY: preserve core facial features and recognizable identity — same eye shape, nose, ethnicity — just rendered with the natural maturity of someone in their forties.",
  fifties:
    " === AGE TRANSFORMATION: render subject as a DIGNIFIED ADULT in their FIFTIES (Japanese '50代', age 50-58) === Mature graceful beauty — visible fine lines and gentle character lines around eyes and mouth, softer facial contours with mature fullness, possible subtle silver or grey hair accents, refined wisdom in expression, well-maintained sophisticated aura, elegantly-aged appearance. The result should clearly look like a 50-58 year old. IDENTITY: preserve core facial features and recognizable identity.",
  sixties:
    " === AGE TRANSFORMATION: render subject as a GRACEFUL ELDER in their SIXTIES (Japanese '60代', age 60-68) === Beautiful silver-age elegance — clearly visible age character lines around eyes and mouth, softer mature facial contours, gracefully aged skin with visible texture and subtle age spots, predominantly grey or silver hair, dignified confident expression with wisdom in the eyes, sophisticated timeless beauty of someone who has aged gracefully. The result should clearly look like a 60-68 year old. IDENTITY: preserve core facial features and recognizable identity — same eye shape, nose, ethnicity — just rendered with the natural maturity of someone in their sixties.",
};

// 美颜强度对应的 prompt 片段
// 重点：每档都强调"保留原貌识别度"，避免 AI 把脸魔改成另一个人
const BEAUTY_PROMPTS = {
  none: "",
  subtle:
    " === BEAUTY RETOUCHING (light, natural) === Apply gentle but noticeable retouching: smooth out skin (remove blemishes, fine lines, uneven texture) for clean even skin tone, add tasteful light makeup (subtle eyeshadow, mascara, soft blush, natural lip color), neaten and style hair. Preserve the subject's exact natural features — same eye shape, nose, mouth, face shape, age, ethnicity. Result: the same person photographed on a great skin day with light makeup.",
  medium:
    " === BEAUTY RETOUCHING (Japanese magazine-grade, clearly noticeable) === Apply professional Japanese magazine retouching to the subject so they look CLEARLY enhanced compared to the input photo: (1) Porcelain-smooth glowing flawless skin — completely remove all pores, blemishes, fine lines, uneven texture; dewy luminous quality. (2) Slimmer more refined V-shaped jawline — visibly slim the jaw and chin area. (3) Larger more luminous eyes — slightly enlarge eyes and brighten the whites, add elegant defined eye makeup (eyeliner, mascara, eyeshadow) with bright catchlights. (4) Refined nose contour — slimmer bridge and tip. (5) Plumper glossy lips with defined shape and tasteful lipstick. (6) Slimmer more graceful body proportions, elegant posture. (7) Full professional makeup throughout. IDENTITY: still recognizably the same person — preserve core eye shape, nose orientation, face character, hair, ethnicity. The retouching should be clearly visible at a glance — viewer should immediately notice the difference, not have to look hard.",
  strong:
    " === MAXIMUM PRIORITY: HEAVY BEAUTY RETOUCHING (Japanese idol-grade) === This is the MOST IMPORTANT aspect of the image — apply maximum-intensity Japanese idol/K-pop magazine-cover retouching to the subject, similar to top-tier beauty filters and professional idol photo retouching: (1) SKIN: porcelain-smooth, glowing, dewy, luminous, completely flawless — zero visible pores, blemishes, fine lines, or texture. Brightened and evened skin tone. (2) FACE SHAPE: DISTINCTLY slimmer V-shaped jawline (visibly slim the face by approximately 15-20%), refined sculpted chin, contoured cheekbones with high cheekbone shadow. (3) EYES: NOTICEABLY LARGER eyes (enlarge by ~15%), brighter whites with sparkling bright catchlights, full elegant sculpted eye makeup — defined winged eyeliner, voluminous mascara, eyeshadow, sharp eyelashes. (4) NOSE: refined slimmer contoured nose with elegant higher bridge. (5) LIPS: visibly plumper, glossy, with sharp defined cupid's bow and tasteful lipstick. (6) BODY: noticeably slimmer, longer-looking, more graceful elongated proportions, model-like posture. (7) MAKEUP: full polished professional Japanese idol makeup look throughout. OVERRIDE any 'natural / casual / soft' aspects of the magazine style description below — heavy retouching takes priority. IDENTITY PRESERVATION (critical): despite heavy beautification, the subject must remain RECOGNIZABLY the same person — preserve their core eye shape, nose orientation, overall face character, hair style and color, ethnicity, age range. Goal: viewer thinks 'wow, [this person] looks absolutely stunning as a magazine idol' — NOT 'who is this stranger'.",
};

// strong 档结尾的额外提醒（三明治结构：开头+结尾各放一次）
const BEAUTY_REINFORCE_TAIL = {
  strong:
    " FINAL REMINDER: This is a HEAVILY RETOUCHED magazine cover. The subject's skin must be porcelain-smooth and glowing with zero visible texture. The jaw must be visibly slimmer. The eyes must be noticeably larger and brighter. The lips must be plumper. Apply maximum beauty retouching — but keep the subject recognizable as the same person.",
};

// 男性版美颜 prompt：当性别=男性时自动切换到这一套
// 重点：男性美颜不是"V 字脸/大眼/丰唇"，而是"利落下颌/清爽肤质/型男气场"
const MALE_BEAUTY_PROMPTS = {
  none: "",
  subtle:
    " === MALE GROOMING (light, natural) === Apply gentle masculine grooming retouching: clean clear masculine skin with minimized blemishes and pores while keeping natural masculine skin texture, even healthy skin tone, well-groomed neat eyebrows, well-trimmed beard/stubble or clean shave (preserve the subject's existing facial hair pattern), healthy hair. Preserve exact masculine facial features, jawline character, age. Result: the same man on his best skin day with light grooming.",
  medium:
    " === MALE GROOMING (Japanese magazine-grade, clearly noticeable) === Apply professional Japanese male magazine-cover grooming to the subject — clearly visible improvement: (1) Clear smooth healthy masculine skin — remove blemishes, fine lines, and uneven texture, but preserve a slight masculine skin character (not feminine-flawless). (2) Sharper more defined MASCULINE jawline — sharpen and define the jaw angularly (this is masculine 'chiseled' definition, NOT feminine V-shape narrowing). (3) Contoured masculine cheekbones with subtle high-cheekbone shadow. (4) Well-groomed sculpted natural eyebrows. (5) Alert bright eyes with whitened whites (NOT enlarged like dolls — natural masculine eye size). (6) Refined masculine nose contour. (7) Neat facial hair (well-trimmed beard, stubble, or clean shave depending on the subject). (8) Lustrous well-styled hair. (9) Lean toned masculine posture. IDENTITY: still clearly recognizable as the same man — preserve his exact eye shape, nose orientation, jawline character, ethnicity. Think 'the same man looking his absolute best as a male magazine cover model'.",
  strong:
    " === MALE GROOMING (MAXIMUM PRIORITY, idol-grade) === This is the MOST IMPORTANT aspect of the image. Apply maximum male magazine/idol-cover grooming to the subject, like a top-tier J-pop/K-pop/Asian idol cover: (1) MASCULINE SKIN: smooth, glowing, healthy, completely clear — zero visible pores, blemishes, fine lines. Brightened even skin tone but maintain masculine skin character (not feminine porcelain). (2) MASCULINE JAWLINE: distinctly SHARPER more defined masculine jawline (sharpen by ~15-20% in the chiseled angular masculine direction, NOT feminine V-narrowing), refined sculpted chin. (3) CHEEKBONES: noticeably contoured masculine cheekbones with sculpted shadow. (4) EYES: alert magnetic bright eyes with whitened whites and bright catchlights, well-groomed sharp masculine eyebrows (NOT enlarged eyes, NOT feminine eye makeup). (5) NOSE: refined contoured masculine nose. (6) LIPS: clearly defined natural masculine lips (NOT plumped or glossy). (7) FACIAL HAIR: perfectly groomed (clean shave OR well-trimmed designer stubble OR neat beard — match the subject's natural style). (8) HAIR: lustrous well-styled trendy hair appropriate to the magazine. (9) BODY: lean toned masculine build, broad-shouldered model posture and silhouette. (10) Overall polished male model appearance. OVERRIDE any 'natural / casual / soft' aspects of the magazine style — maximum grooming takes priority. IDENTITY PRESERVATION (critical): despite heavy grooming, the subject must remain RECOGNIZABLY the same MAN — preserve his core eye shape, nose orientation, jawline character, ethnicity, and overall masculine identity. NEVER feminize. Goal: viewer thinks 'wow, [this man] looks absolutely stunning as a male idol' — NOT 'who is this stranger'.",
